@model ElderlyCareHospital.Models.DoctorNotes

@{
    ViewBag.Title = "Create Doctor Note";
}

<style>

    /* =========================================================
       ROOT / PAGE
       ========================================================= */

    :root {
        --app-bg: #f8fafc;
        --card-bg: #ffffff;
        --text-main: #0f172a;
        --text-muted: #64748b;
        --border-color: #e2e8f0;
        --primary: #4f46e5;
        --primary-hover: #4338ca;
        --doctor-accent: #0f766e;
        --doctor-accent-light: #14b8a6;
    }

    html,
    body {
        margin: 0;
        padding: 0;
        min-height: 100%;
    }

    body {
        background: var(--app-bg);
        font-family: 'Inter', 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        color: var(--text-main);
        overflow-x: hidden;
    }

    .create-container {
        width: 100%;
        max-width: 1000px;
        margin: 0 auto;
        padding: 40px 20px;
        box-sizing: border-box;
    }

    .create-header {
        background: var(--card-bg);
        border: 1px solid var(--border-color);
        color: var(--text-main);
        padding: 30px 36px;
        border-radius: 18px;
        margin-bottom: 30px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.02);
        position: relative;
        overflow: hidden;
    }

        .create-header::after {
            content: "";
            position: absolute;
            width: 180px;
            height: 180px;
            right: -70px;
            top: -80px;
            border-radius: 50%;
            background: rgba(20, 184, 166, 0.045);
            pointer-events: none;
        }

        .create-header h2 {
            margin: 0;
            font-size: 24px;
            font-weight: 700;
            color: var(--text-main);
            letter-spacing: -0.3px;
            line-height: 1.3;
            position: relative;
            z-index: 1;
        }

        .create-header p {
            margin: 12px 0 0 0;
            color: var(--text-muted);
            font-size: 14px;
            line-height: 1.6;
            max-width: 850px;
            position: relative;
            z-index: 1;
        }

    .form-card {
        background: var(--card-bg);
        border: 1px solid var(--border-color);
        border-radius: 18px;
        padding: 36px 40px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.02);
    }

    .form-title {
        text-align: center;
        margin-bottom: 10px;
    }

        .form-title h4 {
            margin: 0;
            color: var(--text-main);
            font-size: 20px;
            font-weight: 700;
        }

        .form-title p {
            margin: 7px 0 0 0;
            color: var(--text-muted);
            font-size: 13px;
        }

    .form-divider {
        border: 0;
        border-top: 1px solid var(--border-color);
        margin: 24px auto 30px;
        max-width: 850px;
    }

    .doctor-note-form {
        width: 100%;
        max-width: 720px;
        margin: 0 auto;
    }

    .note-form-group {
        width: 100%;
        margin-bottom: 24px;
    }

    .note-label {
        display: block;
        width: 100%;
        margin-bottom: 8px;
        text-align: center;
        color: var(--text-main);
        font-size: 14px;
        font-weight: 600;
    }

    .note-input {
        display: block;
        width: 100%;
        min-height: 46px;
        box-sizing: border-box;
        padding: 11px 14px;
        border: 1px solid #cbd5e1;
        border-radius: 10px;
        background: #ffffff;
        color: var(--text-main);
        font-size: 14px;
        outline: none;
        transition: all 0.2s ease;
        margin: 0 auto;
    }

        .note-input:focus {
            border-color: var(--doctor-accent-light);
            box-shadow: 0 0 0 3px rgba(20, 184, 166, 0.12);
        }

        .note-input:hover {
            border-color: #94a3b8;
        }

    textarea.note-input {
        min-height: 170px;
        resize: vertical;
        line-height: 1.6;
    }

    select.note-input {
        cursor: pointer;
        background-color: #ffffff;
    }

    input[type="datetime-local"].note-input {
        min-height: 46px;
    }

    .text-danger {
        display: block;
        margin-top: 6px;
        text-align: center;
        color: #dc2626;
        font-size: 13px;
    }

    .validation-summary {
        max-width: 720px;
        margin: 0 auto 20px;
        padding: 12px 16px;
        border-radius: 10px;
        background: #fef2f2;
        border: 1px solid #fecaca;
        color: #b91c1c;
        font-size: 13px;
    }

    .form-actions {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 12px;
        margin-top: 30px;
    }

    .btn-create-note {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 160px;
        padding: 12px 24px;
        border: none;
        border-radius: 10px;
        background: linear-gradient(135deg, #0f766e, #14b8a6);
        color: white !important;
        font-size: 14px;
        font-weight: 600;
        text-decoration: none;
        cursor: pointer;
        box-shadow: 0 5px 14px rgba(15, 118, 110, 0.18);
        transition: all 0.2s ease;
    }

        .btn-create-note:hover {
            background: linear-gradient(135deg, #0d625c, #0f9f93);
            color: white !important;
            text-decoration: none;
            transform: translateY(-2px);
            box-shadow: 0 8px 18px rgba(15, 118, 110, 0.22);
        }

        .btn-create-note:focus {
            outline: none;
        }

    .back-wrapper {
        display: flex;
        justify-content: center;
        margin-top: 24px;
    }

    .back-link {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 11px 20px;
        border-radius: 10px;
        background: #475569;
        color: white !important;
        text-decoration: none;
        font-size: 14px;
        font-weight: 600;
        transition: all 0.2s ease;
    }

        .back-link:hover {
            background: #334155;
            color: white !important;
            text-decoration: none;
            transform: translateY(-1px);
        }

    @@media (max-width: 768px) {

        .create-container {
            padding: 25px 16px;
        }

        .create-header {
            padding: 24px;
            border-radius: 16px;
            margin-bottom: 22px;
        }

            .create-header h2 {
                font-size: 21px;
            }

            .create-header p {
                font-size: 13px;
            }

        .form-card {
            padding: 28px 22px;
            border-radius: 16px;
        }

        .doctor-note-form {
            max-width: 100%;
        }

        .form-title h4 {
            font-size: 18px;
        }

        .note-label {
            font-size: 13px;
        }

        .note-input {
            min-height: 44px;
        }

        textarea.note-input {
            min-height: 150px;
        }

        .form-actions {
            margin-top: 25px;
        }

        .btn-create-note {
            width: 100%;
        }
    }

    @@media (max-width: 480px) {

        .create-container {
            padding: 18px 12px;
        }

        .create-header {
            padding: 20px;
        }

            .create-header h2 {
                font-size: 19px;
            }

        .form-card {
            padding: 24px 16px;
        }

        .form-divider {
            margin-bottom: 24px;
        }

        .note-form-group {
            margin-bottom: 20px;
        }

        .back-link {
            width: 100%;
            box-sizing: border-box;
        }
    }
</style>


<!-- =========================================================
     PAGE
     ========================================================= -->

<div class="create-container">

    <div class="create-header">

        <h2>
            Create Doctor Note
        </h2>

        <p>
            Record a new clinical note for a patient and share
            important observations with the healthcare team.
        </p>

    </div>


    <div class="form-card">

        @using (Html.BeginForm(null, null, FormMethod.Post, new { id = "doctorNoteForm" }))
        {
            @Html.AntiForgeryToken()

            <div class="form-title">

                <h4>
                    Doctor Note Information
                </h4>

                <p>
                    Complete the information below to create a clinical note.
                </p>

            </div>

            <hr class="form-divider" />


            <!-- VALIDATION -->

            @Html.ValidationSummary(
                true,
                "",
                new { @class = "text-danger validation-summary" }
            )


            <div class="doctor-note-form">


                <!-- PATIENT -->

                <div class="note-form-group">

                    @Html.LabelFor(
                        model => model.PatientID,
                        "Patient",
                        htmlAttributes: new
                        {
                            @class = "note-label"
                        })

                    @Html.DropDownList(
                        "PatientID",
                        null,
                        "Select a patient",
                        new
                        {
                            @class = "note-input",
                            id = "PatientID"
                        })

                    @Html.ValidationMessageFor(
                        model => model.PatientID,
                        "",
                        new
                        {
                            @class = "text-danger"
                        })

                </div>


                <!-- DOCTOR -->

                <div class="note-form-group">

                    @Html.LabelFor(
                        model => model.DoctorID,
                        "Doctor",
                        htmlAttributes: new
                        {
                            @class = "note-label"
                        })

                    <input type="text"
                           class="note-input"
                           value="@ViewBag.CurrentDoctorName"
                           readonly />

                    @Html.HiddenFor(
                        model => model.DoctorID
                    )

                    @Html.ValidationMessageFor(
                        model => model.DoctorID,
                        "",
                        new
                        {
                            @class = "text-danger"
                        })

                </div>


                <!-- NOTE -->

                <div class="note-form-group">

                    @Html.LabelFor(
                        model => model.NoteText,
                        "Clinical Note",
                        htmlAttributes: new
                        {
                            @class = "note-label"
                        })

                    @Html.TextAreaFor(
                        model => model.NoteText,
                        new
                        {
                            @class = "note-input",
                            id = "NoteText",
                            rows = "6",
                            maxlength = "2000",
                            placeholder = "Enter clinical observations, treatment details, and recommendations..."
                        })

                    @Html.ValidationMessageFor(
                        model => model.NoteText,
                        "",
                        new
                        {
                            @class = "text-danger"
                        })

                </div>


                <!-- DATE CREATED -->

                <div class="note-form-group">

                    @Html.LabelFor(
                        model => model.DateCreated,
                        "Date Created",
                        htmlAttributes: new
                        {
                            @class = "note-label"
                        })

                    <input type="text"
                           class="note-input"
                           value="@DateTime.Now.ToString("dd MMM yyyy HH:mm")"
                           readonly />

                    @Html.HiddenFor(
                        model => model.DateCreated,
                        new
                        {
                            id = "DateCreated"
                        })

                    @Html.ValidationMessageFor(
                        model => model.DateCreated,
                        "",
                        new
                        {
                            @class = "text-danger"
                        })

                </div>


                <!-- CREATE BUTTON -->

                <div class="form-actions">

                    <input type="submit"
                           value="Create Note"
                           class="btn-create-note"
                           id="createNoteButton" />

                </div>

            </div>
        }

    </div>


    <!-- BACK -->

    <div class="back-wrapper">

        @Html.ActionLink(
            "← Back to Notes List",
            "Index",
            "DoctorNotes",
            null,
            new
            {
                @class = "back-link"
            })

    </div>

</div>


<!-- =========================================================
     CLIENT-SIDE VALIDATION
     ========================================================= -->

@section Scripts {

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/jqueryval")

    <script>

        $(document).ready(function () {

            $("#doctorNoteForm").on("submit", function (event) {

                var isValid = true;

                /* =============================================
                   PATIENT VALIDATION
                   ============================================= */

                var patient = $("#PatientID").val();

                if (!patient || patient === "" || patient === "0") {

                    isValid = false;

                    var patientMessage =
                        $("#PatientID").siblings(".text-danger");

                    if (patientMessage.length) {
                        patientMessage.text("Please select a patient.");
                    }

                    $("#PatientID").css("border-color", "#dc2626");

                } else {

                    $("#PatientID").css("border-color", "");
                }


                /* =============================================
                   DOCTOR VALIDATION
                   ============================================= */

                var doctor = $("#DoctorID").val();

                if (!doctor || doctor.trim() === "") {

                    isValid = false;

                    var doctorMessage =
                        $("#DoctorID").siblings(".text-danger");

                    if (doctorMessage.length) {
                        doctorMessage.text("Doctor information is required.");
                    }

                    $("#DoctorID").prev("input").css(
                        "border-color",
                        "#dc2626"
                    );

                } else {

                    $("#DoctorID").prev("input").css(
                        "border-color",
                        ""
                    );
                }


                /* =============================================
                   CLINICAL NOTE VALIDATION
                   ============================================= */

                var note = $("#NoteText").val();

                if (!note || note.trim() === "") {

                    isValid = false;

                    var noteMessage =
                        $("#NoteText").siblings(".text-danger");

                    if (noteMessage.length) {
                        noteMessage.text("Clinical note is required.");
                    }

                    $("#NoteText").css("border-color", "#dc2626");

                }
                else if (note.trim().length < 5) {

                    isValid = false;

                    var noteMessage =
                        $("#NoteText").siblings(".text-danger");

                    if (noteMessage.length) {
                        noteMessage.text(
                            "Clinical note must contain at least 5 characters."
                        );
                    }

                    $("#NoteText").css("border-color", "#dc2626");

                }
                else if (note.length > 2000) {

                    isValid = false;

                    var noteMessage =
                        $("#NoteText").siblings(".text-danger");

                    if (noteMessage.length) {
                        noteMessage.text(
                            "Clinical note cannot exceed 2000 characters."
                        );
                    }

                    $("#NoteText").css("border-color", "#dc2626");

                }
                else {

                    $("#NoteText").css("border-color", "");
                }


                /* =============================================
                   DATE CREATED VALIDATION
                   ============================================= */

                var dateCreated = $("#DateCreated").val();

                if (!dateCreated || dateCreated.trim() === "") {

                    isValid = false;

                    var dateMessage =
                        $("#DateCreated").siblings(".text-danger");

                    if (dateMessage.length) {
                        dateMessage.text("Date created is required.");
                    }

                }


                /* =============================================
                   STOP FORM IF INVALID
                   ============================================= */

                if (!isValid) {

                    event.preventDefault();

                    var summary =
                        $(".validation-summary");

                    if (summary.length) {

                        summary
                            .removeClass("validation-summary")
                            .addClass("validation-summary");

                        summary.html(
                            "<strong>Please correct the errors above before submitting the doctor note.</strong>"
                        );
                    }

                    return false;
                }

                return true;
            });


            /* =============================================
               REMOVE ERROR BORDER WHILE USER CORRECTS INPUT
               ============================================= */

            $("#PatientID").on("change", function () {

                if ($(this).val()) {
                    $(this).css("border-color", "");
                }

            });


            $("#NoteText").on("input", function () {

                var value = $(this).val();

                if (value.trim().length >= 5 &&
                    value.length <= 2000) {

                    $(this).css("border-color", "");

                    $(this)
                        .siblings(".text-danger")
                        .text("");
                }

            });


            /* =============================================
               PREVENT ONLY-WHITESPACE NOTE
               ============================================= */

            $("#doctorNoteForm").on("submit", function () {

                var note = $("#NoteText").val();

                if (note) {
                    $("#NoteText").val(note.trim());
                }

            });

        });

    </script>
}

