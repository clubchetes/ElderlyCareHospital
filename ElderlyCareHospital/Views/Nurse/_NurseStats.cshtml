<div class="row">

    <!-- ASSIGNED PATIENTS -->
    <div class="col-md-4 mb-4">

        <div class="stats-card">

            <div class="stats-icon">
                <span>♙</span>
            </div>

            <div class="stats-content">

                <h2>
                    @ViewBag.Patients
                </h2>

                <h4>
                    Assigned Patients
                </h4>

                <span class="stats-label">
                    Current Patients
                </span>

            </div>

        </div>

    </div>


    <!-- VITALS RECORDED -->
    <div class="col-md-4 mb-4">

        <div class="stats-card">

            <div class="stats-icon">
                <span>♥</span>
            </div>

            <div class="stats-content">

                <h2>
                    @ViewBag.Vitals
                </h2>

                <h4>
                    Vitals Recorded
                </h4>

                <span class="stats-label">
                    Patient Observations
                </span>

            </div>

        </div>

    </div>


    <!-- MEDICATION RECORDS -->
    <div class="col-md-4 mb-4">

        <div class="stats-card">

            <div class="stats-icon">
                <span>Rx</span>
            </div>

            <div class="stats-content">

                <h2>
                    @ViewBag.Medications
                </h2>

                <h4>
                    Medication Records
                </h4>

                <span class="stats-label">
                    Administration Records
                </span>

            </div>

        </div>

    </div>

</div>


<style>

    /* =========================================================
       NURSE STATISTICS CARDS
       ========================================================= */

    #nurseStatsContainer .stats-card {
        position: relative;
        width: 100%;
        min-height: 155px;
        display: flex;
        align-items: center;
        padding: 24px;
        box-sizing: border-box;
        background: #ffffff;
        border: 1px solid #e2e9ee;
        border-radius: 18px;
        box-shadow: 0 8px 24px rgba(30, 55, 75, 0.06);
        overflow: hidden;
        transition: transform .25s ease, box-shadow .25s ease, border-color .25s ease;
    }


        /* TOP ACCENT */

        #nurseStatsContainer .stats-card::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 4px;
            background: linear-gradient( 90deg, #2f6f73, #4c8c91 );
        }


        /* SOFT BACKGROUND CIRCLE */

        #nurseStatsContainer .stats-card::after {
            content: "";
            position: absolute;
            width: 130px;
            height: 130px;
            right: -55px;
            bottom: -65px;
            border-radius: 50%;
            background: rgba(76, 140, 145, 0.055);
            pointer-events: none;
        }


        /* =========================================================
       HOVER
       ========================================================= */

        #nurseStatsContainer .stats-card:hover {
            transform: translateY(-5px);
            border-color: #c9dcde;
            box-shadow: 0 16px 35px rgba(30, 55, 75, 0.11);
        }


    /* =========================================================
       ICON
       ========================================================= */

    #nurseStatsContainer .stats-icon {
        width: 48px;
        height: 48px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-right: 18px;
        border-radius: 14px;
        background: #edf6f6;
        color: #2f6f73;
        font-size: 18px;
        font-weight: 800;
        box-shadow: 0 5px 14px rgba(47, 111, 115, 0.08);
        transition: .25s ease;
    }


    #nurseStatsContainer .stats-card:hover .stats-icon {
        transform: scale(1.08) rotate(-3deg);
        background: #e5f1f1;
    }


    /* =========================================================
       CONTENT
       ========================================================= */

    #nurseStatsContainer .stats-content {
        position: relative;
        z-index: 2;
        display: flex;
        flex-direction: column;
        min-width: 0;
    }


        /* =========================================================
       NUMBER
       ========================================================= */

        #nurseStatsContainer .stats-content h2 {
            margin: 0;
            padding: 0;
            color: #183b42;
            font-size: 30px;
            line-height: 1;
            font-weight: 800;
            letter-spacing: -1px;
        }


        /* =========================================================
       TITLE
       ========================================================= */

        #nurseStatsContainer .stats-content h4 {
            margin: 9px 0 0;
            padding: 0;
            color: #294d53;
            font-size: 14px;
            line-height: 1.3;
            font-weight: 750;
        }


    /* =========================================================
       SMALL LABEL
       ========================================================= */

    #nurseStatsContainer .stats-label {
        margin-top: 5px;
        color: #819399;
        font-size: 10px;
        line-height: 1.3;
        font-weight: 650;
        text-transform: uppercase;
        letter-spacing: .55px;
    }


    /* =========================================================
       TABLET
       ========================================================= */

    @@media (max-width: 991px) {

        #nurseStatsContainer .stats-card {
            min-height: 145px;
            padding: 20px;
        }

        #nurseStatsContainer .stats-icon {
            width: 44px;
            height: 44px;
            margin-right: 15px;
        }

        #nurseStatsContainer .stats-content h2 {
            font-size: 27px;
        }
    }


    /* =========================================================
       MOBILE
       ========================================================= */

    @@media (max-width: 767px) {

        #nurseStatsContainer .row {
            margin-left: -6px;
            margin-right: -6px;
        }

        #nurseStatsContainer .col-md-4 {
            padding-left: 6px;
            padding-right: 6px;
            margin-bottom: 12px !important;
        }

        #nurseStatsContainer .stats-card {
            min-height: 135px;
            padding: 18px;
        }

        #nurseStatsContainer .stats-icon {
            width: 42px;
            height: 42px;
            margin-right: 14px;
            border-radius: 12px;
        }

        #nurseStatsContainer .stats-content h2 {
            font-size: 25px;
        }

        #nurseStatsContainer .stats-content h4 {
            font-size: 13px;
        }
    }


    /* =========================================================
       SMALL PHONE
       ========================================================= */

    @@media (max-width: 480px) {

        #nurseStatsContainer .stats-card {
            min-height: 125px;
            padding: 16px;
        }

        #nurseStatsContainer .stats-icon {
            width: 39px;
            height: 39px;
            margin-right: 12px;
            font-size: 15px;
        }

        #nurseStatsContainer .stats-content h2 {
            font-size: 23px;
        }

        #nurseStatsContainer .stats-content h4 {
            font-size: 12px;
        }

        #nurseStatsContainer .stats-label {
            font-size: 9px;
        }
    }
</style>