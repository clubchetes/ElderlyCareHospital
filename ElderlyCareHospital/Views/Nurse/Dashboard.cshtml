@section Scripts {

    <script>

        /* =========================================================
           NURSE SIDEBAR

           Completely independent from jQuery.
           ========================================================= */

        (function () {

            "use strict";


            const sidebar =
                document.getElementById(
                    "dashboardSidebar"
                );

            const overlay =
                document.getElementById(
                    "sidebarOverlay"
                );

            const toggleButton =
                document.getElementById(
                    "sidebarToggle"
                );

            const closeButton =
                document.getElementById(
                    "sidebarClose"
                );


            if (
                !sidebar ||
                !overlay ||
                !toggleButton
            ) {

                console.error(
                    "Nurse sidebar elements were not found."
                );

                return;
            }


            /* =====================================================
               OPEN
               ===================================================== */

            function openSidebar() {

                sidebar.classList.add("open");

                overlay.classList.add("active");

                toggleButton.setAttribute(
                    "aria-expanded",
                    "true"
                );

                toggleButton.setAttribute(
                    "aria-label",
                    "Close navigation menu"
                );

                overlay.setAttribute(
                    "aria-hidden",
                    "false"
                );

                document.body.style.overflow =
                    "hidden";
            }


            /* =====================================================
               CLOSE
               ===================================================== */

            function closeSidebar() {

                sidebar.classList.remove("open");

                overlay.classList.remove("active");

                toggleButton.setAttribute(
                    "aria-expanded",
                    "false"
                );

                toggleButton.setAttribute(
                    "aria-label",
                    "Open navigation menu"
                );

                overlay.setAttribute(
                    "aria-hidden",
                    "true"
                );

                document.body.style.overflow =
                    "";
            }


            /* =====================================================
               TOGGLE
               ===================================================== */

            toggleButton.addEventListener(
                "click",
                function (event) {

                    event.preventDefault();

                    event.stopPropagation();


                    if (
                        sidebar.classList.contains(
                            "open"
                        )
                    ) {

                        closeSidebar();

                    } else {

                        openSidebar();

                    }

                }
            );


            /* =====================================================
               CLOSE BUTTON
               ===================================================== */

            if (closeButton) {

                closeButton.addEventListener(
                    "click",
                    function (event) {

                        event.preventDefault();

                        event.stopPropagation();

                        closeSidebar();

                    }
                );

            }


            /* =====================================================
               CLICK OUTSIDE
               ===================================================== */

            overlay.addEventListener(
                "click",
                function () {

                    closeSidebar();

                }
            );


            /* =====================================================
               ESCAPE
               ===================================================== */

            document.addEventListener(
                "keydown",
                function (event) {

                    if (
                        event.key === "Escape" &&
                        sidebar.classList.contains(
                            "open"
                        )
                    ) {

                        closeSidebar();

                    }

                }
            );


            /* =====================================================
               NAVIGATION LINKS
               ===================================================== */

            const sidebarLinks =
                sidebar.querySelectorAll(
                    ".sidebar-menu a"
                );


            sidebarLinks.forEach(
                function (link) {

                    link.addEventListener(
                        "click",
                        function () {

                            closeSidebar();

                        }
                    );

                }
            );


            /* =====================================================
               MOBILE RESIZE SAFETY
               ===================================================== */

            window.addEventListener(
                "resize",
                function () {

                    if (
                        window.innerWidth > 768 &&
                        sidebar.classList.contains(
                            "open"
                        )
                    { 

                        /*
                         * Keep sidebar open.
                         */

                    }

                }
            );


        })();


        /* =========================================================
           NURSE LIVE STATISTICS
           ========================================================= */

        $(document).ready(function () {

            let statsRequestRunning = false;


            function refreshNurseStats() {

                if (statsRequestRunning) {
                    return;
                }


                statsRequestRunning = true;


                $.ajax({

                    url:
                        '@Url.Action(
                            "GetNurseStatsJson",
                            "Nurse"
                        )',

                    type: "GET",

                    cache: false,


                    success:
                        function (result) {

                            if (result) {

                                $("#nurseStatsContainer")
                                    .html(result);

                            }

                        },


                    error:
                        function (err) {

                            console.log(
                                "Error polling nurse stats:",
                                err
                            );

                        },


                    complete:
                        function () {

                            statsRequestRunning =
                                false;

                        }

                });

            }


            /* Initial load */

            refreshNurseStats();


            /* Refresh every 3 seconds */

            setInterval(
                refreshNurseStats,
                3000
            );

        });

    </script>

}