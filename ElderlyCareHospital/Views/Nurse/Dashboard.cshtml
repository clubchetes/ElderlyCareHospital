@{
    ViewBag.Title = "Nurse Dashboard";
}

<style>

    /* =========================================================
       ELDERLYCARE HOSPITAL
       NURSE DASHBOARD
       CLEAN ADMIN-STYLE THEME
       NO BLUE / NO BLUR
       ========================================================= */

    :root {
        --app-bg: #f5f8f6;
        --surface: #ffffff;
        --surface-soft: #f8fbf9;
        --text-main: #23352f;
        --text-muted: #687b74;
        --text-light: #8b9b95;
        --primary: #3f806b;
        --primary-dark: #2f6654;
        --primary-light: #eaf5f0;
        --secondary: #6b9d8b;
        --soft-green: #eef7f3;
        --success: #4f9277;
        --success-soft: #edf8f2;
        --danger: #c75d68;
        --danger-soft: #fff1f3;
        --warning: #c58b4d;
        --warning-soft: #fff6e9;
        --border: #dce7e1;
        --border-soft: #e9efec;
        --shadow: 0 12px 35px rgba(35, 53, 47, .07);
        --shadow-hover: 0 18px 42px rgba(35, 53, 47, .13);
        --radius-lg: 22px;
        --radius-md: 17px;
        --radius-sm: 12px;
    }


    /* =========================================================
       RESET
       ========================================================= */

    html,
    body {
        margin: 0;
        padding: 0;
        min-height: 100%;
    }

    *,
    *::before,
    *::after {
        box-sizing: border-box;
    }


    /* =========================================================
       BODY
       ========================================================= */

    body {
        background: radial-gradient( circle at 8% 8%, rgba(63, 128, 107, .045), transparent 27% ), radial-gradient( circle at 92% 90%, rgba(79, 146, 119, .04), transparent 25% ), var(--app-bg);
        font-family: 'Inter', 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        color: var(--text-main);
        overflow-x: hidden;
    }


    /* =========================================================
       BACKGROUND SHAPES
       ========================================================= */

    .bg-shape {
        position: fixed;
        border-radius: 50%;
        pointer-events: none;
        z-index: 0;
        filter: none !important;
        opacity: 1;
    }

    .shape1 {
        width: 340px;
        height: 340px;
        top: -120px;
        left: -100px;
        background: rgba(63, 128, 107, .035);
    }

    .shape2 {
        width: 280px;
        height: 280px;
        right: -90px;
        bottom: 4%;
        background: rgba(79, 146, 119, .03);
    }

    .shape3 {
        width: 180px;
        height: 180px;
        left: 46%;
        top: 42%;
        background: rgba(63, 128, 107, .012);
    }


    /* =========================================================
       DASHBOARD WRAPPER
       ========================================================= */

    .dashboard-wrapper {
        position: relative;
        min-height: 100vh;
        z-index: auto !important;
    }


    /* =========================================================
       SIDEBAR OVERLAY
       ========================================================= */

    .sidebar-overlay {
        position: fixed !important;
        inset: 0 !important;
        z-index: 9998 !important;
        background: rgba(25, 42, 36, .24) !important;
        opacity: 0 !important;
        visibility: hidden !important;
        pointer-events: none !important;
        backdrop-filter: none !important;
        -webkit-backdrop-filter: none !important;
        filter: none !important;
        transition: opacity .25s ease, visibility .25s ease;
    }

        .sidebar-overlay.active {
            opacity: 1 !important;
            visibility: visible !important;
            pointer-events: auto !important;
            backdrop-filter: none !important;
            -webkit-backdrop-filter: none !important;
            filter: none !important;
        }


    /* =========================================================
       SIDEBAR
       ========================================================= */

    .dashboard-sidebar {
        position: fixed !important;
        top: 0 !important;
        bottom: 0 !important;
        left: 0 !important;
        width: 285px !important;
        max-width: 85vw;
        z-index: 9999 !important;
        background: #ffffff !important;
        opacity: 1 !important;
        visibility: visible !important;
        filter: none !important;
        backdrop-filter: none !important;
        -webkit-backdrop-filter: none !important;
        border-right: 1px solid var(--border);
        padding: 25px 18px;
        display: flex;
        flex-direction: column;
        box-shadow: 12px 0 40px rgba(35, 53, 47, .12);
        transform: translateX(-100%) !important;
        transition: transform .32s cubic-bezier(.4, 0, .2, 1);
        overflow-y: auto;
        overflow-x: hidden;
        isolation: isolate;
    }

        .dashboard-sidebar.open {
            left: 0 !important;
            transform: translateX(0) !important;
        }


        /* =========================================================
       FORCE SIDEBAR CHILDREN TO REMAIN CRISP
       ========================================================= */

        .dashboard-sidebar,
        .dashboard-sidebar *,
        .dashboard-sidebar *::before,
        .dashboard-sidebar *::after {
            filter: none !important;
            backdrop-filter: none !important;
            -webkit-backdrop-filter: none !important;
        }


    /* =========================================================
       SIDEBAR BRAND
       ========================================================= */

    .sidebar-brand {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 7px;
        margin-bottom: 32px;
    }

    .sidebar-brand-left {
        display: flex;
        align-items: center;
        gap: 11px;
        font-size: 17px;
        font-weight: 750;
        color: var(--text-main);
    }

    .sidebar-logo {
        width: 42px;
        height: 42px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 13px;
        color: #ffffff;
        font-size: 13px;
        font-weight: 800;
        background: linear-gradient( 135deg, #3f806b, #6b9d8b );
        box-shadow: 0 8px 20px rgba(63, 128, 107, .20);
    }


    /* =========================================================
       SIDEBAR CLOSE
       ========================================================= */

    .sidebar-close-btn {
        width: 36px;
        height: 36px;
        border: 0;
        background: transparent;
        border-radius: 10px;
        color: var(--text-muted);
        font-size: 24px;
        line-height: 1;
        cursor: pointer;
        transition: background .2s ease, color .2s ease, transform .2s ease;
    }

        .sidebar-close-btn:hover {
            background: #eef5f1;
            color: var(--primary);
            transform: rotate(90deg);
        }


    /* =========================================================
       SIDEBAR MENU
       ========================================================= */

    .sidebar-menu {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 7px;
    }

        .sidebar-menu li {
            margin: 0;
            padding: 0;
        }

            .sidebar-menu li a {
                position: relative;
                display: flex;
                align-items: center;
                width: 100%;
                min-height: 49px;
                box-sizing: border-box;
                padding: 12px 14px;
                color: var(--text-muted);
                text-decoration: none;
                font-size: 14px;
                font-weight: 600;
                border-radius: 12px;
                background: transparent;
                transition: color .2s ease, background .2s ease, transform .2s ease;
            }

                .sidebar-menu li a:hover {
                    color: var(--primary);
                    background: #eef6f2;
                    transform: translateX(4px);
                    text-decoration: none;
                }

                .sidebar-menu li a.active {
                    color: #ffffff;
                    background: linear-gradient( 135deg, #3f806b, #619582 );
                    font-weight: 700;
                    box-shadow: 0 8px 20px rgba(63, 128, 107, .18);
                }


    /* =========================================================
       MENU BUTTON
       ========================================================= */

    .sidebar-toggle-btn {
        position: fixed !important;
        top: 78px;
        left: 24px;
        width: 48px;
        height: 48px;
        z-index: 10001 !important;
        border: 1px solid var(--border);
        border-radius: 14px;
        background: #ffffff !important;
        color: var(--primary);
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        box-shadow: 0 8px 25px rgba(35, 53, 47, .10);
        transition: transform .25s ease, box-shadow .25s ease, background .2s ease;
    }

        .sidebar-toggle-btn:hover {
            transform: translateY(-3px) scale(1.03);
            box-shadow: 0 13px 30px rgba(35, 53, 47, .15);
            background: #f9fcfa !important;
        }


    /* =========================================================
       MAIN
       ========================================================= */

    .dashboard-main {
        width: 100%;
        max-width: 1450px;
        box-sizing: border-box;
        padding: 108px 42px 45px;
        margin: 0 auto;
    }


    /* =========================================================
       HERO
       ========================================================= */

    .nurse-header {
        position: relative;
        overflow: hidden;
        padding: 34px 38px;
        margin-bottom: 25px;
        border-radius: 24px;
        color: #ffffff;
        background: linear-gradient( 135deg, #315f50 0%, #3f806b 50%, #6b9d8b 100% );
        box-shadow: 0 18px 42px rgba(63, 128, 107, .16);
    }

        .nurse-header::before {
            content: "";
            position: absolute;
            width: 260px;
            height: 260px;
            right: -70px;
            top: -130px;
            border-radius: 50%;
            border: 35px solid rgba(255, 255, 255, .07);
        }

        .nurse-header::after {
            content: "";
            position: absolute;
            width: 180px;
            height: 180px;
            right: 110px;
            bottom: -120px;
            border-radius: 50%;
            background: rgba(255, 255, 255, .05);
        }

    .hero-content {
        position: relative;
        z-index: 2;
        max-width: 900px;
    }

    .hero-label {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 13px;
        padding: 7px 12px;
        border-radius: 999px;
        background: rgba(255, 255, 255, .13);
        border: 1px solid rgba(255, 255, 255, .15);
        font-size: 11px;
        font-weight: 700;
        letter-spacing: .7px;
        text-transform: uppercase;
    }

    .hero-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: #b8d8ca;
        box-shadow: 0 0 0 5px rgba(184, 216, 202, .10);
    }

    .nurse-header h2 {
        margin: 0;
        font-size: 30px;
        line-height: 1.2;
        font-weight: 800;
        letter-spacing: -.7px;
    }

    .nurse-header p {
        margin: 12px 0 0;
        max-width: 850px;
        color: rgba(255, 255, 255, .84);
        font-size: 14px;
        line-height: 1.7;
    }


    /* =========================================================
       QUICK ACTIONS
       ========================================================= */

    .quick-actions {
        display: grid;
        grid-template-columns: repeat(6, minmax(0, 1fr));
        gap: 15px;
        margin-bottom: 25px;
    }

    .quick-card {
        position: relative;
        min-height: 118px;
        padding: 16px;
        box-sizing: border-box;
        border: 1px solid var(--border);
        border-radius: 18px;
        background: rgba(255, 255, 255, .97);
        box-shadow: 0 7px 22px rgba(35, 53, 47, .055);
        overflow: hidden;
        transition: transform .25s ease, box-shadow .25s ease, border-color .25s ease;
    }

        .quick-card::after {
            content: "";
            position: absolute;
            width: 75px;
            height: 75px;
            right: -25px;
            top: -25px;
            border-radius: 50%;
            background: rgba(63, 128, 107, .055);
        }

        .quick-card:hover {
            transform: translateY(-6px);
            box-shadow: var(--shadow-hover);
            border-color: #c8dbd2;
        }

    .quick-link {
        position: relative;
        z-index: 2;
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 9px;
        text-align: center;
        color: var(--text-main);
        text-decoration: none;
        font-size: 13px;
        font-weight: 700;
    }

        .quick-link:hover {
            color: var(--primary);
            text-decoration: none;
        }

    .quick-icon {
        width: 42px;
        height: 42px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 13px;
        color: #ffffff;
        font-size: 17px;
        font-weight: 800;
        box-shadow: 0 7px 15px rgba(0, 0, 0, .10);
        transition: transform .25s ease;
    }

    .quick-card:hover .quick-icon {
        transform: scale(1.08) rotate(-3deg);
    }


    /* =========================================================
       QUICK ICONS
       ========================================================= */

    .icon-teal {
        background: linear-gradient( 135deg, #3f806b, #6b9d8b );
    }

    .icon-blue {
        background: linear-gradient( 135deg, #607d73, #89a59b );
    }

    .icon-green {
        background: linear-gradient( 135deg, #4f9277, #76ae96 );
    }

    .icon-red {
        background: linear-gradient( 135deg, #bd5965, #d87983 );
    }

    .icon-orange {
        background: linear-gradient( 135deg, #c48a48, #d9aa69 );
    }

    .icon-slate {
        background: linear-gradient( 135deg, #60776e, #82988f );
    }


    /* =========================================================
       LIVE STATISTICS BOX
       ========================================================= */

    .live-statistics-box {
        width: 100%;
        box-sizing: border-box;
        margin-bottom: 25px;
        padding: 25px;
        border: 1px solid var(--border);
        border-radius: var(--radius-lg);
        background: rgba(255, 255, 255, .97);
        box-shadow: var(--shadow);
        position: relative;
        overflow: hidden;
    }

        .live-statistics-box::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: linear-gradient( 90deg, #3f806b, #6b9d8b, #86aa9d );
        }


    /* =========================================================
       STAT HEADER
       ========================================================= */

    .stats-box-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        margin-bottom: 20px;
        padding-bottom: 17px;
        border-bottom: 1px solid #e4ece8;
    }

    .stats-title-area {
        display: flex;
        align-items: center;
        gap: 12px;
        min-width: 0;
    }

    .stats-title-icon {
        width: 42px;
        height: 42px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 13px;
        color: #ffffff;
        font-size: 17px;
        font-weight: 800;
        background: linear-gradient( 135deg, #3f806b, #6b9d8b );
        box-shadow: 0 8px 18px rgba(63, 128, 107, .20);
    }

    .stats-title-text {
        min-width: 0;
    }

        .stats-title-text h3 {
            margin: 0;
            color: var(--text-main);
            font-size: 18px;
            font-weight: 800;
            letter-spacing: -.25px;
        }

        .stats-title-text p {
            margin: 4px 0 0;
            color: var(--text-muted);
            font-size: 12px;
        }

    .stats-live-status {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 7px 12px;
        flex-shrink: 0;
        border-radius: 999px;
        color: #397461;
        background: var(--success-soft);
        border: 1px solid #cee9df;
        font-size: 11px;
        font-weight: 700;
        white-space: nowrap;
    }

        .stats-live-status::before {
            content: "";
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: var(--success);
            box-shadow: 0 0 0 4px rgba(79, 146, 119, .10);
            animation: statsPulse 1.8s infinite;
        }

    @@keyframes statsPulse {

        0% {
            box-shadow: 0 0 0 0 rgba(79, 146, 119, .25);
        }

        70% {
            box-shadow: 0 0 0 6px rgba(79, 146, 119, 0);
        }

        100% {
            box-shadow: 0 0 0 0 rgba(79, 146, 119, 0);
        }
    }


    /* =========================================================
       STATS CONTAINER
       ========================================================= */

    #nurseStatsContainer {
        width: 100%;
        box-sizing: border-box;
    }

        #nurseStatsContainer .row {
            display: grid !important;
            grid-template-columns: repeat(4, minmax(0, 1fr)) !important;
            gap: 16px !important;
            width: 100%;
            margin: 0 !important;
            padding: 0 !important;
            align-items: stretch;
        }

            #nurseStatsContainer .row::before,
            #nurseStatsContainer .row::after {
                display: none !important;
            }

            #nurseStatsContainer .row > [class*="col-"] {
                width: 100% !important;
                max-width: none !important;
                min-width: 0 !important;
                margin: 0 !important;
                padding: 0 !important;
                float: none !important;
                display: flex !important;
                align-items: stretch;
            }


        /* =========================================================
       STAT CARDS
       ========================================================= */

        #nurseStatsContainer .card,
        #nurseStatsContainer .stat-card,
        #nurseStatsContainer .dashboard-stat,
        #nurseStatsContainer .stats-card {
            position: relative;
            width: 100% !important;
            min-width: 0;
            min-height: 155px !important;
            height: 155px !important;
            box-sizing: border-box;
            display: flex !important;
            flex-direction: column !important;
            align-items: center !important;
            justify-content: center !important;
            margin: 0 !important;
            padding: 20px 18px !important;
            border: 1px solid var(--border) !important;
            border-radius: 17px !important;
            background: linear-gradient( 145deg, #ffffff 0%, #f8fbf9 100% ) !important;
            box-shadow: 0 6px 18px rgba(35, 53, 47, .045) !important;
            overflow: hidden;
            text-align: center !important;
            transition: transform .22s ease, box-shadow .22s ease, border-color .22s ease;
        }

            #nurseStatsContainer .card::before,
            #nurseStatsContainer .stat-card::before,
            #nurseStatsContainer .dashboard-stat::before,
            #nurseStatsContainer .stats-card::before {
                content: "";
                position: absolute;
                top: 0;
                left: 18%;
                right: 18%;
                height: 3px;
                border-radius: 0 0 8px 8px;
                background: linear-gradient( 90deg, #3f806b, #6b9d8b );
                opacity: .85;
            }

        #nurseStatsContainer .card-body {
            width: 100% !important;
            height: 100% !important;
            box-sizing: border-box;
            display: flex !important;
            flex-direction: column !important;
            align-items: center !important;
            justify-content: center !important;
            padding: 0 !important;
            margin: 0 !important;
            text-align: center !important;
        }

            #nurseStatsContainer .card-body > * {
                margin-left: 0 !important;
                margin-right: 0 !important;
            }

        #nurseStatsContainer .card i,
        #nurseStatsContainer .stat-card i,
        #nurseStatsContainer .dashboard-stat i,
        #nurseStatsContainer .stats-card i {
            width: 40px;
            height: 40px;
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 0 10px !important;
            border-radius: 12px;
            background: var(--soft-green);
            color: var(--primary);
            font-size: 16px;
        }

        #nurseStatsContainer .card h1,
        #nurseStatsContainer .card h2,
        #nurseStatsContainer .card h3,
        #nurseStatsContainer .card h4,
        #nurseStatsContainer .card h5,
        #nurseStatsContainer .card h6,
        #nurseStatsContainer .stat-card h1,
        #nurseStatsContainer .stat-card h2,
        #nurseStatsContainer .stat-card h3,
        #nurseStatsContainer .stat-card h4,
        #nurseStatsContainer .stat-card h5,
        #nurseStatsContainer .stat-card h6,
        #nurseStatsContainer .dashboard-stat h1,
        #nurseStatsContainer .dashboard-stat h2,
        #nurseStatsContainer .dashboard-stat h3,
        #nurseStatsContainer .dashboard-stat h4,
        #nurseStatsContainer .dashboard-stat h5,
        #nurseStatsContainer .dashboard-stat h6,
        #nurseStatsContainer .stats-card h1,
        #nurseStatsContainer .stats-card h2,
        #nurseStatsContainer .stats-card h3,
        #nurseStatsContainer .stats-card h4,
        #nurseStatsContainer .stats-card h5,
        #nurseStatsContainer .stats-card h6 {
            margin: 0 !important;
            padding: 0 !important;
            color: var(--text-main) !important;
            font-size: 28px;
            line-height: 1.1;
            font-weight: 800;
            letter-spacing: -.8px;
            text-align: center !important;
        }

        #nurseStatsContainer .card p,
        #nurseStatsContainer .stat-card p,
        #nurseStatsContainer .dashboard-stat p,
        #nurseStatsContainer .stats-card p {
            margin: 7px 0 0 !important;
            padding: 0 !important;
            color: var(--text-muted) !important;
            font-size: 11px;
            line-height: 1.35;
            font-weight: 700;
            text-align: center !important;
            text-transform: uppercase;
            letter-spacing: .45px;
        }

        #nurseStatsContainer .badge {
            display: inline-flex !important;
            align-items: center;
            justify-content: center;
            margin: 7px 0 0 !important;
            padding: 5px 9px;
            border-radius: 999px;
            font-size: 10px;
            line-height: 1;
            font-weight: 700;
        }

        #nurseStatsContainer .card:hover,
        #nurseStatsContainer .stat-card:hover,
        #nurseStatsContainer .dashboard-stat:hover,
        #nurseStatsContainer .stats-card:hover {
            transform: translateY(-5px);
            border-color: #c5d8ce !important;
            box-shadow: 0 14px 30px rgba(35, 53, 47, .10) !important;
        }


    /* =========================================================
       SNAPSHOT
       ========================================================= */

    .wellness-strip {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        padding: 19px 23px;
        margin-bottom: 30px;
        border-radius: 17px;
        border: 1px solid var(--border);
        background: rgba(255, 255, 255, .96);
        box-shadow: 0 6px 20px rgba(35, 53, 47, .045);
    }

    .snapshot-title {
        display: flex;
        align-items: center;
        gap: 10px;
        white-space: nowrap;
        font-size: 14px;
        font-weight: 800;
        color: var(--text-main);
    }

    .snapshot-icon {
        width: 32px;
        height: 32px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        border-radius: 10px;
        color: #ffffff;
        background: linear-gradient( 135deg, #3f806b, #6b9d8b );
        font-size: 13px;
    }

    .wellness-strip .meta {
        display: flex;
        justify-content: flex-end;
        flex-wrap: wrap;
        gap: 8px;
    }

    .meta span {
        padding: 7px 11px;
        border-radius: 999px;
        background: #f1f6f3;
        border: 1px solid #dce6e1;
        color: #687b74;
        font-size: 11px;
        font-weight: 600;
    }


    /* =========================================================
       SECTION HEADING
       ========================================================= */

    .section-heading {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 16px;
    }

    .section-title {
        margin: 0;
        font-size: 21px;
        font-weight: 800;
        letter-spacing: -.35px;
        color: var(--text-main);
    }

    .section-subtitle {
        margin: 4px 0 0;
        color: var(--text-muted);
        font-size: 12px;
    }


    /* =========================================================
       COMMAND PANEL
       ========================================================= */

    .command-panel {
        padding: 27px;
        border-radius: 21px;
        border: 1px solid var(--border);
        background: rgba(255, 255, 255, .96);
        box-shadow: var(--shadow);
    }

    .panel-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        margin-bottom: 22px;
    }

    .panel-title-wrap {
        min-width: 0;
    }

        .panel-title-wrap h3 {
            margin: 0;
            font-size: 18px;
            font-weight: 800;
            color: var(--text-main);
        }

        .panel-title-wrap p {
            margin: 4px 0 0;
            color: var(--text-muted);
            font-size: 12px;
        }

    .live-badge {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 7px 12px;
        flex-shrink: 0;
        border-radius: 999px;
        color: #397461;
        background: var(--success-soft);
        border: 1px solid #cee9df;
        font-size: 11px;
        font-weight: 700;
    }

        .live-badge::before {
            content: "";
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: var(--success);
            box-shadow: 0 0 0 4px rgba(79, 146, 119, .10);
        }


    /* =========================================================
       WORKFLOW GRID
       ========================================================= */

    .command-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 16px;
    }

    .command-item {
        position: relative;
        min-height: 235px;
        padding: 22px;
        border-radius: 17px;
        border: 1px solid var(--border);
        background: linear-gradient( 145deg, #ffffff, #f8fbf9 );
        overflow: hidden;
        transition: transform .25s ease, box-shadow .25s ease, border-color .25s ease;
    }

        .command-item::before {
            content: "";
            position: absolute;
            left: 0;
            top: 0;
            width: 100%;
            height: 4px;
            background: linear-gradient( 90deg, #3f806b, #6b9d8b );
            transform: scaleX(.35);
            transform-origin: left;
            transition: transform .3s ease;
        }

        .command-item:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 32px rgba(35, 53, 47, .09);
            border-color: #c9dcd3;
        }

            .command-item:hover::before {
                transform: scaleX(1);
            }


    /* =========================================================
       WORKFLOW ICON
       ========================================================= */

    .workflow-icon {
        width: 42px;
        height: 42px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 18px;
        border-radius: 12px;
        background: var(--soft-green);
        color: var(--primary);
        font-weight: 800;
        font-size: 14px;
    }


    /* =========================================================
       WORKFLOW CONTENT
       ========================================================= */

    .command-item .label {
        margin-bottom: 7px;
        color: var(--primary);
        font-size: 10px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .8px;
    }

    .command-item h4 {
        margin: 0 0 9px;
        font-size: 15px;
        line-height: 1.4;
        font-weight: 800;
        color: var(--text-main);
    }

    .command-item p {
        margin: 0 0 18px;
        color: var(--text-muted);
        font-size: 12px;
        line-height: 1.65;
    }

    .command-item a {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        color: var(--primary);
        text-decoration: none;
        font-size: 12px;
        font-weight: 750;
        transition: color .2s ease, transform .2s ease;
    }

        .command-item a:hover {
            color: var(--primary-dark);
            transform: translateX(3px);
            text-decoration: none;
        }


    /* =========================================================
       LOGOUT
       ========================================================= */

    .logout-wrapper {
        display: flex;
        justify-content: flex-end;
        margin-top: 25px;
    }

    .logout-btn {
        display: inline-flex;
        align-items: center;
