<canvas id="cursorCanvas"></canvas>


@section Scripts {

    <script>

    function toggleSidebar() {

        const sidebar =
            document.getElementById('dashboardSidebar');

        const overlay =
            document.getElementById('sidebarOverlay');

        if (!sidebar) return;

        sidebar.classList.toggle('open');

        if (overlay) {

            overlay.classList.toggle(
                'active',
                sidebar.classList.contains('open')
            );

        }

    }


    document.addEventListener('keydown', function (event) {

        if (event.key === 'Escape') {

            const sidebar =
                document.getElementById('dashboardSidebar');

            const overlay =
                document.getElementById('sidebarOverlay');

            if (sidebar)
                sidebar.classList.remove('open');

            if (overlay)
                overlay.classList.remove('active');

        }

    });


    /* Background movement */

    const shapes =
        document.querySelectorAll('.bg-shape');

    document.addEventListener('mousemove', function (e) {

        const x =
            (window.innerWidth / 2 - e.clientX) / 35;

        const y =
            (window.innerHeight / 2 - e.clientY) / 35;

        shapes.forEach(function (shape, index) {

            const speed = (index + 1) * .65;

            shape.style.transform =
                `translate(${x * speed}px,${y * speed}px)`;

        });

    });


    /* Cursor glow */

    const canvas =
        document.getElementById('cursorCanvas');

    if (canvas) {

        const ctx =
            canvas.getContext('2d');

        let w = canvas.width =
            window.innerWidth;

        let h = canvas.height =
            window.innerHeight;

        let mouse = {
            x: w / 2,
            y: h / 2
        };

        window.addEventListener('resize', function () {

            w = canvas.width =
                window.innerWidth;

            h = canvas.height =
                window.innerHeight;

        });

        document.addEventListener('mousemove', function (e) {

            mouse.x = e.clientX;
            mouse.y = e.clientY;

        });

        function drawGlow(x, y, radius) {

            const gradient =
                ctx.createRadialGradient(
                    x, y, 0,
                    x, y, radius
                );

            gradient.addColorStop(
                0,
                'rgba(79,70,229,.10)'
            );

            gradient.addColorStop(
                1,
                'rgba(79,70,229,0)'
            );

            ctx.fillStyle = gradient;

            ctx.beginPath();

            ctx.arc(
                x,
                y,
                radius,
                0,
                Math.PI * 2
            );

            ctx.fill();

        }

        function animate() {

            ctx.clearRect(0,0,w,h);

            drawGlow(
                mouse.x,
                mouse.y,
                50
            );

            requestAnimationFrame(animate);

        }

        animate();

    }


    /* =====================================================
       LIVE REPORT POLLING
       ===================================================== */

    $(document).ready(function () {

        setInterval(function () {

            $.ajax({

                url:
                    '@Url.Action(
                        "GetFamilyDashboardJson",
                        "Family"
                    )',

                type: 'GET',

                cache: false,

                success: function (result) {

                    $('#familyContentContainer')
                        .html(result);

                },

                error: function (err) {

                    console.log(
                        "Error polling family dashboard stats:",
                        err
                    );
                    
                }

            });

        }, 3000);

    });

    </script>

}