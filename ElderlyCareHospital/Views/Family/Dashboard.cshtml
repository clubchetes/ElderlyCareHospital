@model ElderlyCareHospital.Models.Patient

@{
    ViewBag.Title = "Family Dashboard";
}

<style>

    :root {
        --app-bg: #f5f7fb;
        --surface: #ffffff;
        --surface-soft: #f8fafc;
        --surface-blue: #f4f7ff;
        --text-main: #172033;
        --text-muted: #64748b;
        --text-light: #94a3b8;
        --primary: #4f46e5;
        --primary-dark: #4338ca;
        --secondary: #0ea5e9;
        --success: #0d9488;
        --danger: #e11d48;
        --warning: #d97706;
        --border: #e5e9f0;
        --shadow-sm: 0 2px 8px rgba(15, 23, 42, .04);
        --shadow-md: 0 12px 30px rgba(15, 23, 42, .07);
        --shadow-lg: 0 20px 45px rgba(15, 23, 42, .09);
    }

    * {
        box-sizing: border-box;
    }

    html,
    body {
        margin: 0;
        padding: 0;
        min-height: 100%;
    }

    body {
        background: var(--app-bg);
        color: var(--text-main);
        font-family: 'Inter', 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        overflow-x: hidden;
    }


    /* =====================================================
       BACKGROUND
       ===================================================== */

    .bg-shape {
        position: fixed;
        border-radius: 50%;
        pointer-events: none;
        z-index: 0;
        filter: blur(10px);
        transition: transform .18s ease-out;
    }

    .shape1 {
        width: 330px;
        height: 330px;
        top: 2%;
        left: 3%;
        background: rgba(79, 70, 229, .035);
    }

    .shape2 {
        width: 270px;
        height: 270px;
        right: 2%;
        bottom: 7%;
        background: rgba(14, 165, 233, .035);
    }

    .shape3 {
        width: 200px;
        height: 200px;
        top: 48%;
        left: 44%;
        background: rgba(13, 148, 136, .025);
    }


    /* =====================================================
       SIDEBAR
       ===================================================== */

    .sidebar-overlay {
        position: fixed;
        inset: 0;
        background: rgba(15, 23, 42, .28);
        backdrop-filter: blur(2px);
        opacity: 0;
        visibility: hidden;
        z-index: 1190;
        transition: all .25s ease;
    }

        .sidebar-overlay.active {
            opacity: 1;
            visibility: visible;
        }

    .dashboard-sidebar {
        position: fixed;
        top: 0;
        left: -310px;
        bottom: 0;
        width: 280px;
        background: rgba(255,255,255,.98);
        border-right: 1px solid var(--border);
        padding: 24px 18px;
        display: flex;
        flex-direction: column;
        z-index: 1200;
        box-shadow: 12px 0 35px rgba(15,23,42,.10);
        transition: left .32s cubic-bezier(.4,0,.2,1);
        overflow-y: auto;
    }

        .dashboard-sidebar.open {
            left: 0;
        }

    .sidebar-brand {
        min-height: 50px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 32px;
        padding: 0 5px;
    }

    .sidebar-brand-left {
        display: flex;
        align-items: center;
        gap: 11px;
        font-size: 17px;
        font-weight: 700;
        white-space: nowrap;
    }

    .sidebar-logo {
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 11px;
        background: linear-gradient(135deg,var(--primary),var(--secondary));
        color: white;
        font-size: 12px;
        font-weight: 800;
        box-shadow: 0 7px 18px rgba(79,70,229,.22);
    }

    .sidebar-close-btn {
        width: 35px;
        height: 35px;
        border: none;
        border-radius: 9px;
        background: transparent;
        color: var(--text-muted);
        font-size: 22px;
        cursor: pointer;
        transition: all .2s ease;
    }

        .sidebar-close-btn:hover {
            background: #f1f5f9;
            color: var(--primary);
            transform: rotate(90deg);
        }

    .sidebar-menu {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

        .sidebar-menu li a {
            min-height: 46px;
            display: flex;
            align-items: center;
            padding: 11px 14px;
            border-radius: 11px;
            color: var(--text-muted);
            text-decoration: none;
            font-size: 14px;
            font-weight: 500;
            transition: all .2s ease;
        }

            .sidebar-menu li a:hover {
                background: #f7f8fc;
                color: var(--primary);
                transform: translateX(3px);
            }

            .sidebar-menu li a.active {
                color: var(--primary);
                background: linear-gradient(135deg,rgba(79,70,229,.11),rgba(14,165,233,.07));
                font-weight: 700;
                box-shadow: inset 3px 0 0 var(--primary);
            }


    /* =====================================================
       MENU BUTTON
       ===================================================== */

    .sidebar-toggle-btn {
        position: fixed;
        top: 28px;
        left: 28px;
        width: 48px;
        height: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px solid var(--border);
        border-radius: 13px;
        background: rgba(255,255,255,.96);
        color: var(--text-main);
        cursor: pointer;
        z-index: 1100;
        box-shadow: var(--shadow-sm);
        transition: all .2s ease;
    }

        .sidebar-toggle-btn:hover {
            color: var(--primary);
            transform: translateY(-2px);
            box-shadow: var(--shadow-md);
        }


    /* =====================================================
       MAIN
       ===================================================== */

    .dashboard-main {
        position: relative;
        z-index: 1;
        width: 100%;
        max-width: 1450px;
        margin: 0 auto;
        padding: 28px 42px 55px 100px;
    }


    /* =====================================================
       HEADER
       ===================================================== */

    .family-header {
        position: relative;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 20px;
        padding: 32px 38px;
        margin-bottom: 28px;
        box-shadow: var(--shadow-sm);
        overflow: hidden;
    }

        .family-header::before {
            content: "";
            position: absolute;
            left: 0;
            top: 0;
            bottom: 0;
            width: 5px;
            background: linear-gradient(180deg,var(--primary),var(--secondary));
        }

        .family-header::after {
            content: "";
            position: absolute;
            width: 210px;
            height: 210px;
            right: -90px;
            top: -110px;
            border-radius: 50%;
            background: rgba(79,70,229,.035);
        }

    .family-header-content {
        position: relative;
        z-index: 2;
    }

    .family-header h2 {
        margin: 0;
        font-size: 26px;
        font-weight: 750;
        letter-spacing: -.5px;
    }

    .family-header p {
        max-width: 900px;
        margin: 9px 0 0;
        color: var(--text-muted);
        font-size: 14px;
        line-height: 1.65;
    }


    /* =====================================================
       QUICK ACTIONS
       ===================================================== */

    .quick-actions {
        display: grid;
        grid-template-columns: repeat(4,1fr);
        gap: 18px;
        margin-bottom: 30px;
    }

    .feature-card {
        min-height: 145px;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 17px;
        box-shadow: var(--shadow-sm);
        transition: all .22s ease;
        overflow: hidden;
    }

        .feature-card:hover {
            transform: translateY(-5px);
            border-color: #d7ddea;
            box-shadow: var(--shadow-md);
        }

        .feature-card a {
            min-height: 145px;
            padding: 22px 18px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 12px;
            color: var(--text-main);
            text-decoration: none;
            font-size: 14px;
            font-weight: 650;
        }

    .action-icon {
        width: 47px;
        height: 47px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 13px;
        color: white;
        box-shadow: 0 7px 16px rgba(15,23,42,.10);
    }

    .icon-visits {
        background: linear-gradient(135deg,#0284c7,#0ea5e9);
    }

    .icon-book {
        background: linear-gradient(135deg,#4f46e5,#6366f1);
    }

    .icon-message {
        background: linear-gradient(135deg,#0d9488,#14b8a6);
    }

    .icon-heart {
        background: linear-gradient(135deg,#e11d48,#f43f5e);
    }


    /* =====================================================
       LIVE REPORT AREA
       ===================================================== */

    #familyContentContainer {
        width: 100%;
        margin: 0 0 30px;
    }

        #familyContentContainer > * {
            width: 100%;
        }


        /* =====================================================
       FALLBACK / PARTIAL CARD STYLING
       ===================================================== */

        #familyContentContainer .row {
            display: grid;
            grid-template-columns: repeat(2,minmax(0,1fr));
            gap: 18px;
            margin: 0;
        }

            #familyContentContainer .row > [class*="col-"] {
                width: 100%;
                max-width: none;
                padding: 0;
            }

        #familyContentContainer .card,
        #familyContentContainer .panel,
        #familyContentContainer .stat-card,
        #familyContentContainer .dashboard-card {
            width: 100%;
            border: 1px solid var(--border);
            border-radius: 16px;
            background: white;
            box-shadow: var(--shadow-sm);
            overflow: hidden;
        }


    /* =====================================================
       CARE CENTER
       ===================================================== */

    .section-heading {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin: 5px 0 15px;
    }

    .section-title {
        margin: 0;
        font-size: 20px;
        font-weight: 750;
        letter-spacing: -.3px;
    }

    .section-subtitle {
        color: var(--text-muted);
        font-size: 12px;
    }

    .care-center {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 18px;
        padding: 8px 26px;
        box-shadow: var(--shadow-sm);
    }

    .care-center-list {
        list-style: none;
        padding: 0;
        margin: 0;
    }

        .care-center-list li {
            border-bottom: 1px solid var(--border);
        }

            .care-center-list li:last-child {
                border-bottom: none;
            }

        .care-center-list a {
            min-height: 62px;
            display: flex;
            align-items: center;
            gap: 14px;
            padding: 9px 4px;
            color: var(--text-main);
            text-decoration: none;
            font-size: 14px;
            font-weight: 550;
            transition: all .2s ease;
        }

            .care-center-list a::before {
                content: "→";
                width: 34px;
                height: 34px;
                flex-shrink: 0;
                display: flex;
                align-items: center;
                justify-content: center;
                border-radius: 9px;
                background: rgba(79,70,229,.08);
                color: var(--primary);
                font-weight: 700;
                transition: all .2s ease;
            }

            .care-center-list a:hover {
                color: var(--primary);
                padding-left: 8px;
            }

                .care-center-list a:hover::before {
                    background: var(--primary);
                    color: white;
                    transform: translateX(2px);
                }


    /* =====================================================
       LOGOUT
       ===================================================== */

    .logout-container {
        display: flex;
        justify-content: flex-end;
        margin-top: 24px;
    }

    .logout-btn {
        min-width: 115px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 11px 20px;
        border-radius: 11px;
        background: white;
        border: 1px solid #e2e8f0;
        color: #64748b;
        text-decoration: none;
        font-size: 13px;
        font-weight: 650;
        transition: all .2s ease;
    }

        .logout-btn:hover {
            background: #fff;
            color: #dc2626;
            border-color: #fecaca;
            transform: translateY(-2px);
            box-shadow: var(--shadow-sm);
        }


    /* =====================================================
       CURSOR
       ===================================================== */

    #cursorCanvas {
        position: fixed;
        inset: 0;
        width: 100vw;
        height: 100vh;
        pointer-events: none;
        z-index: 999;
        opacity: .8;
    }


    /* =====================================================
       RESPONSIVE
       ===================================================== */

    @@media(max-width:1100px) {

        .dashboard-main {
            padding-left: 90px;
            padding-right: 30px;
        }

        .quick-actions {
            grid-template-columns: repeat(2,1fr);
        }
    }

    @@media(max-width:768px) {

        .sidebar-toggle-btn {
            top: 18px;
            left: 18px;
            width: 44px;
            height: 44px;
        }

        .dashboard-main {
            padding: 82px 18px 35px;
        }

        .family-header {
            padding: 26px 24px;
        }

            .family-header h2 {
                font-size: 22px;
            }

        .quick-actions {
            grid-template-columns: repeat(2,1fr);
            gap: 14px;
        }

        #familyContentContainer .row {
            grid-template-columns: 1fr;
        }

        .logout-container {
            justify-content: stretch;
        }

        .logout-btn {
            width: 100%;
        }
    }

    @@media(max-width:520px) {

        .dashboard-main {
            padding: 76px 14px 28px;
        }

        .quick-actions {
            gap: 10px;
        }

        .feature-card,
        .feature-card a {
            min-height: 120px;
        }

            .feature-card a {
                padding: 16px 8px;
                font-size: 12.5px;
            }

        .action-icon {
            width: 40px;
            height: 40px;
        }

        .family-header {
            padding: 22px 20px;
        }

            .family-header h2 {
                font-size: 20px;
            }

            .family-header p {
                font-size: 12.5px;
            }

        .care-center {
            padding: 5px 17px;
        }

        .care-center-list a {
            font-size: 13px;
            min-height: 55px;
        }
    }
</style>


