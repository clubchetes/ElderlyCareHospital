@model IEnumerable<ElderlyCareHospital.Models.EncouragementMessage>

@{
    ViewBag.Title = "Encouragement Messages";

    bool isNurse =
        ViewBag.IsNurse != null &&
        (bool)ViewBag.IsNurse;
}

<style>

    .messages-page {
        padding: 30px;
        max-width: 1400px;
        margin: 0 auto;
    }


    /* =========================================================
       HEADER
       ========================================================= */

    .messages-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
        gap: 20px;
    }

        .messages-header h2 {
            margin: 0;
            color: #0f172a;
            font-size: 24px;
            font-weight: 700;
        }

        .messages-header p {
            margin: 6px 0 0;
            color: #64748b;
            font-size: 13px;
        }


    /* =========================================================
       CREATE BUTTON
       ========================================================= */

    .create-message-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 10px 18px;
        background: #4f46e5;
        color: #ffffff;
        border-radius: 10px;
        text-decoration: none;
        font-weight: 600;
        font-size: 13px;
        transition: 0.2s ease;
        white-space: nowrap;
    }

        .create-message-btn:hover {
            background: #4338ca;
            color: #ffffff;
            text-decoration: none;
            transform: translateY(-1px);
        }


    /* =========================================================
       CARD
       ========================================================= */

    .messages-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 4px 15px rgba(15, 23, 42, 0.04);
    }


    /* =========================================================
       TABLE
       ========================================================= */

    .messages-table-wrapper {
        width: 100%;
        overflow-x: auto;
    }

    .messages-table {
        width: 100%;
        border-collapse: collapse;
        margin: 0;
    }

        .messages-table th {
            background: #f8fafc;
            color: #64748b;
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            font-weight: 700;
            padding: 15px 18px;
            text-align: left;
            border-bottom: 1px solid #e2e8f0;
            white-space: nowrap;
        }

        .messages-table td {
            padding: 16px 18px;
            color: #334155;
            font-size: 13px;
            border-bottom: 1px solid #eef2f7;
            vertical-align: middle;
        }

        .messages-table tbody tr:hover {
            background: #f8fafc;
        }

        .messages-table tbody tr:last-child td {
            border-bottom: none;
        }


    /* =========================================================
       PEOPLE
       ========================================================= */

    .person-name {
        font-weight: 600;
        color: #0f172a;
    }


    /* =========================================================
       MESSAGE
       ========================================================= */

    .message-text {
        max-width: 500px;
        line-height: 1.6;
        color: #334155;
    }


    /* =========================================================
       DATE
       ========================================================= */

    .date-text {
        color: #64748b;
        white-space: nowrap;
        font-size: 12px;
    }


    /* =========================================================
       ACTIONS
       ========================================================= */

    .action-links {
        white-space: nowrap;
    }

        .action-links a {
            color: #4f46e5;
            text-decoration: none;
            font-weight: 600;
            font-size: 12px;
            margin-right: 8px;
        }

            .action-links a:hover {
                text-decoration: underline;
            }


    /* =========================================================
       EMPTY
       ========================================================= */

    .empty-message {
        padding: 55px 20px;
        text-align: center;
        color: #64748b;
    }

    .empty-message-title {
        display: block;
        color: #334155;
        font-size: 15px;
        font-weight: 600;
        margin-bottom: 5px;
    }

    .empty-message-text {
        font-size: 12px;
    }


    /* =========================================================
       BACK
       ========================================================= */

    .back-link {
        display: inline-block;
        margin-top: 20px;
        color: #64748b;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
    }

        .back-link:hover {
            color: #4f46e5;
            text-decoration: none;
        }


    /* =========================================================
       MOBILE
       ========================================================= */

    @@media (max-width: 768px) {

        .messages-page {
            padding: 20px 15px;
        }

        .messages-header {
            align-items: flex-start;
            flex-direction: column;
        }

            .messages-header h2 {
                font-size: 20px;
            }

        .create-message-btn {
            width: 100%;
        }

        .messages-table th,
        .messages-table td {
            padding: 12px;
        }

        .message-text {
            max-width: 300px;
        }
    }
</style>


<div class="messages-page">


    <!-- =====================================================
         HEADER
         ===================================================== -->

    <div class="messages-header">

        <div>

            <h2>
                Encouragement Messages
            </h2>

            @if (isNurse)
            {
                <p>
                    View encouragement messages from all family members.
                </p>
            }
            else
            {
                <p>
                    Messages for your assigned patient.
                </p>
            }

        </div>


        <!-- =================================================
             CREATE BUTTON

             IMPORTANT:
             Nurse will NOT see this button.
             ================================================= -->

        @if (!isNurse)
        {
            <a href="@Url.Action("Create", "EncouragementMessages")"
               class="create-message-btn">

                <span>+</span>

                Create New Message

            </a>
        }

    </div>


    <!-- =====================================================
         MESSAGES TABLE
         ===================================================== -->

    <div class="messages-card">

        <div class="messages-table-wrapper">

            <table class="messages-table">

                <thead>

                    <tr>

                        <th>
                            Patient
                        </th>

                        <th>
                            Family Member
                        </th>

                        <th>
                            Message
                        </th>

                        <th>
                            Date Sent
                        </th>

                        <th>
                            Actions
                        </th>

                    </tr>

                </thead>


                <tbody>

                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            var patient =
                                ViewBag.Patients[item.PatientID]
                                as ElderlyCareHospital.Models.Patient;

                            var family =
                                ViewBag.FamilyMembers[item.FamilyID]
                                as ElderlyCareHospital.Models.FamilyMember;


                            <tr>

                                <!-- PATIENT -->

                                <td>

                                    @if (patient != null)
                                    {
                                        <span class="person-name">

                                            @patient.FirstName
                                            @patient.LastName

                                        </span>
                                    }
                                    else
                                    {
                                        <span>
                                            Patient not found
                                        </span>
                                    }

                                </td>


                                <!-- FAMILY MEMBER -->

                                <td>

                                    @if (family != null)
                                    {
                                        <span class="person-name">

                                            @family.FullName

                                        </span>
                                    }
                                    else
                                    {
                                        <span>
                                            Family member not found
                                        </span>
                                    }

                                </td>


                                <!-- MESSAGE -->

                                <td>

                                    <div class="message-text">

                                        @item.MessageText

                                    </div>

                                </td>


                                <!-- DATE -->

                                <td>

                                    <span class="date-text">

                                        @item.DateSent.ToString(
                                            "dd MMM yyyy HH:mm"
                                        )

                                    </span>

                                </td>


                                <!-- ACTIONS -->

                                <td>

                                    <div class="action-links">

                                        @Html.ActionLink(
                                            "Details",
                                            "Details",
                                            new
                                            {
                                                id = item.MessageID
                                            }
                                        )

                                       
                                            @Html.ActionLink(
                                                "Delete",
                                                "Delete",
                                                new
                                                {
                                                    id = item.MessageID
                                                }
                                            )
                                        

                                    </div>

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>

                            <td colspan="5">

                                <div class="empty-message">

                                    @if (isNurse)
                                    {
                                        <span class="empty-message-title">
                                            No encouragement messages
                                        </span>

                                        <span class="empty-message-text">
                                            There are currently no encouragement messages from family members.
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="empty-message-title">
                                            No messages yet
                                        </span>

                                        <span class="empty-message-text">
                                            You have not created any encouragement messages for your assigned patient.
                                        </span>
                                    }

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>


    <!-- =====================================================
         BACK TO DASHBOARD
         ===================================================== -->

    @if (isNurse)
    {
        <a href="@Url.Action("Dashboard", "Nurse")"
           class="back-link">

            ← Back to Nurse Dashboard

        </a>
    }
    else
    {
        <a href="@Url.Action("Dashboard", "Family")"
           class="back-link">

            ← Back to Family Dashboard

        </a>
    }


</div>