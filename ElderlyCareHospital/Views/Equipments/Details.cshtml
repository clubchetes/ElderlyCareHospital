@model ElderlyCareHospital.Models.Equipment

@{
    ViewBag.Title = "Equipment Details";
}

<style>
    body {
        background: #f4f8fb;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .equipment-details-page {
        max-width: 850px;
        margin: 40px auto;
        padding: 0 20px;
    }

    .details-card {
        background: #ffffff;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(0,0,0,0.08);
    }

    .details-header {
        background: linear-gradient(135deg, #2f6f73, #4c8c91);
        color: white;
        padding: 30px 35px;
    }

        .details-header h2 {
            margin: 0;
            font-size: 28px;
            font-weight: 700;
        }

        .details-header p {
            margin: 9px 0 0;
            font-size: 14px;
            opacity: 0.95;
        }

    .details-content {
        padding: 35px 40px;
    }

    .section-title {
        color: #2f6f73;
        font-size: 18px;
        font-weight: 700;
        margin: 0 0 22px;
        padding-bottom: 12px;
        border-bottom: 2px solid #e5eeee;
    }

    .details-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 15px;
    }

    .detail-item {
        background: #f8fbfb;
        border: 1px solid #e5eeee;
        border-radius: 12px;
        padding: 16px 18px;
    }

    .detail-label {
        display: block;
        color: #718083;
        font-size: 12px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.4px;
        margin-bottom: 7px;
    }

    .detail-value {
        color: #263f41;
        font-size: 15px;
        font-weight: 600;
        word-break: break-word;
    }

    .quantity-value {
        display: inline-block;
        padding: 6px 12px;
        border-radius: 20px;
        background: #eaf6ed;
        color: #28743b;
        font-size: 13px;
        font-weight: 700;
    }

    .condition-value {
        display: inline-block;
        padding: 6px 12px;
        border-radius: 20px;
        background: #fff4d6;
        color: #946c00;
        font-size: 13px;
        font-weight: 700;
    }

    .location-value {
        color: #356b91;
    }

    .details-actions {
        display: flex;
        justify-content: center;
        gap: 12px;
        margin-top: 30px;
        padding-top: 25px;
        border-top: 1px solid #e5eeee;
    }

    .edit-button {
        display: inline-block;
        padding: 11px 24px;
        background: linear-gradient(135deg, #2f6f73, #3f858a);
        color: white !important;
        border-radius: 10px;
        text-decoration: none !important;
        font-weight: 700;
        box-shadow: 0 6px 16px rgba(47,111,115,0.18);
        transition: all 0.2s ease;
    }

        .edit-button:hover {
            background: linear-gradient(135deg, #25575a, #347378);
            transform: translateY(-2px);
        }

    .back-link {
        display: inline-block;
        padding: 11px 20px;
        border-radius: 10px;
        color: #2f6f73 !important;
        background: #fff;
        border: 1px solid #d6e3e5;
        text-decoration: none !important;
        font-weight: 600;
        transition: all 0.2s ease;
    }

        .back-link:hover {
            background: #eef6f6;
            transform: translateY(-2px);
        }

    .page-footer {
        text-align: center;
        margin-top: 20px;
    }

    @@media (max-width: 768px) {
        .equipment-details-page {
            margin: 25px auto;
        }

        .details-header {
            padding: 25px;
        }

            .details-header h2 {
                font-size: 23px;
            }

        .details-content {
            padding: 25px 20px;
        }

        .details-grid {
            grid-template-columns: 1fr;
        }

        .details-actions {
            flex-direction: column;
        }

        .edit-button,
        .back-link {
            width: 100%;
            text-align: center;
        }
    }
</style>

<div class="equipment-details-page">

    <div class="details-card">

        <div class="details-header">
            <h2>Equipment Details</h2>
            <p>
                View complete information about this hospital equipment
                inventory item.
            </p>
        </div>

        <div class="details-content">

            <h4 class="section-title">
                Equipment Information
            </h4>

            <div class="details-grid">

                <div class="detail-item">
                    <span class="detail-label">Equipment Name</span>
                    <span class="detail-value">
                        @Html.DisplayFor(model => model.EquipmentName)
                    </span>
                </div>

                <div class="detail-item">
                    <span class="detail-label">Category</span>
                    <span class="detail-value">
                        @Html.DisplayFor(model => model.Category)
                    </span>
                </div>

                <div class="detail-item">
                    <span class="detail-label">Current Quantity</span>
                    <span class="quantity-value">
                        @Html.DisplayFor(model => model.Quantity)
                    </span>
                </div>

                <div class="detail-item">
                    <span class="detail-label">Minimum Quantity</span>
                    <span class="detail-value">
                        @Html.DisplayFor(model => model.MinimumQuantity)
                    </span>
                </div>

                <div class="detail-item">
                    <span class="detail-label">Condition</span>
                    <span class="condition-value">
                        @Html.DisplayFor(model => model.Condition)
                    </span>
                </div>

                <div class="detail-item">
                    <span class="detail-label">Purchase Date</span>
                    <span class="detail-value">
                        @Html.DisplayFor(model => model.PurchaseDate)
                    </span>
                </div>

                <div class="detail-item">
                    <span class="detail-label">Last Maintenance</span>
                    <span class="detail-value">
                        @Html.DisplayFor(model => model.LastMaintenanceDate)
                    </span>
                </div>

                <div class="detail-item">
                    <span class="detail-label">Location</span>
                    <span class="detail-value location-value">
                        @Html.DisplayFor(model => model.Location)
                    </span>
                </div>

            </div>

            <div class="details-actions">

                @Html.ActionLink(
                    "Edit Equipment",
                    "Edit",
                    new { id = Model.EquipmentID },
                    new { @class = "edit-button" })

                @Html.ActionLink(
                    "Back to Inventory",
                    "Index",
                    null,
                    new { @class = "back-link" })

            </div>

        </div>

    </div>

    <div class="page-footer">
        @Html.ActionLink(
            "Back to Dashboard",
            "Dashboard",
            "Pharmacist",
            null,
            new { @class = "back-link" })
    </div>

</div>