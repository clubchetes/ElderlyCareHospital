@model ElderlyCareHospital.Models.CleaningTask

@{
    ViewBag.Title = "Edit";
}

<style>

    /* =========================================================
       ROOT / ELDERLYCARE HOSPITAL THEME
       ========================================================= */

    :root {
        --app-bg: #f8fafc;
        --surface: #ffffff;
        --surface-soft: #f8fbfd;
        --text-main: #0f172a;
        --text-muted: #64748b;
        --primary: #4f46e5;
        --primary-hover: #4338ca;
        --secondary: #0ea5e9;
        --border-color: #e2e8f0;
    }


    /* =========================================================
       PAGE
       ========================================================= */

    html,
    body {
        margin: 0;
        padding: 0;
        min-height: 100%;
    }

    body {
        background: var(--app-bg);
        font-family: 'Inter', 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        color: var(--text-main);
        overflow-x: hidden;
    }


    /* =========================================================
       MAIN PAGE WRAPPER
       ========================================================= */

    .edit-task-page {
        width: 100%;
        max-width: 1000px;
        margin: 0 auto;
        padding: 36px 40px 45px;
        box-sizing: border-box;
    }


    /* =========================================================
       HEADER
       ========================================================= */

    .edit-task-header {
        background: var(--surface);
        color: var(--text-main);
        padding: 28px 34px;
        border-radius: 18px;
        margin-bottom: 26px;
        border: 1px solid var(--border-color);
        box-shadow: 0 4px 20px rgba(15, 23, 42, 0.03);
    }

        .edit-task-header h2 {
            margin: 0;
            font-weight: 700;
            font-size: 24px;
            letter-spacing: -0.3px;
            line-height: 1.3;
        }

        .edit-task-header p {
            margin: 8px 0 0;
            color: var(--text-muted);
            font-size: 14px;
            line-height: 1.6;
        }


    /* =========================================================
       MAIN PANEL
       ========================================================= */

    .edit-task-panel {
        background: var(--surface);
        border-radius: 18px;
        padding: 30px;
        border: 1px solid var(--border-color);
        box-shadow: 0 4px 18px rgba(15, 23, 42, 0.025);
        box-sizing: border-box;
    }


        /* =========================================================
       FORM TITLE
       ========================================================= */

        .edit-task-panel h4 {
            margin: 0 0 8px;
            font-size: 18px;
            font-weight: 700;
            color: var(--text-main);
        }

        .edit-task-panel hr {
            margin: 0 0 26px;
            border: 0;
            border-top: 1px solid var(--border-color);
        }


    /* =========================================================
       VALIDATION SUMMARY
       ========================================================= */

    .validation-summary {
        margin-bottom: 20px;
    }

    .text-danger {
        color: #dc2626 !important;
        font-size: 12px;
        margin-top: 5px;
        display: block;
    }


    /* =========================================================
       FORM GROUP
       ========================================================= */

    .form-group {
        margin-bottom: 22px;
    }

        .form-group:after {
            content: "";
            display: table;
            clear: both;
        }


    /* =========================================================
       LABELS
       ========================================================= */

    .control-label {
        display: block;
        margin-bottom: 8px;
        color: var(--text-main);
        font-size: 13px;
        font-weight: 700;
    }


    /* =========================================================
       FORM CONTROLS
       ========================================================= */

    .form-control {
        display: block;
        width: 100%;
        min-height: 44px;
        padding: 10px 13px;
        box-sizing: border-box;
        background: #ffffff;
        color: var(--text-main);
        border: 1px solid var(--border-color);
        border-radius: 10px;
        font-family: inherit;
        font-size: 13.5px;
        outline: none;
        transition: all 0.2s ease;
    }

        .form-control:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.10);
        }

        .form-control:hover {
            border-color: #cbd5e1;
        }


    /* =========================================================
       SELECT
       ========================================================= */

    select.form-control {
        cursor: pointer;
    }


    /* =========================================================
       SAVE BUTTON
       ========================================================= */

    .btn-save {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 42px;
        padding: 10px 22px;
        box-sizing: border-box;
        background: linear-gradient(135deg, #4f46e5, #6366f1);
        color: white !important;
        border: 1px solid transparent;
        border-radius: 10px;
        text-decoration: none !important;
        font-family: inherit;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        box-shadow: 0 4px 12px rgba(79, 70, 229, 0.16);
        transition: all 0.2s ease;
    }

        .btn-save:hover {
            background: linear-gradient(135deg, #4338ca, #4f46e5);
            color: white !important;
            transform: translateY(-2px);
            box-shadow: 0 7px 16px rgba(79, 70, 229, 0.22);
        }


    /* =========================================================
       BACK LINK
       ========================================================= */

    .back-link {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 42px;
        margin-top: 22px;
        padding: 10px 18px;
        box-sizing: border-box;
        background: #475569;
        color: white !important;
        border-radius: 10px;
        text-decoration: none !important;
        font-size: 13px;
        font-weight: 600;
        box-shadow: 0 4px 10px rgba(15, 23, 42, 0.08);
        transition: all 0.2s ease;
    }

        .back-link:hover {
            background: #334155;
            color: white !important;
            text-decoration: none !important;
            transform: translateY(-2px);
            box-shadow: 0 6px 14px rgba(15, 23, 42, 0.12);
        }


    /* =========================================================
       LARGE TABLET
       ========================================================= */

    @@media (max-width: 1200px) {

        .edit-task-page {
            padding-left: 30px;
            padding-right: 30px;
        }
    }


    /* =========================================================
       TABLET
       ========================================================= */

    @@media (max-width: 900px) {

        .edit-task-page {
            padding: 30px 24px 40px;
        }

        .edit-task-header {
            padding: 25px;
        }

        .edit-task-panel {
            padding: 25px;
        }
    }


    /* =========================================================
       MOBILE
       ========================================================= */

    @@media (max-width: 768px) {

        .edit-task-page {
            padding: 95px 18px 30px;
        }

        .edit-task-header {
            padding: 22px;
            border-radius: 15px;
            margin-bottom: 22px;
        }

            .edit-task-header h2 {
                font-size: 20px;
            }

            .edit-task-header p {
                font-size: 13px;
            }

        .edit-task-panel {
            padding: 20px;
            border-radius: 15px;
        }

        .btn-save,
        .back-link {
            width: 100%;
        }
    }


    /* =========================================================
       SMALL PHONE
       ========================================================= */

    @@media (max-width: 480px) {

        .edit-task-page {
            padding-left: 14px;
            padding-right: 14px;
        }

        .edit-task-header {
            padding: 19px;
        }

            .edit-task-header h2 {
                font-size: 18px;
            }

            .edit-task-header p {
                font-size: 12.5px;
            }

        .edit-task-panel {
            padding: 16px;
        }

        .form-control {
            min-height: 42px;
            font-size: 13px;
        }

        .btn-save,
        .back-link {
            font-size: 12px;
        }
    }
</style>


<!-- =========================================================
     EDIT CLEANING TASK PAGE
     ========================================================= -->

<div class="edit-task-page">


    <!-- =====================================================
         HEADER
         ===================================================== -->

    <div class="edit-task-header">

        <h2>
            Edit Cleaning Task
        </h2>

        <p>
            Update the cleaning assignment, area, status, and task date.
        </p>

    </div>


    <!-- =====================================================
         MAIN PANEL
         ===================================================== -->

    <div class="edit-task-panel">

        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()

            @Html.ValidationSummary(
                true,
                "",
                new { @class = "text-danger validation-summary" })

            @Html.HiddenFor(model => model.TaskID)


            <h4>
                Cleaning Task Details
            </h4>

            <hr />


            <!-- =================================================
                 CLEANER
                 ================================================= -->

            <div class="form-group">

                @Html.LabelFor(
                    model => model.CleanerID,
                    "Assign To Cleaner",
                    new { @class = "control-label" })

                @Html.DropDownList(
                    "CleanerID",
                    null,
                    "-- Select Cleaner --",
                    new { @class = "form-control" })

                @Html.ValidationMessageFor(
                    model => model.CleanerID,
                    "",
                    new { @class = "text-danger" })

            </div>


            <!-- =================================================
                 AREA
                 ================================================= -->

            <div class="form-group">

                @Html.LabelFor(
                    model => model.Area,
                    new { @class = "control-label" })

                @Html.EditorFor(
                    model => model.Area,
                    new
                    {
                        htmlAttributes = new
                        {
                            @class = "form-control"
                        }
                    })

                @Html.ValidationMessageFor(
                    model => model.Area,
                    "",
                    new { @class = "text-danger" })

            </div>


            <!-- =================================================
                 STATUS
                 ================================================= -->

            <div class="form-group">

                @Html.LabelFor(
                    model => model.Status,
                    new { @class = "control-label" })

                @Html.EditorFor(
                    model => model.Status,
                    new
                    {
                        htmlAttributes = new
                        {
                            @class = "form-control"
                        }
                    })

                @Html.ValidationMessageFor(
                    model => model.Status,
                    "",
                    new { @class = "text-danger" })

            </div>


            <!-- =================================================
                 TASK DATE
                 ================================================= -->

            <div class="form-group">

                @Html.LabelFor(
                    model => model.TaskDate,
                    new { @class = "control-label" })

                @Html.EditorFor(
                    model => model.TaskDate,
                    new
                    {
                        htmlAttributes = new
                        {
                            @class = "form-control"
                        }
                    })

                @Html.ValidationMessageFor(
                    model => model.TaskDate,
                    "",
                    new { @class = "text-danger" })

            </div>


            <!-- =================================================
                 SAVE
                 ================================================= -->

            <div class="form-group">

                <input type="submit"
                       value="Save"
                       class="btn-save" />

            </div>

        }

    </div>


    <!-- =====================================================
         BACK TO LIST
         ===================================================== -->

    <div>

        @Html.ActionLink(
            "Back to List",
            "Index",
            null,
            new { @class = "back-link" })

    </div>

</div>

