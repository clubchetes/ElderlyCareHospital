                    </div>

                </div>


                <!-- =================================================
                     DATE AND TIME
                     ================================================= -->

        <div class="form-group row">

            @Html.LabelFor(
                model => model.DateRecorded,
                "Date & Time Recorded",
                new
                {
                    @class = "control-label col-md-3"
                })

            <!-- =========================================
    DATE RECORDED
    DISPLAY ONLY - NOT EDITABLE
    ========================================= -->

            <div class="form-group row align-items-center">

                @Html.LabelFor(
                    model => model.DateRecorded,
                    htmlAttributes: new
                    {
                        @class = "control-label col-md-3"
                    })

                <div class="col-md-9">

                    @Html.TextBoxFor(
                        model => model.DateRecorded,
                        "{0:dd MMMM yyyy, HH:mm}",
                        new
                        {
                            @class = "form-control",
                            @readonly = "readonly",
                            tabindex = "-1",
                            autocomplete = "off"
                        })

                    @Html.ValidationMessageFor(
                        model => model.DateRecorded,
                        "",
                        new
                        {
                            @class = "text-danger"
                        })

                </div>

           

            <div class="datetime-info">
                The current date and time are automatically selected.
                Future dates and times are not allowed.
            </div>

            <div id="currentTimeDisplay"
                 class="current-time-display">
                Current time: loading...
            </div>

            <div id="DateRecordedError"
                 class="custom-validation">
            </div>

            @Html.ValidationMessageFor(
                model => model.DateRecorded,
                "",
                new
                {
                    @class = "text-danger"
                })

        </div>

                </div>


                <!-- =================================================
                     SUBMIT
                     ================================================= -->

                <div class="submit-row">

                    <button type="submit"
                            id="saveVitalButton"
                            class="btn btn-submit">

                        Save Vital Signs

                    </button>

                </div>

            }


            <!-- =================================================
                 INFORMATION NOTE
                 ================================================= -->

            <div class="info-note">

                <span>
                    Ensure all readings are measured correctly before
                    saving. Temperature should normally be recorded in
                    degrees Celsius, blood pressure in systolic/diastolic
                    format, pulse in beats per minute, oxygen saturation
                    as a percentage, glucose in mmol/L, and weight in kg.
                    The recorded date and time are automatically captured
                    from the current local time.
                </span>

            </div>


        </section>


        <!-- =================================================
             BACK
             ================================================= -->

        <div class="back-wrapper">

            @Html.ActionLink(
                "Back to Vital Signs",
                "Index",
                "VitalSigns",
