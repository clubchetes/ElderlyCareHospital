                new
                {
                    @class = "back-link"
                })

        </div>


    </div>
    

</div>

@section Scripts {

    ```
    <!-- jQuery -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <!-- jQuery Validation -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>

    <script>

        /* =========================================================
           CURRENT DATE/TIME
           ========================================================= */

        function getCurrentDateTimeLocal() {

            var now = new Date();

            var year = now.getFullYear();

            var month = String(now.getMonth() + 1).padStart(2, '0');

            var day = String(now.getDate()).padStart(2, '0');

            var hours = String(now.getHours()).padStart(2, '0');

            var minutes = String(now.getMinutes()).padStart(2, '0');

            return year + "-" +
                month + "-" +
                day + "T" +
                hours + ":" +
                minutes;
        }


        /* =========================================================
           SET CURRENT DATE/TIME AUTOMATICALLY
           ========================================================= */

        function setCurrentDateTime() {

            var dateInput = document.getElementById("DateRecorded");

            if (!dateInput) {
                return;
            }

            /*
             * Always use current local date/time when creating
             * a new vital sign.
             */
            dateInput.value = getCurrentDateTimeLocal();

            /*
             * Prevent future date/time selection.
             */
            dateInput.max = getCurrentDateTimeLocal();

        }


        /* =========================================================
           LIVE CLOCK
           ========================================================= */

        function updateCurrentTimeDisplay() {

            var display = document.getElementById(
                "currentTimeDisplay"
            );

            if (!display) {
                return;
            }

            var now = new Date();

            var dateText = now.toLocaleDateString(
                undefined,
                {
                    year: "numeric",
                    month: "long",
                    day: "numeric"
                }
            );

            var timeText = now.toLocaleTimeString(
                undefined,
                {
                    hour: "2-digit",
                    minute: "2-digit",
                    second: "2-digit"
                }
            );

            display.innerHTML =
                "Current time: " +
                dateText +
                " • " +
                timeText;

        }


        /* =========================================================
           VALIDATION HELPER
           ========================================================= */

        function showError(inputId, errorId, message) {

            var input = document.getElementById(inputId);

            var error = document.getElementById(errorId);

            if (input) {
                input.classList.remove("field-valid");
                input.classList.add("field-error");
            }

            if (error) {
                error.textContent = message;
                error.classList.add("show");
            }

            return false;
        }


        /* =========================================================
           VALIDATION SUCCESS
           ========================================================= */

        function showValid(inputId, errorId) {

            var input = document.getElementById(inputId);

            var error = document.getElementById(errorId);

            if (input) {
                input.classList.remove("field-error");

                if (input.value.trim() !== "") {
                    input.classList.add("field-valid");
                }
            }

            if (error) {
                error.textContent = "";
                error.classList.remove("show");
            }

            return true;
        }


        /* =========================================================
           NUMERIC VALIDATION
           ========================================================= */

        function getNumericValue(id) {

            var element = document.getElementById(id);

            if (!element) {
                return NaN;
            }

            var value = element.value.trim();

            if (value === "") {
                return NaN;
            }

            return Number(value);
        }


        /* =========================================================
           PATIENT VALIDATION
           ========================================================= */

        function validatePatient() {

            var value =
                document.getElementById("PatientID").value;

            if (!value || value === "0") {

                return showError(
                    "PatientID",
                    "PatientIDError",
                    "Please select a patient."
                );

            }

            return showValid(
                "PatientID",
                "PatientIDError"
            );
        }


        /* =========================================================
           TEMPERATURE VALIDATION
           ========================================================= */

        function validateTemperature() {

            var element =
                document.getElementById("Temperature");

            var value =
                element.value.trim();

            if (value === "") {

                return showError(
                    "Temperature",
                    "TemperatureError",
                    "Temperature is required."
                );

            }

            if (!/^[0-9]+([.,][0-9]+)?$/.test(value)) {

                return showError(
                    "Temperature",
                    "TemperatureError",
                    "Enter a valid temperature, for example 36.8."
                );

            }

            var number =
                parseFloat(value.replace(",", "."));

            if (isNaN(number)) {

                return showError(
                    "Temperature",
                    "TemperatureError",
                    "Temperature must be a valid number."
                );

            }

            if (number < 30 || number > 45) {

                return showError(
                    "Temperature",
                    "TemperatureError",
                    "Temperature must be between 30°C and 45°C."
                );

            }

            return showValid(
                "Temperature",
                "TemperatureError"
            );
        }


        /* =========================================================
           BLOOD PRESSURE VALIDATION
           ========================================================= */

        function validateBloodPressure() {

            var value =
                document.getElementById("BloodPressure")
                    .value
                    .trim();

            if (value === "") {

                return showError(
                    "BloodPressure",
                    "BloodPressureError",
                    "Blood pressure is required."
                );

            }

            var match =
                value.match(/^(\d{2,3})\s*\/\s*(\d{2,3})$/);

            if (!match) {

                return showError(
                    "BloodPressure",
                    "BloodPressureError",
                    "Enter blood pressure in the format 120/80."
                );

            }

            var systolic =
                parseInt(match[1]);

            var diastolic =
                parseInt(match[2]);

            if (systolic < 60 || systolic > 250) {

                return showError(
                    "BloodPressure",
                    "BloodPressureError",
                    "Systolic pressure must be between 60 and 250 mmHg."
                );

            }

            if (diastolic < 30 || diastolic > 150) {

                return showError(
                    "BloodPressure",
                    "BloodPressureError",
                    "Diastolic pressure must be between 30 and 150 mmHg."
                );

            }

            if (systolic <= diastolic) {

                return showError(
                    "BloodPressure",
                    "BloodPressureError",
                    "Systolic pressure must be greater than diastolic pressure."
                );

            }

            return showValid(
                "BloodPressure",
                "BloodPressureError"
            );
        }


        /* =========================================================
           PULSE VALIDATION
           ========================================================= */

        function validatePulse() {

            var value =
                document.getElementById("PulseRate")
                    .value
                    .trim();

            if (value === "") {

                return showError(
                    "PulseRate",
                    "PulseRateError",
                    "Pulse rate is required."
                );

            }

            if (!/^\d+$/.test(value)) {

                return showError(
                    "PulseRate",
                    "PulseRateError",
                    "Pulse rate must contain whole numbers only."
                );

            }

            var pulse =
                parseInt(value);

            if (pulse < 20 || pulse > 250) {

                return showError(
                    "PulseRate",
                    "PulseRateError",
                    "Pulse rate must be between 20 and 250 bpm."
                );

            }

            return showValid(
                "PulseRate",
                "PulseRateError"
            );
        }


        /* =========================================================
           OXYGEN VALIDATION
           ========================================================= */

        function validateOxygen() {

            var value =
                document.getElementById("OxygenLevel")
                    .value
                    .trim();

            if (value === "") {

                return showError(
                    "OxygenLevel",
                    "OxygenLevelError",
                    "Oxygen saturation is required."
                );

            }

            if (!/^[0-9]+([.,][0-9]+)?$/.test(value)) {

                return showError(
                    "OxygenLevel",
                    "OxygenLevelError",
                    "Enter a valid oxygen saturation percentage."
                );

            }

            var oxygen =
                parseFloat(value.replace(",", "."));

            if (oxygen < 50 || oxygen > 100) {

                return showError(
                    "OxygenLevel",
                    "OxygenLevelError",
                    "Oxygen saturation must be between 50% and 100%."
                );

            }

            return showValid(
                "OxygenLevel",
                "OxygenLevelError"
            );
        }


        /* =========================================================
           SUGAR VALIDATION
           ========================================================= */

        function validateSugar() {

            var value =
                document.getElementById("SugarLevel")
                    .value
                    .trim();

            if (value === "") {

                return showError(
                    "SugarLevel",
                    "SugarLevelError",
                    "Sugar level is required."
                );

            }

            if (!/^[0-9]+([.,][0-9]+)?$/.test(value)) {

                return showError(
                    "SugarLevel",
                    "SugarLevelError",
                    "Enter a valid glucose level, for example 5.6."
                );

            }

            var sugar =
                parseFloat(value.replace(",", "."));

            if (sugar < 1 || sugar > 40) {

                return showError(
                    "SugarLevel",
                    "SugarLevelError",
                    "Sugar level must be between 1 and 40 mmol/L."
                );

            }

            return showValid(
                "SugarLevel",
                "SugarLevelError"
            );
        }


        /* =========================================================
           WEIGHT VALIDATION
           ========================================================= */

        function validateWeight() {

            var value =
                document.getElementById("Weight")
                    .value
                    .trim();

            if (value === "") {

                return showError(
                    "Weight",
                    "WeightError",
                    "Weight is required."
                );

            }

            if (!/^[0-9]+([.,][0-9]+)?$/.test(value)) {

                return showError(
                    "Weight",
                    "WeightError",
                    "Enter a valid weight, for example 72."
                );

            }

            var weight =
                parseFloat(value.replace(",", "."));

            if (weight < 1 || weight > 500) {

                return showError(
                    "Weight",
                    "WeightError",
                    "Weight must be between 1 kg and 500 kg."
                );

            }

            return showValid(
                "Weight",
                "WeightError"
            );
        }


        /* =========================================================
           DATE/TIME VALIDATION
           ========================================================= */

        function validateDateRecorded() {

            var input =
                document.getElementById("DateRecorded");

            var value =
                input.value;

            if (!value) {

                return showError(
                    "DateRecorded",
                    "DateRecordedError",
                    "Date and time are required."
                );

            }

            var selectedDate =
                new Date(value);

            var now =
                new Date();

            if (isNaN(selectedDate.getTime())) {

                return showError(
                    "DateRecorded",
                    "DateRecordedError",
                    "Please enter a valid date and time."
                );

            }

            /*
             * Allow a tiny difference because the browser time
             * continues moving while the user is filling in the form.
             */
            if (selectedDate.getTime() > now.getTime() + 60000) {

                return showError(
                    "DateRecorded",
                    "DateRecordedError",
                    "The recorded date and time cannot be in the future."
                );

            }

            return showValid(
                "DateRecorded",
                "DateRecordedError"
            );
        }


        /* =========================================================
           VALIDATE EVERYTHING
           ========================================================= */

        function validateAllFields() {

            var valid = true;

            if (!validatePatient()) {
                valid = false;
            }

            if (!validateTemperature()) {
                valid = false;
            }

            if (!validateBloodPressure()) {
                valid = false;
            }

            if (!validatePulse()) {
                valid = false;
            }

            if (!validateOxygen()) {
                valid = false;
            }

            if (!validateSugar()) {
                valid = false;
            }

            if (!validateWeight()) {
                valid = false;
            }

            if (!validateDateRecorded()) {
                valid = false;
            }

            return valid;
        }


        /* =========================================================
           INPUT CLEANING
           ========================================================= */

        function allowNumericInput(input) {

            input.addEventListener("input", function () {

                var value = this.value;

                /*
                 * Allows numbers and one decimal separator.
                 */
                value = value.replace(/[^0-9.,]/g, "");

                var firstSeparator =
                    value.search(/[.,]/);

                if (firstSeparator !== -1) {

                    var before =
                        value.substring(
                            0,
                            firstSeparator + 1
                        );

                    var after =
                        value.substring(
                            firstSeparator + 1
                        )
                            .replace(/[.,]/g, "");

                    value =
                        before +
                        after;
                }

                this.value = value;

            });

        }


        /* =========================================================
           BLOOD PRESSURE INPUT
           ========================================================= */

        function setupBloodPressureInput() {

            var input =
                document.getElementById("BloodPressure");

            if (!input) {
                return;
            }

            input.addEventListener(
                "input",
                function () {

                    this.value =
                        this.value.replace(
                            /[^0-9\/\s]/g,
                            ""
                        );

                }
            );

        }


        /* =========================================================
           LIVE FIELD VALIDATION
           ========================================================= */

        function setupLiveValidation() {

            $("#PatientID").on(
                "change",
                validatePatient
            );

            $("#Temperature").on(
                "blur",
                validateTemperature
            );

            $("#BloodPressure").on(
                "blur",
                validateBloodPressure
            );

            $("#PulseRate").on(
                "blur",
                validatePulse
            );

            $("#OxygenLevel").on(
                "blur",
                validateOxygen
            );

            $("#SugarLevel").on(
                "blur",
                validateSugar
            );

            $("#Weight").on(
                "blur",
                validateWeight
            );

            $("#DateRecorded").on(
                "change",
                validateDateRecorded
            );

        }


        /* =========================================================
           FORM SUBMISSION
           ========================================================= */

        $("#vitalSignsForm").on(
            "submit",
            function (event) {

                /*
                 * Make sure date/time is present.
                 */
                if (!$("#DateRecorded").val()) {

                    setCurrentDateTime();

                }

                /*
                 * Validate all fields before allowing
                 * the form to reach the controller.
                 */
                var valid =
                    validateAllFields();

                if (!valid) {

                    event.preventDefault();

                    /*
                     * Scroll to the first error.
                     */
                    var firstError =
                        document.querySelector(
                            ".field-error"
                        );

                    if (firstError) {

                        firstError.scrollIntoView({
                            behavior: "smooth",
                            block: "center"
                        });

                        firstError.focus();
                    }

                    return false;
                }

                /*
                 * Prevent double-click submissions.
                 */
                $("#saveVitalButton")
                    .prop("disabled", true)
                    .text("Saving...");

                return true;

            }
        );


        /* =========================================================
           INITIALISE PAGE
           ========================================================= */

        $(document).ready(function () {

            /*
             * Set current date/time immediately.
             */
            setCurrentDateTime();

            /*
             * Display live current time.
             */
            updateCurrentTimeDisplay();

            /*
             * Update visible clock every second.
             */
            setInterval(
                updateCurrentTimeDisplay,
                1000
            );

            /*
             * Keep the datetime maximum current.
             */
            setInterval(
                function () {

                    var input =
                        document.getElementById(
                            "DateRecorded"
                        );

                    if (input) {

                        input.max =
                            getCurrentDateTimeLocal();

                    }

                },
                1000
            );

            /*
             * Numeric fields.
             */
            allowNumericInput(
                document.getElementById("Temperature")
            );

            allowNumericInput(
                document.getElementById("OxygenLevel")
            );

            allowNumericInput(
                document.getElementById("SugarLevel")
            );

            allowNumericInput(
                document.getElementById("Weight")
            );

            /*
             * Pulse only accepts whole numbers.
             */
            var pulse =
                document.getElementById("PulseRate");

            if (pulse) {

                pulse.addEventListener(
                    "input",
                    function () {

                        this.value =
                            this.value.replace(
                                /\D/g,
                                ""
                            );

                    }
                );

            }

            /*
             * Blood pressure.
             */
            setupBloodPressureInput();

            /*
             * Live validation.
             */
            setupLiveValidation();

        });

    </script>
  

}
