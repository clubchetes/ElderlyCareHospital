@model IEnumerable<ElderlyCareHospital.Models.VitalSign>

@{
    ViewBag.Title = "Vital Signs Monitoring";
}

<style>

    /* =========================================================
       ELDERLYCARE HOSPITAL
       VITAL SIGNS MONITORING
       MATCHED TO NURSE DASHBOARD STYLE
       ========================================================= */

    :root {
        --app-bg: #f5f8f6;
        --surface: #ffffff;
        --surface-soft: #f8fbf9;
        --text-main: #23352f;
        --text-muted: #687b74;
        --text-light: #8b9b95;
        /* Clinical teal identity */
        --primary: #2f6f73;
        --primary-dark: #25575a;
        --primary-light: #eaf5f5;
        --secondary: #5f9699;
        --soft-teal: #eef7f7;
        --success: #4f9277;
        --success-soft: #edf8f2;
        --danger: #c75d68;
        --danger-soft: #fff1f3;
        --warning: #c58b4d;
        --warning-soft: #fff6e9;
        --border: #dce7e1;
        --border-soft: #e9efec;
        --shadow: 0 12px 35px rgba(35, 53, 47, .07);
        --shadow-hover: 0 18px 42px rgba(35, 53, 47, .13);
        --radius-lg: 22px;
        --radius-md: 17px;
        --radius-sm: 12px;
    }


    /* =========================================================
       RESET
       ========================================================= */

    html,
    body {
        margin: 0;
        padding: 0;
        min-height: 100%;
    }

    *,
    *::before,
    *::after {
        box-sizing: border-box;
    }


    /* =========================================================
       BODY
       ========================================================= */

    body {
        background: radial-gradient( circle at 8% 8%, rgba(47, 111, 115, .045), transparent 27% ), radial-gradient( circle at 92% 90%, rgba(79, 146, 119, .04), transparent 25% ), var(--app-bg);
        font-family: 'Inter', 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        color: var(--text-main);
        overflow-x: hidden;
    }


    /* =========================================================
       BACKGROUND DECORATION
       ========================================================= */

    .vitals-page {
        position: relative;
        min-height: 100vh;
        padding: 40px 20px 45px;
    }

    .vitals-bg-shape {
        position: fixed;
        border-radius: 50%;
        pointer-events: none;
        z-index: 0;
        filter: none !important;
        opacity: 1;
    }

        .vitals-bg-shape.shape-one {
            width: 340px;
            height: 340px;
            top: -130px;
            left: -100px;
            background: rgba(47, 111, 115, .025);
        }

        .vitals-bg-shape.shape-two {
            width: 280px;
            height: 280px;
            right: -90px;
            bottom: 4%;
            background: rgba(79, 146, 119, .025);
        }


    /* =========================================================
       MAIN CONTENT
       ========================================================= */

    .vitals-container {
        position: relative;
        z-index: 1;
        width: 100%;
        max-width: 1450px;
        margin: 0 auto;
    }


    /* =========================================================
       HERO HEADER
       ========================================================= */

    .vitals-header {
        position: relative;
        overflow: hidden;
        padding: 34px 38px;
        margin-bottom: 25px;
        border-radius: 24px;
        color: #ffffff;
        background: linear-gradient( 135deg, #285f63 0%, #2f6f73 50%, #5f9699 100% );
        box-shadow: 0 18px 42px rgba(47, 111, 115, .16);
    }

        .vitals-header::before {
            content: "";
            position: absolute;
            width: 260px;
            height: 260px;
            right: -70px;
            top: -130px;
            border-radius: 50%;
            border: 35px solid rgba(255, 255, 255, .07);
        }

        .vitals-header::after {
            content: "";
            position: absolute;
            width: 180px;
            height: 180px;
            right: 110px;
            bottom: -120px;
            border-radius: 50%;
            background: rgba(255, 255, 255, .05);
        }


    /* =========================================================
       HERO CONTENT
       ========================================================= */

    .vitals-header-content {
        position: relative;
        z-index: 2;
        max-width: 1000px;
    }

    .vitals-header-label {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 13px;
        padding: 7px 12px;
        border-radius: 999px;
        background: rgba(255, 255, 255, .13);
        border: 1px solid rgba(255, 255, 255, .15);
        font-size: 11px;
        font-weight: 700;
        letter-spacing: .7px;
        text-transform: uppercase;
    }

    .vitals-header-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: #b7d8d9;
        box-shadow: 0 0 0 5px rgba(183, 216, 217, .10);
    }

    .vitals-header h2 {
        margin: 0;
        font-size: 30px;
        line-height: 1.2;
        font-weight: 800;
        letter-spacing: -.7px;
    }

    .vitals-header p {
        margin: 12px 0 0;
        max-width: 900px;
        color: rgba(255, 255, 255, .84);
        font-size: 14px;
        line-height: 1.7;
    }


    /* =========================================================
       LIVE STATUS
       ========================================================= */

    .live-sync {
        position: absolute;
        right: 32px;
        top: 32px;
        z-index: 5;
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 8px 13px;
        border-radius: 999px;
        color: #397461;
        background: rgba(255, 255, 255, .94);
        border: 1px solid rgba(255, 255, 255, .70);
        font-size: 11px;
        font-weight: 700;
        white-space: nowrap;
        box-shadow: 0 8px 20px rgba(25, 65, 67, .12);
    }

        .live-sync::before {
            content: "";
            width: 7px;
            height: 7px;
            flex-shrink: 0;
            border-radius: 50%;
            background: var(--success);
            box-shadow: 0 0 0 4px rgba(79, 146, 119, .10);
            animation: vitalPulse 1.8s infinite;
        }

    @@keyframes vitalPulse {

        0% {
            box-shadow: 0 0 0 0 rgba(79, 146, 119, .25);
        }

        70% {
            box-shadow: 0 0 0 6px rgba(79, 146, 119, 0);
        }

        100% {
            box-shadow: 0 0 0 0 rgba(79, 146, 119, 0);
        }
    }


    /* =========================================================
       TOOLBAR
       ========================================================= */

    .toolbar {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        margin-bottom: 18px;
    }

    .btn-create {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 11px 18px;
        border-radius: 11px;
        background: #ffffff;
        border: 1px solid #dce5e0;
        color: var(--primary) !important;
        text-decoration: none;
        font-size: 12px;
        font-weight: 750;
        box-shadow: 0 6px 18px rgba(35, 53, 47, .055);
        transition: color .2s ease, border-color .2s ease, background .2s ease, transform .2s ease, box-shadow .2s ease;
    }

        .btn-create::before {
            content: "+";
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 22px;
            height: 22px;
            border-radius: 7px;
            color: #ffffff;
            background: linear-gradient( 135deg, #2f6f73, #5f9699 );
            font-size: 15px;
            font-weight: 700;
        }

        .btn-create:hover {
            background: #f8fbfa;
            border-color: #c8dbd2;
            color: var(--primary-dark) !important;
            text-decoration: none;
            transform: translateY(-2px);
            box-shadow: 0 10px 25px rgba(35, 53, 47, .10);
        }


    /* =========================================================
       MAIN DATA PANEL
       ========================================================= */

    .vitals-panel {
        position: relative;
        width: 100%;
        padding: 25px;
        border: 1px solid var(--border);
        border-radius: var(--radius-lg);
        background: rgba(255, 255, 255, .97);
        box-shadow: var(--shadow);
        overflow: hidden;
    }

        .vitals-panel::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: linear-gradient( 90deg, #2f6f73, #5f9699, #7ca5a6 );
        }


    /* =========================================================
       PANEL HEADER
       ========================================================= */

    .vitals-panel-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        margin-bottom: 20px;
        padding-bottom: 17px;
        border-bottom: 1px solid #e4ece8;
    }

    .panel-title-area {
        display: flex;
        align-items: center;
        gap: 12px;
        min-width: 0;
    }

    .panel-title-icon {
        width: 42px;
        height: 42px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 13px;
        color: #ffffff;
        background: linear-gradient( 135deg, #2f6f73, #5f9699 );
        font-size: 17px;
        font-weight: 800;
        box-shadow: 0 8px 18px rgba(47, 111, 115, .20);
    }

    .panel-title-text h3 {
        margin: 0;
        color: var(--text-main);
        font-size: 18px;
        font-weight: 800;
        letter-spacing: -.25px;
    }

    .panel-title-text p {
        margin: 4px 0 0;
        color: var(--text-muted);
        font-size: 12px;
    }


    /* =========================================================
       RECORD COUNT / STATUS
       ========================================================= */

    .record-status {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 7px 12px;
        flex-shrink: 0;
        border-radius: 999px;
        color: #397461;
        background: var(--success-soft);
        border: 1px solid #cee9df;
        font-size: 11px;
        font-weight: 700;
        white-space: nowrap;
    }

        .record-status::before {
            content: "";
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: var(--success);
        }


    /* =========================================================
       TABLE WRAPPER
       ========================================================= */

    .table-responsive {
        width: 100%;
        border: 1px solid var(--border-soft);
        border-radius: 16px;
        overflow-x: auto;
        overflow-y: hidden;
        background: #ffffff;
    }


    /* =========================================================
       TABLE
       ========================================================= */

    .table {
        width: 100%;
        min-width: 1050px;
        margin-bottom: 0;
        border-collapse: separate;
        border-spacing: 0;
    }


        /* =========================================================
       TABLE HEADER
       ========================================================= */

        .table thead {
            color: #ffffff;
            background: linear-gradient( 135deg, #2f6f73, #4c8589 );
        }

            .table thead tr:first-child th:first-child {
                border-top-left-radius: 14px;
            }

            .table thead tr:first-child th:last-child {
                border-top-right-radius: 14px;
            }

        .table th {
            border: none !important;
            padding: 15px 14px;
            font-size: 11px;
            font-weight: 750;
            text-transform: uppercase;
            letter-spacing: .55px;
            text-align: center;
            vertical-align: middle;
            white-space: nowrap;
        }


        /* =========================================================
       TABLE BODY
       ========================================================= */

        .table td {
            padding: 15px 14px;
            border-top: 1px solid #e8efec !important;
            border-bottom: 0 !important;
            border-left: 0 !important;
            border-right: 0 !important;
            text-align: center;
            vertical-align: middle;
            font-size: 13px;
            color: #354840;
            background: #ffffff;
        }

        .table tbody tr {
            transition: background .2s ease, transform .2s ease;
        }

            .table tbody tr:hover td {
                background: #f7fbf9;
            }

            .table tbody tr:last-child td:first-child {
                border-bottom-left-radius: 14px;
            }

            .table tbody tr:last-child td:last-child {
                border-bottom-right-radius: 14px;
            }


    /* =========================================================
       PATIENT NAME
       ========================================================= */

    .patient-name {
        font-weight: 750;
        color: var(--primary);
        white-space: nowrap;
        text-align: left;
    }


    /* =========================================================
       VITAL METRIC BADGES
       ========================================================= */

    .metric-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 78px;
        padding: 6px 12px;
        border-radius: 999px;
        background: var(--soft-teal);
        border: 1px solid #d7e9e9;
        color: var(--primary);
        font-weight: 750;
        font-size: 11px;
        white-space: nowrap;
    }

        .metric-badge.bp {
            min-width: 96px;
        }


    /* =========================================================
       DATE
       ========================================================= */

    .date-text {
        font-weight: 650;
        color: #63766f;
        white-space: nowrap;
        font-size: 12px;
    }


    /* =========================================================
       ACTION LINKS
       ========================================================= */

    .action-links {
        white-space: nowrap;
    }

        .action-links a {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-height: 31px;
            padding: 5px 9px;
            margin: 2px;
            border: 1px solid transparent;
            border-radius: 8px;
            text-decoration: none;
            font-size: 11px;
            font-weight: 700;
            transition: background .2s ease, color .2s ease, border-color .2s ease, transform .2s ease;
        }

            .action-links a:nth-child(1) {
                color: #397461;
                background: #edf8f2;
            }

            .action-links a:nth-child(2) {
                color: var(--primary);
                background: var(--soft-teal);
            }

            .action-links a:nth-child(3) {
                color: var(--danger);
                background: var(--danger-soft);
            }

            .action-links a:hover {
                text-decoration: none;
                transform: translateY(-1px);
            }

            .action-links a:nth-child(1):hover {
                background: #dff2e8;
            }

            .action-links a:nth-child(2):hover {
                background: #dceeed;
            }

            .action-links a:nth-child(3):hover {
                background: #ffe5e8;
            }


    /* =========================================================
       FOOTER
       ========================================================= */

    .footer-row {
        display: flex;
        justify-content: flex-start;
        align-items: center;
        margin-top: 22px;
    }

    .back-link {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 10px 17px;
        background: #ffffff;
        border: 1px solid #dce5e0;
        color: #687b74 !important;
        border-radius: 11px;
        text-decoration: none;
        font-size: 12px;
        font-weight: 700;
        box-shadow: 0 6px 18px rgba(35, 53, 47, .045);
        transition: color .2s ease, border-color .2s ease, background .2s ease, transform .2s ease;
    }

        .back-link::before {
            content: "←";
            font-size: 15px;
        }

        .back-link:hover {
            background: #f8fbfa;
            color: var(--primary) !important;
            border-color: #c8dbd2;
            text-decoration: none;
            transform: translateY(-2px);
        }


    /* =========================================================
       LARGE TABLET
       ========================================================= */

    @@media (max-width: 1200px) {

        .vitals-page {
            padding-left: 30px;
            padding-right: 30px;
        }

        .vitals-header {
            padding: 30px;
        }

        .table {
            min-width: 1000px;
        }
    }


    /* =========================================================
       TABLET
       ========================================================= */

    @@media (max-width: 992px) {

        .vitals-page {
            padding: 30px 22px 40px;
        }

        .vitals-header {
            padding: 27px 25px;
        }

            .vitals-header h2 {
                font-size: 27px;
            }

            .vitals-header p {
                font-size: 13px;
            }

        .live-sync {
            position: static;
            margin-top: 18px;
        }

        .toolbar {
            justify-content: flex-start;
        }

        .vitals-panel {
            padding: 20px;
        }

        .table th,
        .table td {
            padding: 12px 10px;
            font-size: 12px;
        }

        .footer-row {
            justify-content: flex-start;
        }
    }


    /* =========================================================
       MOBILE
       ========================================================= */

    @@media (max-width: 768px) {

        .vitals-page {
            padding: 20px 16px 30px;
        }

        .vitals-header {
            padding: 25px 22px;
            border-radius: 19px;
            margin-bottom: 18px;
        }

            .vitals-header h2 {
                font-size: 23px;
            }

            .vitals-header p {
                font-size: 12px;
                line-height: 1.65;
            }

        .vitals-header-label {
            font-size: 10px;
        }

        .toolbar {
            justify-content: stretch;
            margin-bottom: 14px;
        }

        .btn-create {
            width: 100%;
        }

        .vitals-panel {
            padding: 17px;
            border-radius: 18px;
        }

        .vitals-panel-header {
            align-items: flex-start;
            flex-direction: column;
            gap: 12px;
        }

        .record-status {
            align-self: flex-start;
        }

        .panel-title-icon {
            width: 38px;
            height: 38px;
        }

        .panel-title-text h3 {
            font-size: 16px;
        }

        .panel-title-text p {
            font-size: 11px;
        }

        .table-responsive {
            border-radius: 13px;
        }

        .table {
            min-width: 950px;
        }

        .footer-row {
            margin-top: 18px;
        }

        .back-link {
            width: 100%;
        }
    }


    /* =========================================================
       SMALL PHONE
       ========================================================= */

    @@media (max-width: 480px) {

        .vitals-page {
            padding-left: 12px;
            padding-right: 12px;
        }

        .vitals-header {
            padding: 22px 18px;
        }

            .vitals-header h2 {
                font-size: 21px;
            }

            .vitals-header p {
                font-size: 11px;
            }

        .vitals-panel {
            padding: 14px;
        }

        .panel-title-area {
            align-items: flex-start;
        }

        .panel-title-icon {
            width: 36px;
            height: 36px;
            border-radius: 11px;
        }

        .panel-title-text h3 {
            font-size: 15px;
        }

        .panel-title-text p {
            font-size: 10px;
        }

        .table {
            min-width: 900px;
        }

        .metric-badge {
            min-width: 70px;
            padding: 5px 9px;
        }

            .metric-badge.bp {
                min-width: 88px;
            }

        .action-links a {
            min-height: 29px;
            padding: 4px 7px;
            font-size: 10px;
        }
    }


    /* =========================================================
       REDUCED MOTION
       ========================================================= */

    @@media (prefers-reduced-motion: reduce) {

        *,
        *::before,
        *::after {
            animation-duration: .01ms !important;
            animation-iteration-count: 1 !important;
            transition-duration: .01ms !important;
            scroll-behavior: auto !important;
        }
    }
</style>


<!-- =========================================================
     BACKGROUND
     ========================================================= -->

<div class="vitals-bg-shape shape-one"></div>
<div class="vitals-bg-shape shape-two"></div>


<!-- =========================================================
     PAGE
     ========================================================= -->

<div class="vitals-page">

    <div class="vitals-container">


        <!-- =================================================
             HERO
             ================================================= -->

        <section class="vitals-header">

            <div class="vitals-header-content">

                <div class="vitals-header-label">

                    <span class="vitals-header-dot"></span>

                    Clinical Monitoring

                </div>

                <h2>
                    Vital Signs Monitoring
                </h2>

                <p>
                    Monitor and review patient vital signs recorded by
                    nursing staff. This dashboard provides a clear overview
                    of temperature, blood pressure, pulse rate, oxygen
                    saturation, glucose level, weight, and the date each
                    observation was recorded.
                </p>

            </div>


            <span class="live-sync">
                Live Sync Active
            </span>

        </section>


        <!-- =================================================
             TOOLBAR
             ================================================= -->

        <div class="toolbar">

            @Html.ActionLink(
                "Record New Vital Sign",
                "Create",
                null,
                new { @class = "btn-create" })

        </div>


        <!-- =================================================
             VITALS PANEL
             ================================================= -->

        <section class="vitals-panel">


            <!-- =============================================
                 PANEL HEADER
                 ============================================= -->

            <div class="vitals-panel-header">

                <div class="panel-title-area">

                    <div class="panel-title-icon">
                        ♥
                    </div>

                    <div class="panel-title-text">

                        <h3>
                            Patient Vital Signs
                        </h3>

                        <p>
                            Current clinical observations recorded by
                            nursing staff
                        </p>

                    </div>

                </div>


                <span class="record-status">
                    Monitoring Active
                </span>

            </div>


            <!-- =============================================
                 TABLE
                 ============================================= -->

            <div class="table-responsive">

                <table class="table table-bordered align-middle">

                    <thead>

                        <tr>

                            <th>
                                Patient
                            </th>

                            <th>
                                Temperature
                            </th>

                            <th>
                                Blood Pressure
                            </th>

                            <th>
                                Pulse Rate
                            </th>

                            <th>
                                Oxygen Level
                            </th>

                            <th>
                                Sugar Level
                            </th>

                            <th>
                                Weight
                            </th>

                            <th>
                                Date Recorded
                            </th>

                            <th>
                                Actions
                            </th>

                        </tr>

                    </thead>


                    <tbody id="liveVitalsBody">

                        @Html.Partial(
                            "_VitalSignRows",
                            Model)

                    </tbody>

                </table>

            </div>

        </section>


        <!-- =================================================
             FOOTER
             ================================================= -->

        <div class="footer-row">

            @Html.ActionLink(
                "Back to Dashboard",
                "Dashboard",
                "Nurse",
                null,
                new { @class = "back-link" })

        </div>


    </div>

</div>


@section Scripts {

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <script>

        /* =========================================================
           LIVE VITAL SIGNS
           ========================================================= */

        function refreshVitalSigns() {

            $.ajax({

                url:
                    '@Url.Action(
                        "GetLiveVitalSigns",
                        "VitalSigns"
                    )',

                type:
                    'GET',

                success:
                    function (data) {

                        $('#liveVitalsBody')
                            .html(data);

                    }

            });

        }


        /* =========================================================
           LIVE REFRESH
           ========================================================= */

        // Polls the server every 5 seconds to automatically
        // sync updates and newly recorded vital signs.

        setInterval(
            refreshVitalSigns,
            5000
        );

    </script>

}