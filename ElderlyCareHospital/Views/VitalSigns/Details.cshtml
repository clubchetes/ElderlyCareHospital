@model ElderlyCareHospital.Models.VitalSign

@{
    ViewBag.Title = "Vital Sign Details";
}

<style>
    /* =========================================================
       ELDERLYCARE HOSPITAL - VITAL SIGN DETAILS
       Clean clinical theme - teal used as an accent
       ========================================================= */

    body {
        background: #f4f8fb;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        color: #263238;
    }

    .details-container {
        margin-top: 30px;
        margin-bottom: 40px;
    }

    /* =========================================================
       HEADER
       ========================================================= */

    .details-header {
        background: linear-gradient(135deg, #2f6f73, #4c8c91);
        color: white;
        padding: 30px 34px;
        border-radius: 22px;
        margin-bottom: 26px;
        box-shadow: 0 12px 28px rgba(47, 111, 115, 0.16);
    }

        .details-header h2 {
            margin: 0;
            font-size: 31px;
            font-weight: 700;
            letter-spacing: -0.3px;
        }

        .details-header p {
            margin: 9px 0 0;
            font-size: 15px;
            line-height: 1.6;
            opacity: 0.95;
        }

    .record-status {
        float: right;
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 7px 13px;
        border-radius: 30px;
        background: rgba(255,255,255,0.16);
        border: 1px solid rgba(255,255,255,0.18);
        font-size: 12px;
        font-weight: 600;
    }

    .status-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #b8e6c1;
        display: inline-block;
    }

    /* =========================================================
       MAIN CARD
       ========================================================= */

    .details-panel {
        background: #ffffff;
        border-radius: 22px;
        padding: 30px;
        box-shadow: 0 8px 24px rgba(0,0,0,0.07);
    }

    /* =========================================================
       PATIENT SUMMARY
       ========================================================= */

    .patient-summary {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        padding: 20px 22px;
        margin-bottom: 28px;
        background: #f8fbfc;
        border: 1px solid #e5edef;
        border-radius: 16px;
    }

    .patient-info {
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .patient-icon {
        width: 52px;
        height: 52px;
        border-radius: 14px;
        background: #eaf3f4;
        color: #2f6f73;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
    }

    .patient-label {
        font-size: 12px;
        color: #78909c;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        font-weight: 700;
        margin-bottom: 3px;
    }

    .patient-name {
        font-size: 20px;
        color: #263238;
        font-weight: 700;
    }

    .record-date {
        text-align: right;
    }

    .record-date-label {
        font-size: 12px;
        color: #78909c;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        font-weight: 700;
        margin-bottom: 4px;
    }

    .record-date-value {
        color: #455a64;
        font-weight: 600;
        font-size: 14px;
    }

    /* =========================================================
       SECTION TITLE
       ========================================================= */

    .section-heading {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 18px;
    }

    .section-heading-icon {
        width: 34px;
        height: 34px;
        border-radius: 10px;
        background: #eef6f7;
        color: #2f6f73;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
    }

    .section-heading h4 {
        margin: 0;
        font-size: 18px;
        font-weight: 700;
        color: #263238;
    }

    /* =========================================================
       VITAL CARDS
       ========================================================= */

    .vitals-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 16px;
    }

    .vital-card {
        background: #ffffff;
        border: 1px solid #e5edef;
        border-radius: 16px;
        padding: 20px;
        min-height: 125px;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .vital-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 18px rgba(0,0,0,0.06);
        }

    .vital-card-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 14px;
    }

    .vital-label {
        color: #607d8b;
        font-size: 12px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.4px;
    }

    .vital-icon {
        width: 34px;
        height: 34px;
        border-radius: 10px;
        background: #f1f6f7;
        color: #2f6f73;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 15px;
    }

    .vital-value {
        color: #263238;
        font-size: 24px;
        font-weight: 700;
        line-height: 1.2;
    }

    .vital-unit {
        color: #78909c;
        font-size: 12px;
        font-weight: 600;
        margin-left: 4px;
    }

    /* =========================================================
       DIFFERENT ACCENTS
       ========================================================= */

    .temperature .vital-icon {
        background: #fff5ec;
        color: #d97706;
    }

    .blood-pressure .vital-icon {
        background: #f4eefb;
        color: #7e57c2;
    }

    .pulse .vital-icon {
        background: #fff0f1;
        color: #c94b59;
    }

    .oxygen .vital-icon {
        background: #edf5fb;
        color: #1976a8;
    }

    .sugar .vital-icon {
        background: #fff8e8;
        color: #b7791f;
    }

    .weight .vital-icon {
        background: #eef5f0;
        color: #4f7d5b;
    }

    /* =========================================================
       ACTIONS
       ========================================================= */

    .details-actions {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        margin-top: 30px;
        padding-top: 24px;
        border-top: 1px solid #e8eef1;
    }

    .action-left,
    .action-right {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .btn-edit {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 11px 20px;
        border-radius: 11px;
        background: #2f6f73;
        border: 1px solid #2f6f73;
        color: white !important;
        text-decoration: none;
        font-weight: 600;
        transition: 0.2s ease;
    }

        .btn-edit:hover {
            background: #25575a;
            border-color: #25575a;
            text-decoration: none;
            transform: translateY(-1px);
        }

    .btn-back {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 11px 20px;
        border-radius: 11px;
        background: #455a64;
        border: 1px solid #455a64;
        color: white !important;
        text-decoration: none;
        font-weight: 600;
        transition: 0.2s ease;
    }

        .btn-back:hover {
            background: #263238;
            border-color: #263238;
            text-decoration: none;
            transform: translateY(-1px);
        }

    .action-note {
        color: #78909c;
        font-size: 13px;
    }

    /* =========================================================
       RESPONSIVE
       ========================================================= */

    @@media (max-width: 992px) {

        .vitals-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .record-status {
            float: none;
            margin-top: 12px;
        }

        .details-header h2 {
            font-size: 28px;
        }
    }

    @@media (max-width: 768px) {

        .details-container {
            margin-top: 20px;
        }

        .details-header,
        .details-panel {
            padding: 22px;
            border-radius: 18px;
        }

        .vitals-grid {
            grid-template-columns: 1fr;
        }

        .patient-summary {
            flex-direction: column;
            align-items: flex-start;
        }

        .record-date {
            text-align: left;
        }

        .details-actions {
            flex-direction: column;
            align-items: stretch;
        }

        .action-left,
        .action-right {
            width: 100%;
        }

        .btn-edit,
        .btn-back {
            width: 100%;
        }

        .action-note {
            display: none;
        }
    }
</style>


<div class="container details-container">

    <!-- =====================================================
         PAGE HEADER
         ===================================================== -->

    <div class="details-header">

        <div class="record-status">
            <span class="status-dot"></span>
            Recorded Vital Signs
        </div>

        <h2>Vital Sign Details</h2>

        <p>
            Review the complete set of vital sign observations recorded for this patient.
        </p>

    </div>


    <!-- =====================================================
         MAIN PANEL
         ===================================================== -->

    <div class="details-panel">

        <!-- PATIENT SUMMARY -->

        <div class="patient-summary">

            <div class="patient-info">

                

                <div>
                    <div class="patient-label">
                        Patient
                    </div>

                    <div class="patient-name">
                        @Html.DisplayFor(model => model.Patient.FirstName)
                    </div>
                </div>

            </div>

            <div class="record-date">

                <div class="record-date-label">
                    Date Recorded
                </div>

                <div class="record-date-value">
                    @Html.DisplayFor(model => model.DateRecorded)
                </div>

            </div>

        </div>


        <!-- VITAL SIGNS SECTION -->

        <div class="section-heading">

            <div class="section-heading-icon">
                ♥
            </div>

            <h4>Vital Sign Measurements</h4>

        </div>


        <div class="vitals-grid">

            <!-- TEMPERATURE -->

            <div class="vital-card temperature">

                <div class="vital-card-top">

                    <span class="vital-label">
                        Temperature
                    </span>

                    <div class="vital-icon">
                        🌡
                    </div>

                </div>

                <div class="vital-value">
                    @Html.DisplayFor(model => model.Temperature)
                </div>

            </div>


            <!-- BLOOD PRESSURE -->

            <div class="vital-card blood-pressure">

                <div class="vital-card-top">

                    <span class="vital-label">
                        Blood Pressure
                    </span>

                    <div class="vital-icon">
                        BP
                    </div>

                </div>

                <div class="vital-value">
                    @Html.DisplayFor(model => model.BloodPressure)
                </div>

            </div>


            <!-- PULSE -->

            <div class="vital-card pulse">

                <div class="vital-card-top">

                    <span class="vital-label">
                        Pulse Rate
                    </span>

                    <div class="vital-icon">
                        ♥
                    </div>

                </div>

                <div class="vital-value">
                    @Html.DisplayFor(model => model.PulseRate)
                </div>

            </div>


            <!-- OXYGEN -->

            <div class="vital-card oxygen">

                <div class="vital-card-top">

                    <span class="vital-label">
                        Oxygen Level
                    </span>

                    <div class="vital-icon">
                        O₂
                    </div>

                </div>

                <div class="vital-value">
                    @Html.DisplayFor(model => model.OxygenLevel)
                </div>

            </div>


            <!-- SUGAR -->

            <div class="vital-card sugar">

                <div class="vital-card-top">

                    <span class="vital-label">
                        Sugar Level
                    </span>

                    <div class="vital-icon">
                        GL
                    </div>

                </div>

                <div class="vital-value">
                    @Html.DisplayFor(model => model.SugarLevel)
                </div>

            </div>


            <!-- WEIGHT -->

            <div class="vital-card weight">

                <div class="vital-card-top">

                    <span class="vital-label">
                        Weight
                    </span>

                    <div class="vital-icon">
                        KG
                    </div>

                </div>

                <div class="vital-value">
                    @Html.DisplayFor(model => model.Weight)
                </div>

            </div>

        </div>


        <!-- ACTIONS -->

        <div class="details-actions">

            <div class="action-left">

                @Html.ActionLink(
                    "← Back to Vital Signs",
                    "Index",
                    "VitalSigns",
                    null,
                    new { @class = "btn-back" })

            </div>

            <div class="action-right">

                <span class="action-note">
                    Need to correct this record?
                </span>

                @Html.ActionLink(
                    "Edit Record",
                    "Edit",
                    new { id = Model.VitalID },
                    new { @class = "btn-edit" })

            </div>

        </div>

    </div>

</div>