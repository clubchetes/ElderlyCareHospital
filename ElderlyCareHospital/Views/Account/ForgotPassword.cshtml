@model ElderlyCareHospital.Models.ForgotPasswordViewModel
@{
    ViewBag.Title = "Forgot your password?";
}

<style>
    :root {
        --primary: #4f46e5;
        --secondary: #2f6f73;
        --card-bg: #ffffff;
    }

    body {
        /* Soft, clean gradient background matching your theme */
        background: linear-gradient(135deg, #f1f5f9 0%, #e2e8f0 100%);
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        min-height: 100vh;
        margin: 0;
    }

    .forgot-page-wrapper {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: calc(100vh - 120px);
        padding: 40px 15px;
    }

    .forgot-panel {
        width: 100%;
        max-width: 550px;
        background: var(--card-bg);
        border-radius: 20px;
        padding: 45px;
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1);
    }

        .forgot-panel h2 {
            color: #1e293b;
            font-weight: 800;
            margin-bottom: 8px;
            text-align: center;
            letter-spacing: -0.5px;
        }

        .forgot-panel h4 {
            color: #64748b;
            text-align: center;
            margin-bottom: 30px;
            font-size: 14px;
            line-height: 1.6;
        }

    .form-group {
        margin-bottom: 20px;
    }

    .control-label {
        font-weight: 600;
        color: #1e293b;
        margin-bottom: 8px;
        display: block;
        font-size: 14px;
    }

    .form-control {
        border-radius: 12px;
        padding: 12px 16px;
        border: 1px solid #e2e8f0;
        background: #f8fafc;
        min-height: 48px;
        transition: all 0.3s ease;
    }

        .form-control:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 4px rgba(79, 70, 229, 0.1);
            background: #ffffff;
        }

    .submit-row {
        text-align: center;
        margin-top: 30px;
    }

    .btn-outline-dark {
        border-radius: 12px;
        padding: 12px 25px;
        background: var(--primary);
        border: none;
        color: white;
        font-weight: 600;
        width: 100%;
        min-height: 48px;
        transition: transform 0.2s, background 0.3s;
    }

        .btn-outline-dark:hover {
            background: #4338ca;
            transform: translateY(-2px);
            color: white;
        }

    .help-text {
        margin-top: 25px;
        text-align: center;
        font-size: 13px;
        color: #64748b;
    }

        .help-text a {
            color: var(--primary);
            font-weight: 600;
            text-decoration: none;
        }

            .help-text a:hover {
                text-decoration: underline;
            }

    .info-note {
        margin-top: 30px;
        padding: 18px 20px;
        background: #f8fafc;
        border-left: 4px solid var(--primary);
        border-radius: 12px;
        color: #475569;
        font-size: 13px;
        line-height: 1.6;
        border: 1px solid #e2e8f0;
        border-left-width: 4px;
    }
</style>

<main aria-labelledby="title">
    <div class="forgot-page-wrapper">
        <div class="forgot-panel">

            <h2 id="title">Forgot Your Password?</h2>
            <h4>Enter the email address associated with your account and we will send you a secure password reset link.</h4>

            @using (Html.BeginForm("ForgotPassword", "Account", FormMethod.Post, new { role = "form" }))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary("", new { @class = "text-danger" })

                <div class="form-group">
                    @Html.LabelFor(m => m.Email, new { @class = "control-label" })
                    @Html.TextBoxFor(m => m.Email, new { @class = "form-control", placeholder = "name@hospital.co.za" })
                    @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
                </div>

                <div class="submit-row">
                    <input type="submit" value="Send Reset Link" class="btn btn-outline-dark" />
                </div>

                <div class="help-text">
                    Remembered your password? @Html.ActionLink("Back to Login page", "Login")
                </div>
            }

            <div class="info-note">
                For security reasons, password reset links are only sent to registered accounts within the Elderly Care Hospital system. If you do not receive an email within a few minutes, please check your spam or junk folder or contact the hospital system administrator for assistance.
            </div>

        </div>
    </div>
</main>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}