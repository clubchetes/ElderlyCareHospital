@model ElderlyCareHospital.Models.ResetPasswordViewModel
@{
    ViewBag.Title = "Reset password";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    :root {
        --primary: #4f46e5;
        --secondary: #2f6f73;
        --card-bg: #ffffff;
    }

    body {
        background: linear-gradient(135deg, #f1f5f9 0%, #e2e8f0 100%);
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        min-height: 100vh;
        margin: 0;
    }

    .reset-password-wrapper {
        display: flex;
        align-items: center;
        min-height: calc(100vh - 120px);
        padding: 40px 0;
    }

    .reset-password-container {
        max-width: 550px;
        width: 100%;
        margin: 0 auto;
    }

    .reset-panel {
        background: var(--card-bg);
        border-radius: 20px;
        padding: 45px;
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1);
        width: 100%;
    }

        .reset-panel h2 {
            color: #1e293b;
            font-weight: 800;
            margin-bottom: 8px;
            font-size: 24px;
        }

        .reset-panel h4 {
            color: #64748b;
            font-size: 14px;
            margin-bottom: 25px;
            font-weight: 400;
        }

    .form-control {
        border-radius: 12px;
        padding: 12px 16px;
        border: 1px solid #e2e8f0;
        background: #f8fafc;
        transition: all 0.3s ease;
    }

        .form-control:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 4px rgba(79, 70, 229, 0.1);
        }

    .form-label {
        font-weight: 600;
        color: #334155;
        font-size: 14px;
        margin-bottom: 6px;
    }

    .btn-outline-dark {
        border-radius: 12px;
        padding: 12px 25px;
        background: var(--primary);
        border: none;
        color: white;
        font-weight: 600;
        width: 100%;
        transition: transform 0.2s, background 0.3s;
    }

        .btn-outline-dark:hover {
            background: #4338ca;
            transform: translateY(-2px);
            color: white;
        }

    hr {
        border-top: 1px solid #e2e8f0;
        margin: 20px 0 25px 0;
    }

    .form-group {
        margin-bottom: 20px;
    }
</style>

<main aria-labelledby="title">
    <div class="reset-password-wrapper">
        <div class="container reset-password-container">
            <div class="reset-panel">
                <h2 id="title">@ViewBag.Title</h2>
                <h4>Enter your new password below.</h4>
                <hr />

                @using (Html.BeginForm("ResetPassword", "Account", FormMethod.Post, new { role = "form" }))
                {
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary("", new { @class = "text-danger mb-3" })
                    @Html.HiddenFor(model => model.Code)

                    <div class="form-group">
                        @Html.LabelFor(m => m.Email, new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.Email, new { @class = "form-control", placeholder = "name@example.com" })
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(m => m.Password, new { @class = "form-label" })
                        @Html.PasswordFor(m => m.Password, new { @class = "form-control", placeholder = "••••••••" })
                    </div>

                    <div class="form-group mb-4">
                        @Html.LabelFor(m => m.ConfirmPassword, new { @class = "form-label" })
                        @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control", placeholder = "••••••••" })
                    </div>

                    <div>
                        <input type="submit" class="btn btn-outline-dark" value="Reset Password" />
                    </div>
                }
            </div>
        </div>
    </div>
</main>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}