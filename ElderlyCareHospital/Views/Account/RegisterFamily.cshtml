@model ElderlyCareHospital.ViewModels.FamilyRegisterViewModel

@{
    ViewBag.Title = "Register Family Member";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    :root {
        --primary: #4f46e5;
        --secondary: #2f6f73;
        --card-bg: #ffffff;
    }

    /* Fixed body styling to prevent footer squishing */
    body {
        background: linear-gradient(135deg, #f1f5f9 0%, #e2e8f0 100%);
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        min-height: 100vh;
        margin: 0;
    }

    .elderly-register-wrapper {
        display: flex;
        align-items: center;
        min-height: calc(100vh - 120px);
        padding: 40px 0;
    }

    .elderly-register-container {
        max-width: 1000px;
        width: 100%;
        margin: 0 auto;
    }

    /* Left Panel - Information */
    .welcome-panel {
        background: linear-gradient(135deg, #4f46e5, #2f6f73);
        color: white;
        border-radius: 20px;
        padding: 45px;
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1);
        display: flex;
        flex-direction: column;
        justify-content: center;
        height: 100%;
    }

        .welcome-panel h2 {
            font-weight: 800;
            margin-bottom: 25px;
            letter-spacing: -0.5px;
        }

        .welcome-panel p {
            line-height: 1.7;
            font-size: 15px;
            opacity: 0.9;
        }

    .contact-box {
        margin-top: 40px;
        background: rgba(255,255,255,0.1);
        padding: 25px;
        border-radius: 15px;
        border: 1px solid rgba(255,255,255,0.2);
    }

        .contact-box h4 {
            margin-bottom: 15px;
            font-weight: 600;
            font-size: 16px;
        }

    /* Right Panel - Register */
    .register-panel {
        background: var(--card-bg);
        border-radius: 20px;
        padding: 45px;
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1);
        height: 100%;
    }

        .register-panel h2 {
            color: #1e293b;
            font-weight: 800;
            margin-bottom: 8px;
        }

        .register-panel h4 {
            color: #64748b;
            font-size: 14px;
            margin-bottom: 30px;
        }

    .form-control {
        border-radius: 12px;
        padding: 12px 16px;
        border: 1px solid #e2e8f0;
        background: #f8fafc;
        transition: all 0.3s ease;
    }

        .form-control:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 4px rgba(79, 70, 229, 0.1);
        }

    .btn-outline-dark {
        border-radius: 12px;
        padding: 12px 25px;
        background: var(--primary);
        border: none;
        color: white;
        font-weight: 600;
        width: 100%;
        transition: transform 0.2s, background 0.3s;
    }

        .btn-outline-dark:hover {
            background: #4338ca;
            transform: translateY(-2px);
            color: white;
        }

    .help-text {
        margin-top: 25px;
        font-size: 13px;
        color: #64748b;
        text-align: center;
    }

        .help-text a {
            color: var(--primary);
            font-weight: 600;
            text-decoration: none;
        }

    hr {
        border-top: 1px solid #e2e8f0;
        margin: 25px 0;
    }

    .form-group {
        margin-bottom: 20px;
    }

    /* Validation messages */
    .text-danger {
        display: block;
        margin-top: 6px;
        font-size: 13px;
        color: #dc2626 !important;
    }

    .validation-summary-errors {
        margin-bottom: 20px;
        padding: 12px 15px;
        border-radius: 10px;
        background-color: #fef2f2;
        border: 1px solid #fecaca;
        color: #dc2626;
    }

    .input-validation-error {
        border-color: #dc2626 !important;
        background-color: #fffafa;
    }
</style>

<main aria-labelledby="title">
    <div class="elderly-register-wrapper">
        <div class="container elderly-register-container">
            <div class="row align-items-stretch">

                <!-- LEFT PANEL -->
                <div class="col-lg-5 d-flex mb-4 mb-lg-0">
                    <div class="welcome-panel w-100">
                        <h2>Family Access Registration</h2>

                        <p>
                            Register as a family member to stay connected with your loved one.
                            Approved family members can securely access patient updates and
                            communicate with staff.
                        </p>

                        <p>
                            <strong>Supporting families through compassionate care.</strong>
                        </p>

                        <div class="contact-box">
                            <h4>Contact Details</h4>

                            <p style="margin-bottom: 5px;">
                                <small>Phone: +27 12 345 6789</small>
                            </p>

                            <p style="margin-bottom: 5px;">
                                <small>Emergency: +27 78 358 8239</small>
                            </p>

                            <p style="margin-bottom: 5px;">
                                <small>Email: support@elderlycarehospital.co.za</small>
                            </p>
                        </div>
                    </div>
                </div>

                <!-- RIGHT PANEL -->
                <div class="col-lg-7 d-flex">
                    <div class="register-panel w-100">

                        <h2 id="title">Register Family Member</h2>

                        <h4>
                            Complete the form to create your access account.
                        </h4>

                        @using (Html.BeginForm(
                            "RegisterFamily",
                            "Account",
                            FormMethod.Post,
                            new { role = "form" }))
                        {
                            @Html.AntiForgeryToken()

                            @Html.ValidationSummary(
                                true,
                                "",
                                new { @class = "text-danger" })

                            <!-- FULL NAME -->
                            <div class="form-group">
                                @Html.LabelFor(
                                    m => m.FullName,
                                    new { @class = "form-label" })

                                @Html.TextBoxFor(
                                    m => m.FullName,
                                    new
                                    {
                                        @class = "form-control",
                                        placeholder = "John Doe"
                                    })

                                @Html.ValidationMessageFor(
                                    m => m.FullName,
                                    "",
                                    new { @class = "text-danger" })
                            </div>

                            <!-- EMAIL -->
                            <div class="form-group">
                                @Html.LabelFor(
                                    m => m.Email,
                                    new { @class = "form-label" })

                                @Html.TextBoxFor(
                                    m => m.Email,
                                    new
                                    {
                                        @class = "form-control",
                                        placeholder = "name@example.com"
                                    })

                                @Html.ValidationMessageFor(
                                    m => m.Email,
                                    "",
                                    new { @class = "text-danger" })
                            </div>

                            <!-- PHONE + RELATIONSHIP -->
                            <div class="row">

                                <div class="col-md-6 form-group">
                                    @Html.LabelFor(
                                        m => m.PhoneNumber,
                                        new { @class = "form-label" })

                                    @Html.TextBoxFor(
                                        m => m.PhoneNumber,
                                        new
                                        {
                                            @class = "form-control",
                                            placeholder = "e.g. 0821234567"
                                        })

                                    @Html.ValidationMessageFor(
                                        m => m.PhoneNumber,
                                        "",
                                        new { @class = "text-danger" })
                                </div>

                                <div class="col-md-6 form-group">
                                    @Html.LabelFor(
                                        m => m.Relationship,
                                        new { @class = "form-label" })

                                    @Html.TextBoxFor(
                                        m => m.Relationship,
                                        new
                                        {
                                            @class = "form-control",
                                            placeholder = "e.g. Son"
                                        })

                                    @Html.ValidationMessageFor(
                                        m => m.Relationship,
                                        "",
                                        new { @class = "text-danger" })
                                </div>

                            </div>

                            <hr />

                            <h5>Patient Information</h5>

                            <!-- PATIENT FIRST + LAST NAME -->
                            <div class="row">

                                <div class="col-md-6 form-group">
                                    @Html.LabelFor(
                                        m => m.PatientFirstName,
                                        new { @class = "form-label" })

                                    @Html.TextBoxFor(
                                        m => m.PatientFirstName,
                                        new
                                        {
                                            @class = "form-control",
                                            placeholder = "Patient first name"
                                        })

                                    @Html.ValidationMessageFor(
                                        m => m.PatientFirstName,
                                        "",
                                        new { @class = "text-danger" })
                                </div>

                                <div class="col-md-6 form-group">
                                    @Html.LabelFor(
                                        m => m.PatientLastName,
                                        new { @class = "form-label" })

                                    @Html.TextBoxFor(
                                        m => m.PatientLastName,
                                        new
                                        {
                                            @class = "form-control",
                                            placeholder = "Patient last name"
                                        })

                                    @Html.ValidationMessageFor(
                                        m => m.PatientLastName,
                                        "",
                                        new { @class = "text-danger" })
                                </div>

                            </div>

                            <!-- DATE OF BIRTH -->
                            <div class="form-group">
                                @Html.LabelFor(
                                    m => m.PatientDateOfBirth,
                                    new { @class = "form-label" })

                                @Html.TextBoxFor(
                                    m => m.PatientDateOfBirth,
                                    "{0:yyyy-MM-dd}",
                                    new
                                    {
                                        @class = "form-control",
                                        type = "date",
                                        max = DateTime.Today.ToString("yyyy-MM-dd")
                                    })

                                @Html.ValidationMessageFor(
                                    m => m.PatientDateOfBirth,
                                    "",
                                    new { @class = "text-danger" })
                            </div>

                            <hr />

                            <!-- PASSWORD -->
                            <div class="form-group">
                                @Html.LabelFor(
                                    m => m.Password,
                                    new { @class = "form-label" })

                                @Html.PasswordFor(
                                    m => m.Password,
                                    new
                                    {
                                        @class = "form-control",
                                        placeholder = "••••••••"
                                    })

                                @Html.ValidationMessageFor(
                                    m => m.Password,
                                    "",
                                    new { @class = "text-danger" })

                                <small class="text-muted">
                                    Password must be at least 8 characters and contain
                                    an uppercase letter, lowercase letter, number and
                                    special character.
                                </small>
                            </div>

                            <!-- CONFIRM PASSWORD -->
                            <div class="form-group">
                                @Html.LabelFor(
                                    m => m.ConfirmPassword,
                                    new { @class = "form-label" })

                                @Html.PasswordFor(
                                    m => m.ConfirmPassword,
                                    new
                                    {
                                        @class = "form-control",
                                        placeholder = "••••••••"
                                    })

                                @Html.ValidationMessageFor(
                                    m => m.ConfirmPassword,
                                    "",
                                    new { @class = "text-danger" })
                            </div>

                            <!-- SUBMIT -->
                            <div class="mt-4">
                                <input type="submit"
                                       value="Register Family Member"
                                       class="btn btn-outline-dark" />
                            </div>

                            <!-- LOGIN -->
                            <div class="help-text">
                                Already have an account?
                                @Html.ActionLink(
                                    "Log in here",
                                    "Login",
                                    "Account")
                            </div>
                        }

                    </div>
                </div>

            </div>
        </div>
    </div>
</main>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}

