@{
    ViewBag.Title = "Forgot Password Confirmation";
}

<style>
    :root {
        --primary: #4f46e5;
        --secondary: #2f6f73;
        --card-bg: #ffffff;
    }

    body {
        /* Soft, clean gradient background */
        background: linear-gradient(135deg, #f1f5f9 0%, #e2e8f0 100%);
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        min-height: 100vh;
        display: flex;
        align-items: center;
    }

    .confirmation-container {
        width: 100%;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 40px 15px;
    }

    .confirmation-panel {
        width: 100%;
        max-width: 560px;
        background: var(--card-bg);
        border-radius: 20px;
        padding: 45px;
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1);
        text-align: center;
    }

        .confirmation-panel h1 {
            color: #1e293b;
            font-weight: 800;
            margin-bottom: 16px;
            font-size: 28px;
            letter-spacing: -0.5px;
        }

    .confirmation-message {
        color: #64748b;
        font-size: 15px;
        line-height: 1.7;
        margin-bottom: 30px;
    }

    .info-box {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 20px;
        color: #475569;
        font-size: 14px;
        line-height: 1.7;
        text-align: left;
    }

        .info-box strong {
            color: #1e293b;
            display: block;
            margin-bottom: 10px;
        }

    .btn-login {
        display: inline-block;
        margin-top: 30px;
        background: var(--primary);
        color: white !important;
        padding: 12px 28px;
        border-radius: 12px;
        font-weight: 600;
        text-decoration: none;
        transition: transform 0.2s, background 0.3s;
    }

        .btn-login:hover {
            background: #4338ca;
            transform: translateY(-2px);
            text-decoration: none;
            color: white !important;
        }
</style>

<main aria-labelledby="title">
    <div class="confirmation-container">
        <div class="confirmation-panel">

            <h1 id="title">Check your email</h1>

            <div class="confirmation-message">
                A password reset link has been sent to your email address. Please follow the instructions to create a new password for your Elderly Care Hospital account.
            </div>

            <div class="info-box">
                <strong>Didn’t receive the email?</strong>
                <ul style="margin: 0; padding-left: 20px;">
                    <li>Check your spam or junk folder.</li>
                    <li>Ensure you used your registered email address.</li>
                    <li>Wait a few minutes for email delivery.</li>
                    <li>Contact your hospital system administrator.</li>
                </ul>
            </div>

            @Html.ActionLink(
                "Return to Login",
                "Login",
                "Account",
                null,
                new { @class = "btn-login" })

        </div>
    </div>
</main>