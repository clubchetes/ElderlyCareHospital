@{
    ViewBag.Title = "Reset password confirmation";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    :root {
        --primary: #4f46e5;
        --secondary: #2f6f73;
        --card-bg: #ffffff;
    }

    body {
        background: linear-gradient(135deg, #f1f5f9 0%, #e2e8f0 100%);
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        min-height: 100vh;
        margin: 0;
    }

    .confirmation-wrapper {
        display: flex;
        align-items: center;
        min-height: calc(100vh - 120px);
        padding: 40px 0;
    }

    .confirmation-container {
        max-width: 550px;
        width: 100%;
        margin: 0 auto;
    }

    .confirmation-panel {
        background: var(--card-bg);
        border-radius: 20px;
        padding: 45px;
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1);
        width: 100%;
        text-align: center;
    }

    .success-icon {
        width: 64px;
        height: 64px;
        background: #dcfce7;
        color: #16a34a;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 28px;
        margin: 0 auto 20px auto;
    }

    .confirmation-panel h1 {
        color: #1e293b;
        font-weight: 800;
        margin-bottom: 12px;
        font-size: 24px;
    }

    .confirmation-panel p {
        color: #64748b;
        font-size: 15px;
        line-height: 1.6;
        margin-bottom: 30px;
    }

    .btn-login {
        border-radius: 12px;
        padding: 12px 25px;
        background: var(--primary);
        border: none;
        color: white;
        font-weight: 600;
        display: inline-block;
        text-decoration: none;
        width: 100%;
        transition: transform 0.2s, background 0.3s;
        box-shadow: 0 4px 6px -1px rgba(79, 70, 229, 0.2);
    }

        .btn-login:hover {
            background: #4338ca;
            transform: translateY(-2px);
            color: white;
            text-decoration: none;
        }
</style>

<main aria-labelledby="title">
    <div class="confirmation-wrapper">
        <div class="container confirmation-container">
            <div class="confirmation-panel">
                <div class="success-icon">
                    <i class="fa-solid fa-check"></i>
                </div>

                <h1 id="title">@ViewBag.Title</h1>

                <p>
                    Your password has been successfully reset. You can now securely log in to your account with your new credentials.
                </p>

                <div>
                    @Html.ActionLink("Click here to log in", "Login", "Account", routeValues: null, htmlAttributes: new { id = "loginLink", @class = "btn-login" })
                </div>
            </div>
        </div>
    </div>
</main>