
@model IEnumerable<Microsoft.AspNet.Identity.EntityFramework.IdentityRole>

@{
    ViewBag.Title = "Index";
}

<style>

    /* =========================================================
       ROOT / ELDERLYCARE HOSPITAL THEME
       ========================================================= */

    :root {
        --app-bg: #f8fafc;
        --surface: #ffffff;
        --surface-soft: #f8fbfd;
        --text-main: #0f172a;
        --text-muted: #64748b;
        --primary: #4f46e5;
        --primary-hover: #4338ca;
        --secondary: #0ea5e9;
        --border-color: #e2e8f0;
    }


    /* =========================================================
       PAGE
       ========================================================= */

    html,
    body {
        margin: 0;
        padding: 0;
        min-height: 100%;
    }

    body {
        background: var(--app-bg);
        font-family: 'Inter', 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        color: var(--text-main);
        overflow-x: hidden;
    }


    /* =========================================================
       PAGE WRAPPER
       ========================================================= */

    .roles-page {
        width: 100%;
        max-width: 1400px;
        margin: 0 auto;
        padding: 36px 40px 45px;
        box-sizing: border-box;
    }


    /* =========================================================
       HEADER
       ========================================================= */

    .roles-header {
        background: var(--surface);
        color: var(--text-main);
        padding: 28px 34px;
        border-radius: 18px;
        margin-bottom: 26px;
        border: 1px solid var(--border-color);
        box-shadow: 0 4px 20px rgba(15, 23, 42, 0.03);
        box-sizing: border-box;
        width: 100%;
    }

        .roles-header h2 {
            margin: 0;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 15px;
            font-weight: 700;
            font-size: 24px;
            letter-spacing: -0.3px;
            line-height: 1.3;
        }

        .roles-header p {
            margin: 8px 0 0;
            color: var(--text-muted);
            font-size: 14px;
            line-height: 1.6;
        }


    /* =========================================================
       LIVE SYNC BADGE
       ========================================================= */

    .live-sync-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        padding: 7px 12px;
        border-radius: 20px;
        background: rgba(16, 185, 129, 0.08);
        border: 1px solid rgba(16, 185, 129, 0.15);
        color: #059669;
        font-size: 11px;
        font-weight: 600;
        white-space: nowrap;
        letter-spacing: 0.2px;
        flex-shrink: 0;
    }

    .live-sync-dot {
        width: 7px;
        height: 7px;
        min-width: 7px;
        border-radius: 50%;
        background: #10b981;
        box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.10);
    }


    /* =========================================================
       MAIN PANEL
       ========================================================= */

    .roles-panel {
        background: var(--surface);
        border-radius: 18px;
        padding: 24px;
        border: 1px solid var(--border-color);
        box-shadow: 0 4px 18px rgba(15, 23, 42, 0.025);
        box-sizing: border-box;
        width: 100%;
    }


    /* =========================================================
       TABLE WRAPPER
       ========================================================= */

    .roles-table-wrapper {
        border: 1px solid var(--border-color);
        border-radius: 14px;
        overflow: hidden;
        background: #ffffff;
        width: 100%;
        box-sizing: border-box;
    }


    /* =========================================================
       TABLE
       ========================================================= */

    .table {
        width: 100%;
        margin-bottom: 0;
        border: none;
        table-layout: fixed;
    }

        .table thead {
            background: #f8fafc;
            color: var(--text-main);
        }

            .table thead tr {
                border-bottom: 1px solid var(--border-color);
            }

        .table th {
            border: none !important;
            padding: 14px 16px;
            font-weight: 700;
            font-size: 11px;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.6px;
            white-space: nowrap;
            text-align: center;
            vertical-align: middle;
        }

        .table td {
            padding: 15px 16px;
            vertical-align: middle;
            border-top: 1px solid #edf2f7 !important;
            border-bottom: none !important;
            font-size: 13.5px;
            color: var(--text-main);
            text-align: center;
        }

        .table tbody tr {
            transition: background-color 0.15s ease;
        }

            .table tbody tr:hover {
                background: #f8fbff;
            }


    /* =========================================================
       ROLE NAME
       ========================================================= */

    .role-name {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: var(--primary);
        font-weight: 700;
        background: rgba(79, 70, 229, 0.07);
        border: 1px solid rgba(79, 70, 229, 0.10);
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 12px;
        white-space: nowrap;
        max-width: 100%;
        box-sizing: border-box;
        margin: 0 auto;
    }


    /* =========================================================
       BACK LINK
       ========================================================= */

    .back-link {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 42px;
        margin-top: 22px;
        padding: 10px 18px;
        box-sizing: border-box;
        background: #475569;
        color: white !important;
        border-radius: 10px;
        text-decoration: none !important;
        font-size: 13px;
        font-weight: 600;
        box-shadow: 0 4px 10px rgba(15, 23, 42, 0.08);
        transition: all 0.2s ease;
    }

        .back-link:hover {
            background: #334155;
            color: white !important;
            text-decoration: none !important;
            transform: translateY(-2px);
            box-shadow: 0 6px 14px rgba(15, 23, 42, 0.12);
        }


    /* =========================================================
       TABLET
       ========================================================= */

    @@media (max-width: 1200px) {

        .roles-page {
            padding-left: 30px;
            padding-right: 30px;
        }
    }


    /* =========================================================
       SMALL TABLET
       ========================================================= */

    @@media (max-width: 900px) {

        .roles-page {
            padding: 30px 24px 40px;
        }

        .roles-header {
            padding: 25px;
        }

        .roles-panel {
            padding: 20px;
        }
    }


    /* =========================================================
       MOBILE
       ========================================================= */

    @@media (max-width: 768px) {

        .roles-page {
            padding: 95px 18px 30px;
        }

        .roles-header {
            padding: 22px;
            border-radius: 15px;
            margin-bottom: 22px;
        }

            .roles-header h2 {
                font-size: 20px;
                align-items: flex-start;
            }

            .roles-header p {
                font-size: 13px;
            }

        .live-sync-badge {
            font-size: 10px;
            padding: 6px 9px;
        }

        .roles-panel {
            padding: 16px;
            border-radius: 15px;
        }

        .roles-table-wrapper {
            border-radius: 12px;
        }

        .table th,
        .table td {
            padding: 12px 13px;
            font-size: 12px;
            text-align: center;
        }

        .table th {
            font-size: 10px;
        }

        .role-name {
            padding: 5px 9px;
            font-size: 10px;
        }

        .back-link {
            width: 100%;
        }
    }


    /* =========================================================
       SMALL PHONE
       ========================================================= */

    @@media (max-width: 480px) {

        .roles-page {
            padding-left: 14px;
            padding-right: 14px;
        }

        .roles-header {
            padding: 19px;
        }

            .roles-header h2 {
                font-size: 18px;
                flex-direction: column;
                align-items: flex-start;
                gap: 10px;
            }

            .roles-header p {
                font-size: 12.5px;
            }

        .roles-panel {
            padding: 13px;
        }

        .table th,
        .table td {
            padding: 11px 10px;
            text-align: center;
        }
    }
</style>


<!-- =========================================================
     ROLES PAGE
     ========================================================= -->

<div class="roles-page">


    <!-- =====================================================
         HEADER
         ===================================================== -->

    <div class="roles-header">

        <h2>

            <span>
                Roles List
            </span>

            <span class="live-sync-badge">

                <span class="live-sync-dot"></span>

                Live Sync Active

            </span>

        </h2>

        <p>
            View all security roles configured for the Elderly Care
            Hospital system.
        </p>

    </div>


    <!-- =====================================================
         ROLES PANEL
         ===================================================== -->

    <div class="roles-panel">

        <div class="roles-table-wrapper">

            <div class="table-responsive">

                <table class="table">

                    <thead>

                        <tr>

                            <th>
                                Role Name
                            </th>

                        </tr>

                    </thead>

                    <tbody id="liveRoleBody">

                        @Html.Partial(
                            "_RoleRows",
                            Model)

                    </tbody>

                </table>

            </div>

        </div>

    </div>


    <!-- =====================================================
         BACK TO DASHBOARD
         ===================================================== -->

    <p>

        @Html.ActionLink(
            "Back to Dashboard",
            "Dashboard",
            "Admin",
            null,
            new { @class = "back-link" })

    </p>

</div>


@section Scripts {

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <script>

        function refreshRoles() {

            $.ajax({

                url:
                    '@Url.Action("GetLiveRoles", "Roles")',

                type: 'GET',

                success:
                    function (data) {

                        $('#liveRoleBody')
                            .html(data);

                    }

            });

        }


        // Polls the server every 5 seconds to sync
        // role definitions live

        setInterval(
            refreshRoles,
            5000
        );

    </script>

}

