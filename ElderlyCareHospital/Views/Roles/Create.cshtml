@model ElderlyCareHospital.Models.Role

<h2>Create Role</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div>

        Role Name

        @Html.TextBoxFor(
            x => x.RoleName, new  { @class = "form-control"})

    </div>

    
    <br />

    <button class="btn btn-success">

        Save

    </button>
}