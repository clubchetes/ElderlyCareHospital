@{
    ViewBag.Title = "Dashboard";
}

@model IEnumerable<ElderlyCareHospital.Models.CleaningTask>

<style>

    /* =========================================================
       ELDERLYCARE CLEANER DASHBOARD
       VISUAL / LAYOUT FIX ONLY
       FUNCTIONALITY / ROUTES / AJAX PRESERVED
       ========================================================= */

    :root {
        --app-bg: #f8fafc;
        --surface: #ffffff;
        --surface-soft: #f8fafc;
        --text-main: #0f172a;
        --text-muted: #64748b;
        --text-light: #94a3b8;
        --primary: #4f46e5;
        --primary-dark: #4338ca;
        --primary-light: #6366f1;
        --secondary: #0ea5e9;
        --secondary-dark: #0284c7;
        --success: #10b981;
        --danger: #ef4444;
        --warning: #f59e0b;
        --border: #e2e8f0;
        --border-soft: #eef2f7;
        --shadow: 0 10px 30px rgba(15, 23, 42, 0.06);
        --shadow-hover: 0 16px 38px rgba(15, 23, 42, 0.11);
    }


    /* =========================================================
       PAGE
       ========================================================= */

    html,
    body {
        margin: 0;
        padding: 0;
        min-height: 100%;
    }

    body {
        background: radial-gradient( circle at 8% 8%, rgba(79, 70, 229, 0.045), transparent 28% ), radial-gradient( circle at 92% 88%, rgba(14, 165, 233, 0.045), transparent 25% ), var(--app-bg);
        font-family: 'Inter', 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        color: var(--text-main);
        overflow-x: hidden;
    }


    /* =========================================================
       BACKGROUND SHAPES
       ========================================================= */

    .bg-shape {
        position: fixed;
        border-radius: 50%;
        pointer-events: none;
        transition: transform 0.15s linear;
        z-index: 0;
        filter: blur(8px);
    }

    .shape1 {
        width: 340px;
        height: 340px;
        top: -115px;
        left: -105px;
        background: rgba(79, 70, 229, 0.045);
    }

    .shape2 {
        width: 280px;
        height: 280px;
        bottom: 3%;
        right: -95px;
        background: rgba(14, 165, 233, 0.04);
    }

    .shape3 {
        width: 180px;
        height: 180px;
        top: 42%;
        left: 46%;
        background: rgba(79, 70, 229, 0.018);
    }


    /* =========================================================
       DASHBOARD WRAPPER
       ========================================================= */

    .dashboard-wrapper {
        position: relative;
        z-index: 1;
        width: 100%;
        min-height: 100vh;
    }


    /* =========================================================
       SIDEBAR
       ========================================================= */

    .dashboard-sidebar {
        position: fixed;
        top: 0;
        bottom: 0;
        left: -315px;
        width: 275px;
        box-sizing: border-box;
        padding: 24px 18px;
        background: rgba(255, 255, 255, 0.98);
        backdrop-filter: blur(18px);
        -webkit-backdrop-filter: blur(18px);
        border-right: 1px solid var(--border);
        display: flex;
        flex-direction: column;
        z-index: 1200;
        box-shadow: 12px 0 40px rgba(15, 23, 42, 0.10);
        transition: left 0.35s cubic-bezier(0.4, 0, 0.2, 1);
        overflow-y: auto;
        overflow-x: hidden;
    }

        .dashboard-sidebar.open {
            left: 0;
        }


    /* =========================================================
       SIDEBAR BRAND
       ========================================================= */

    .sidebar-brand {
        min-height: 46px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 7px;
        margin-bottom: 28px;
    }

    .sidebar-brand-left {
        display: flex;
        align-items: center;
        gap: 11px;
        color: var(--text-main);
        font-size: 17px;
        font-weight: 750;
        white-space: nowrap;
    }

    .sidebar-logo {
        width: 42px;
        height: 42px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        color: white;
        font-size: 13px;
        font-weight: 800;
        background: linear-gradient( 135deg, var(--primary), var(--primary-light) );
        box-shadow: 0 8px 20px rgba(79, 70, 229, 0.22);
    }


    /* =========================================================
       SIDEBAR CLOSE BUTTON
       ========================================================= */

    .sidebar-close-btn {
        width: 34px;
        height: 34px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 0;
        background: transparent;
        border-radius: 9px;
        color: var(--text-muted);
        font-size: 23px;
        line-height: 1;
        cursor: pointer;
        transition: background 0.2s ease, color 0.2s ease, transform 0.2s ease;
    }

        .sidebar-close-btn:hover {
            background: #f1f5f9;
            color: var(--primary);
            transform: rotate(90deg);
        }


    /* =========================================================
       SIDEBAR MENU
       ========================================================= */

    .sidebar-menu {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

        .sidebar-menu li {
            width: 100%;
        }

            .sidebar-menu li a {
                position: relative;
                display: flex;
                align-items: center;
                width: 100%;
                min-height: 48px;
                box-sizing: border-box;
                padding: 12px 14px;
                color: #64748b;
                text-decoration: none;
                font-size: 14px;
                font-weight: 600;
                border-radius: 11px;
                transition: background 0.2s ease, color 0.2s ease, transform 0.2s ease;
            }

                .sidebar-menu li a:hover {
                    color: var(--primary);
                    background: #f5f7ff;
                    transform: translateX(3px);
                    text-decoration: none;
                }

                .sidebar-menu li a.active {
                    color: white;
                    background: linear-gradient( 135deg, var(--primary), var(--primary-light) );
                    font-weight: 700;
                    box-shadow: 0 8px 20px rgba(79, 70, 229, 0.20);
                }


    /* =========================================================
       FLOATING MENU BUTTON
       ========================================================= */

    .sidebar-toggle-btn {
        position: fixed;
        top: 78px;
        left: 24px;
        width: 48px;
        height: 48px;
        z-index: 1100;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px solid var(--border);
        border-radius: 13px;
        background: rgba(255, 255, 255, 0.97);
        color: var(--primary);
        cursor: pointer;
        box-shadow: 0 8px 25px rgba(15, 23, 42, 0.09);
        transition: transform 0.25s ease, box-shadow 0.25s ease, color 0.25s ease;
    }

        .sidebar-toggle-btn:hover {
            transform: translateY(-2px) scale(1.02);
            box-shadow: 0 13px 30px rgba(15, 23, 42, 0.14);
            color: var(--primary-dark);
        }

        .sidebar-toggle-btn:focus {
            outline: none;
        }


    /* =========================================================
       MAIN CONTENT
       ========================================================= */

    .dashboard-main {
        width: 100%;
        max-width: 1450px;
        margin: 0 auto;
        box-sizing: border-box;
        padding: 108px 42px 45px;
    }


    /* =========================================================
       HERO HEADER
       ========================================================= */

    .cleaner-header {
        position: relative;
        overflow: hidden;
        padding: 34px 38px;
        margin-bottom: 24px;
        border-radius: 20px;
        color: white;
        background: linear-gradient( 135deg, #3730a3 0%, #4f46e5 48%, #0ea5e9 100% );
        box-shadow: 0 18px 42px rgba(79, 70, 229, 0.16);
    }

        .cleaner-header::before {
            content: "";
            position: absolute;
            width: 270px;
            height: 270px;
            right: -80px;
            top: -135px;
            border-radius: 50%;
            border: 35px solid rgba(255, 255, 255, 0.07);
        }

        .cleaner-header::after {
            content: "";
            position: absolute;
            width: 190px;
            height: 190px;
            right: 105px;
            bottom: -125px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.05);
        }

    .cleaner-header-content {
        position: relative;
        z-index: 2;
        max-width: 900px;
    }


    /* =========================================================
       HERO LABEL
       ========================================================= */

    .cleaner-label {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 13px;
        padding: 7px 12px;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.13);
        border: 1px solid rgba(255, 255, 255, 0.15);
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.7px;
        text-transform: uppercase;
    }

    .cleaner-dot {
        width: 7px;
        height: 7px;
        flex: 0 0 auto;
        border-radius: 50%;
        background: #a7f3d0;
        box-shadow: 0 0 0 5px rgba(167, 243, 208, 0.10);
    }


    /* =========================================================
       HERO TEXT
       ========================================================= */

    .cleaner-header h2 {
        position: relative;
        margin: 0;
        color: white;
        font-size: 30px;
        line-height: 1.2;
        font-weight: 800;
        letter-spacing: -0.7px;
    }

    .cleaner-header p {
        position: relative;
        margin: 12px 0 0;
        max-width: 850px;
        color: rgba(255, 255, 255, 0.84);
        font-size: 14px;
        line-height: 1.7;
    }


    /* =========================================================
       QUICK ACTIONS
       ========================================================= */

    .quick-actions {
        display: grid;
        grid-template-columns: repeat( 2, minmax(0, 1fr) );
        gap: 16px;
        margin-bottom: 24px;
    }


    /* =========================================================
       QUICK CARD
       ========================================================= */

    .quick-card {
        position: relative;
        min-height: 120px;
        box-sizing: border-box;
        padding: 16px;
        border: 1px solid var(--border);
        border-radius: 16px;
        background: rgba(255, 255, 255, 0.98);
        box-shadow: 0 7px 22px rgba(15, 23, 42, 0.05);
        overflow: hidden;
        transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
    }

        .quick-card::after {
            content: "";
            position: absolute;
            width: 85px;
            height: 85px;
            right: -28px;
            top: -28px;
            border-radius: 50%;
            background: rgba(79, 70, 229, 0.045);
        }

        .quick-card:hover {
            transform: translateY(-4px);
            box-shadow: var(--shadow-hover);
            border-color: #cbd5e1;
        }

        .quick-card a {
            position: relative;
            z-index: 2;
            width: 100%;
            height: 100%;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 10px;
            text-align: center;
            color: var(--text-main);
            text-decoration: none;
            font-size: 13px;
            font-weight: 700;
        }

            .quick-card a:hover {
                color: var(--primary);
                text-decoration: none;
            }


    /* =========================================================
       QUICK ICONS
       ========================================================= */

    .quick-icon {
        width: 43px;
        height: 43px;
        flex: 0 0 auto;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        color: white;
        box-shadow: 0 7px 15px rgba(0, 0, 0, 0.09);
        transition: transform 0.25s ease;
    }

    .quick-card:hover .quick-icon {
        transform: scale(1.06) rotate(-3deg);
    }

    .icon-clean {
        background: linear-gradient( 135deg, #4f46e5, #6366f1 );
    }

    .icon-supply {
        background: linear-gradient( 135deg, #0284c7, #0ea5e9 );
    }


    /* =========================================================
       MAIN PANEL
       ========================================================= */

    .panel {
        position: relative;
        width: 100%;
        box-sizing: border-box;
        padding: 27px;
        border-radius: 18px;
        border: 1px solid var(--border);
        background: rgba(255, 255, 255, 0.98);
        box-shadow: var(--shadow);
        overflow: hidden;
    }

        .panel::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 3px;
            background: linear-gradient( 90deg, #4f46e5, #6366f1, #0ea5e9 );
        }


    /* =========================================================
       PANEL HEADER
       ========================================================= */

    .panel-title {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        margin-bottom: 22px;
        padding-bottom: 17px;
        border-bottom: 1px solid var(--border-soft);
        flex-wrap: wrap;
    }

        .panel-title h3 {
            display: flex;
            align-items: center;
            margin: 0;
            color: var(--text-main);
            font-size: 18px;
            font-weight: 800;
            letter-spacing: -0.25px;
        }

            .panel-title h3::before {
                content: "✓";
                display: inline-flex;
                align-items: center;
                justify-content: center;
                width: 38px;
                height: 38px;
                flex: 0 0 auto;
                margin-right: 10px;
                border-radius: 11px;
                color: white;
                background: linear-gradient( 135deg, #4f46e5, #6366f1 );
                box-shadow: 0 7px 16px rgba(79, 70, 229, 0.18);
                font-size: 14px;
            }


    /* =========================================================
       SCHEDULE BADGE
       ========================================================= */

    .schedule-badge {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 7px 12px;
        border-radius: 999px;
        color: #047857;
        background: #ecfdf5;
        border: 1px solid #d1fae5;
        font-size: 11px;
        font-weight: 700;
        white-space: nowrap;
    }

        .schedule-badge::before {
            content: "";
            width: 7px;
            height: 7px;
            flex: 0 0 auto;
            border-radius: 50%;
            background: var(--success);
            box-shadow: 0 0 0 4px rgba(16, 185, 129, 0.10);
        }


    /* =========================================================
       TABLE RESPONSIVE AREA
       ========================================================= */

    .table-responsive {
        width: 100%;
        overflow-x: auto;
        overflow-y: hidden;
        border-radius: 12px;
        scrollbar-width: thin;
        -webkit-overflow-scrolling: touch;
    }


    /* =========================================================
       CLEANING TABLE
       ========================================================= */

    .table-clean {
        width: 100%;
        min-width: 650px;
        border-collapse: separate;
        border-spacing: 0;
        overflow: hidden;
    }

        .table-clean thead th {
            background: #f8fafc;
            color: var(--text-muted);
            font-weight: 750;
            text-transform: uppercase;
            font-size: 11px;
            letter-spacing: 0.65px;
            border-bottom: 1px solid var(--border);
            padding: 14px 16px;
            white-space: nowrap;
        }

            .table-clean thead th:first-child {
                border-top-left-radius: 10px;
            }

            .table-clean thead th:last-child {
                border-top-right-radius: 10px;
            }

        .table-clean tbody td {
            padding: 16px;
            border-top: 1px solid var(--border-soft);
            vertical-align: middle;
            color: var(--text-main);
            font-size: 14px;
            background: #ffffff;
        }

        .table-clean tbody tr {
            transition: background 0.2s ease;
        }

            .table-clean tbody tr:hover td {
                background: #f8fafc;
            }


    /* =========================================================
       STATUS CHIP
       ========================================================= */

    .status-chip {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 6px 12px;
        border-radius: 999px;
        background: #eef2ff;
        color: var(--primary);
        border: 1px solid #e0e7ff;
        font-weight: 700;
        font-size: 12px;
        white-space: nowrap;
    }


    /* =========================================================
       RESOLVE BUTTON
       ========================================================= */

    .resolve-link {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 82px;
        box-sizing: border-box;
        padding: 8px 16px;
        border-radius: 9px;
        background: linear-gradient( 135deg, #4f46e5, #6366f1 );
        color: white;
        text-decoration: none;
        font-weight: 700;
        font-size: 13px;
        box-shadow: 0 5px 13px rgba(79, 70, 229, 0.18);
        transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
    }

        .resolve-link:hover {
            background: linear-gradient( 135deg, #4338ca, #4f46e5 );
            color: white;
            text-decoration: none;
            transform: translateY(-2px);
            box-shadow: 0 8px 18px rgba(79, 70, 229, 0.23);
        }


    /* =========================================================
       LOGOUT
       ========================================================= */

    .logout-wrapper {
        display: flex;
        justify-content: flex-end;
        margin-top: 20px;
    }

    .logout-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 10px 18px;
        border-radius: 10px;
        background: white;
        border: 1px solid var(--border);
        color: #64748b;
        text-decoration: none;
        font-size: 12px;
        font-weight: 700;
        transition: transform 0.2s ease, color 0.2s ease, border-color 0.2s ease, background 0.2s ease;
    }

        .logout-btn:hover {
            color: var(--danger);
            border-color: #fecdd3;
            background: #fff7f8;
            transform: translateY(-2px);
            text-decoration: none;
        }


    /* =========================================================
       CURSOR GLOW
       ========================================================= */

    #cursorCanvas {
        position: fixed;
        inset: 0;
        width: 100vw;
        height: 100vh;
        pointer-events: none;
        z-index: 999;
    }


    /* =========================================================
       LARGE TABLET
       ========================================================= */

    @@media (max-width: 1200px) {

        .dashboard-main {
            padding-left: 30px;
            padding-right: 30px;
        }

        .cleaner-header {
            padding: 31px 32px;
        }
    }


    /* =========================================================
       TABLET
       ========================================================= */

    @@media (max-width: 900px) {

        .dashboard-main {
            padding-top: 103px;
        }

        .cleaner-header h2 {
            font-size: 27px;
        }
    }


    /* =========================================================
       MOBILE
       ========================================================= */

    @@media (max-width: 768px) {

        .dashboard-main {
            padding: 100px 18px 30px;
        }

        .sidebar-toggle-btn {
            top: 72px;
            left: 16px;
            width: 46px;
            height: 46px;
        }

        .dashboard-sidebar {
            width: 280px;
            left: -305px;
        }

        .cleaner-header {
            padding: 27px 23px;
            margin-bottom: 20px;
            border-radius: 18px;
        }

            .cleaner-header h2 {
                font-size: 23px;
                letter-spacing: -0.4px;
            }

            .cleaner-header p {
                font-size: 13px;
                line-height: 1.65;
            }

        .quick-actions {
            gap: 12px;
            margin-bottom: 20px;
        }

        .quick-card {
            min-height: 108px;
        }

            .quick-card a {
                font-size: 12.5px;
            }

        .panel {
            padding: 20px;
            border-radius: 17px;
        }

        .panel-title {
            align-items: flex-start;
            flex-direction: column;
            gap: 12px;
        }

        .schedule-badge {
            align-self: flex-start;
        }

        .table-clean {
            min-width: 620px;
        }

        .logout-wrapper {
            justify-content: stretch;
        }

        .logout-btn {
            width: 100%;
        }
    }


    /* =========================================================
       SMALL PHONE
       ========================================================= */

    @@media (max-width: 480px) {

        .dashboard-main {
            padding-left: 13px;
            padding-right: 13px;
        }

        .cleaner-header {
            padding: 23px 20px;
            border-radius: 16px;
        }

        .cleaner-label {
            font-size: 10px;
            padding: 6px 10px;
        }

        .cleaner-header h2 {
            font-size: 20px;
        }

        .cleaner-header p {
            font-size: 12px;
            line-height: 1.6;
        }

        .quick-actions {
            gap: 9px;
        }

        .quick-card {
            min-height: 100px;
            padding: 10px;
        }

            .quick-card a {
                font-size: 11.5px;
                gap: 8px;
            }

        .quick-icon {
            width: 37px;
            height: 37px;
        }

        .panel {
            padding: 15px;
            border-radius: 15px;
        }

        .panel-title {
            margin-bottom: 17px;
            padding-bottom: 14px;
        }

            .panel-title h3 {
                font-size: 16px;
            }

                .panel-title h3::before {
                    width: 34px;
                    height: 34px;
                    margin-right: 8px;
                }

        .schedule-badge {
            font-size: 10px;
        }
    }
</style>


<!-- =========================================================
     BACKGROUND SHAPES
     ========================================================= -->

<div class="bg-shape shape1"></div>
<div class="bg-shape shape2"></div>
<div class="bg-shape shape3"></div>


<!-- =========================================================
     FLOATING MENU BUTTON
     ========================================================= -->

<button type="button"
        class="sidebar-toggle-btn"
        onclick="toggleSidebar()"
        aria-label="Open navigation menu">

    <svg width="21"
         height="21"
         fill="none"
         stroke="currentColor"
         stroke-width="2"
         viewBox="0 0 24 24">

        <path stroke-linecap="round"
              stroke-linejoin="round"
              d="M4 6h16M4 12h16M4 18h16">
        </path>

    </svg>

</button>


<!-- =========================================================
     DASHBOARD
     ========================================================= -->

<div class="dashboard-wrapper">


    <!-- =====================================================
         SIDEBAR
         ===================================================== -->

    <div id="dashboardSidebar"
         class="dashboard-sidebar">


        <div class="sidebar-brand">

            <div class="sidebar-brand-left">

                <span class="sidebar-logo">
                    EC
                </span>

                <span>
                    ElderlyCare
                </span>

            </div>


            <button type="button"
                    class="sidebar-close-btn"
                    onclick="toggleSidebar()"
                    aria-label="Close Sidebar">

                &times;

            </button>

        </div>


        <ul class="sidebar-menu">

            <li>

                <a href="@Url.Action("Dashboard", "Cleaner")"
                   class="active">

                    Dashboard

                </a>

            </li>


            <li>

                <a href="@Url.Action("Index", "InventoryRequests")">

                    Supply Requests

                </a>

            </li>

        </ul>

    </div>


    <!-- =====================================================
         MAIN CONTENT
         ===================================================== -->

    <main class="dashboard-main">


        <!-- =================================================
             HERO
             ================================================= -->

        <section class="cleaner-header">

            <div class="cleaner-header-content">

                <div class="cleaner-label">

                    <span class="cleaner-dot"></span>

                    Cleaning Operations

                </div>


                <h2>
                    Cleaner Operations Dashboard
                </h2>


                <p>
                    Welcome back. Keep patient rooms, wards, corridors,
                    and care areas clean, safe, and ready for high-quality
                    elderly care. Monitor your cleaning schedule and manage
                    supply requests from one secure maintenance workspace.
                </p>

            </div>

        </section>


        <!-- =================================================
             QUICK ACTIONS
             ================================================= -->

        <div class="quick-actions">


            <!-- CLEANING DASHBOARD -->

            <div class="quick-card">

                <a href="@Url.Action("Dashboard", "Cleaner")">

                    <div class="quick-icon icon-clean">

                        <svg width="18"
                             height="18"
                             fill="none"
                             stroke="currentColor"
