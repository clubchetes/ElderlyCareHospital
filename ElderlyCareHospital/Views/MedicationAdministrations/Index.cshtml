@model IEnumerable<ElderlyCareHospital.Models.MedicationAdministration>

@{
    ViewBag.Title = "Patient Medication Routine";
}

<style>
    /* =========================================================
       NURSE DASHBOARD THEME
       ========================================================= */

    :root {
        --app-bg: #f4f8fb;
        --surface: #ffffff;
        --surface-soft: #f8fbfd;
        --text-main: #102a43;
        --text-muted: #627d98;
        --border: #e3ebf1;
        --teal: #2f6f73;
        --teal-dark: #25575a;
        --teal-soft: #edf7f7;
        --blue: #3567a3;
        --blue-soft: #edf3fb;
        --green: #2e7d5b;
        --green-soft: #edf8f2;
        --red: #b52b2b;
        --red-soft: #fdeeee;
        --shadow: 0 8px 24px rgba(16, 42, 67, 0.07);
        --shadow-hover: 0 12px 28px rgba(16, 42, 67, 0.10);
    }

    body {
        background: var(--app-bg);
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        color: var(--text-main);
    }

    /* =========================================================
       PAGE CONTAINER
       ========================================================= */

    .med-page-container {
        max-width: 1200px;
        margin: 32px auto;
        padding: 0 20px 30px;
    }

    /* =========================================================
       PAGE HEADER
       ========================================================= */

    .med-header {
        background: var(--surface);
        border: 1px solid var(--border);
        color: var(--text-main);
        padding: 28px 32px;
        border-radius: 18px;
        margin-bottom: 22px;
        box-shadow: var(--shadow);
    }

        .med-header h2 {
            margin: 0;
            font-size: 30px;
            font-weight: 700;
            letter-spacing: -0.4px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
        }

        .med-header p {
            margin: 10px 0 0;
            color: var(--text-muted);
            font-size: 15px;
            line-height: 1.6;
            max-width: 850px;
        }

    /* =========================================================
       LIVE STATUS
       ========================================================= */

    .live-status {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        flex-shrink: 0;
        padding: 7px 12px;
        border-radius: 999px;
        background: var(--green-soft);
        color: var(--green);
        border: 1px solid #d9eee3;
        font-size: 12px;
        font-weight: 700;
        white-space: nowrap;
    }

    .live-dot {
        width: 7px;
        height: 7px;
        background: #42a86f;
        border-radius: 50%;
        display: inline-block;
    }

    /* =========================================================
       TOOLBAR
       ========================================================= */

    .toolbar {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        margin-bottom: 18px;
    }

    .create-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: var(--teal);
        color: white !important;
        padding: 11px 20px;
        border: 1px solid var(--teal);
        border-radius: 10px;
        text-decoration: none !important;
        font-weight: 600;
        font-size: 14px;
        box-shadow: 0 4px 10px rgba(47, 111, 115, 0.14);
        transition: background 0.2s ease, border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
    }

        .create-btn:hover {
            background: var(--teal-dark);
            border-color: var(--teal-dark);
            color: white !important;
            transform: translateY(-1px);
            box-shadow: 0 6px 14px rgba(47, 111, 115, 0.18);
        }

    /* =========================================================
       MAIN PANEL
       ========================================================= */

    .med-panel {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 18px;
        padding: 24px;
        box-shadow: var(--shadow);
    }

    /* =========================================================
       TABLE
       ========================================================= */

    .table-responsive {
        width: 100%;
        overflow-x: auto;
        border-radius: 12px;
    }

    .table {
        width: 100%;
        margin-bottom: 0;
        border-collapse: separate;
        border-spacing: 0;
        min-width: 850px;
    }

        .table thead th {
            background: #f1f6f8;
            color: #486581;
            padding: 14px 14px;
            border-top: 1px solid var(--border);
            border-bottom: 1px solid var(--border);
            border-left: none;
            border-right: none;
            font-size: 12px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.45px;
            text-align: center;
            vertical-align: middle;
            white-space: nowrap;
        }

            .table thead th:first-child {
                border-left: 1px solid var(--border);
                border-radius: 12px 0 0 0;
                text-align: left;
            }

            .table thead th:last-child {
                border-right: 1px solid var(--border);
                border-radius: 0 12px 0 0;
            }

        .table tbody td {
            padding: 15px 14px;
            border-bottom: 1px solid var(--border);
            font-size: 14px;
            color: #334e68;
            text-align: center;
            vertical-align: middle;
            background: var(--surface);
        }

        .table tbody tr:last-child td {
            border-bottom: none;
        }

        .table tbody tr {
            transition: background 0.18s ease;
        }

            .table tbody tr:hover td {
                background: var(--surface-soft);
            }

    /* =========================================================
       MEDICINE / PATIENT
       ========================================================= */

    .medicine-name {
        text-align: left !important;
        color: var(--teal) !important;
        font-weight: 700;
        white-space: nowrap;
    }

    .patient-name {
        color: var(--text-main);
        font-weight: 600;
        white-space: nowrap;
    }

    /* =========================================================
       NURSE BADGE
       ========================================================= */

    .nurse-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 5px 10px;
        background: var(--teal-soft);
        color: var(--teal);
        border: 1px solid #d9eeee;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 600;
        white-space: nowrap;
    }

    /* =========================================================
       STATUS BADGE
       ========================================================= */

    .status-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 86px;
        padding: 6px 12px;
        background: var(--green-soft);
        color: var(--green);
        border: 1px solid #d8eee2;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 700;
    }

    /* =========================================================
       DATE
       ========================================================= */

    .date-text {
        color: var(--text-muted);
        font-size: 13px;
        font-weight: 600;
        white-space: nowrap;
    }

    /* =========================================================
       ACTIONS
       ========================================================= */

    .action-links {
        white-space: nowrap;
    }

    .action-link {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 6px 10px;
        margin: 2px;
        border-radius: 7px;
        text-decoration: none !important;
        font-size: 12px;
        font-weight: 600;
        transition: background 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
    }

    .edit-link {
        color: var(--teal) !important;
        background: var(--teal-soft);
    }

        .edit-link:hover {
            background: #e0f1f1;
            color: var(--teal-dark) !important;
        }

    .details-link {
        color: var(--blue) !important;
        background: var(--blue-soft);
    }

        .details-link:hover {
            background: #e2ecf8;
            color: #2b5689 !important;
        }

    .delete-link {
        color: var(--red) !important;
        background: var(--red-soft);
    }

        .delete-link:hover {
            background: #f9dddd;
            color: #922222 !important;
        }

    .action-link:hover {
        transform: translateY(-1px);
        box-shadow: 0 3px 8px rgba(16, 42, 67, 0.07);
    }

    /* =========================================================
       EMPTY STATE
       ========================================================= */

    .empty-state {
        text-align: center;
        padding: 45px 20px;
        color: var(--text-muted);
    }

        .empty-state h4 {
            margin: 0 0 7px;
            color: var(--text-main);
            font-weight: 700;
        }

        .empty-state p {
            margin: 0;
            font-size: 14px;
        }

    /* =========================================================
       BACK BUTTON
       ========================================================= */

    .footer-row {
        margin-top: 22px;
    }

    .back-link {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 10px 18px;
        background: #455a64;
        color: white !important;
        border-radius: 10px;
        text-decoration: none !important;
        font-weight: 600;
        font-size: 14px;
        transition: background 0.2s ease, transform 0.2s ease;
    }

        .back-link:hover {
            background: #263238;
            color: white !important;
            text-decoration: none !important;
            transform: translateY(-1px);
        }

    /* =========================================================
       RESPONSIVE
       ========================================================= */

    @@media (max-width: 768px) {

        .med-page-container {
            margin-top: 20px;
            padding: 0 14px 25px;
        }

        .med-header {
            padding: 22px;
        }

            .med-header h2 {
                font-size: 25px;
                align-items: flex-start;
                flex-direction: column;
                gap: 12px;
            }

        .live-status {
            font-size: 11px;
        }

        .med-panel {
            padding: 16px;
        }

        .toolbar {
            justify-content: stretch;
        }

        .create-btn {
            width: 100%;
        }
    }
</style>

<div class="med-page-container">

    <!-- =====================================================
         HEADER
         ===================================================== -->

    <div class="med-header">

        <h2>
            <span>Patient Medication Routine</span>

            <span class="live-status">
                <span class="live-dot"></span>
                Live Sync Active
            </span>
        </h2>

        <p>
            Track patient medications, monitor scheduled administrations,
            and review nurse treatment activity in real time.
        </p>

    </div>


    <!-- =====================================================
         TOOLBAR
         ===================================================== -->

    <div class="toolbar">

        @Html.ActionLink(
            "Create New",
            "Create",
            null,
            new { @class = "create-btn" })

    </div>


    <!-- =====================================================
         MEDICATION TABLE
         ===================================================== -->

    <div class="med-panel">

        <div class="table-responsive">

            <table class="table">

                <thead>

                    <tr>

                        <th>
                            @Html.DisplayNameFor(
                                model => model.Medicine.MedicineName)
                        </th>

                        <th>
                            @Html.DisplayNameFor(
                                model => model.Patient.FirstName)
                        </th>

                        <th>
                            @Html.DisplayNameFor(
                                model => model.NurseID)
                        </th>

                        <th>
                            @Html.DisplayNameFor(
                                model => model.Status)
                        </th>

                        <th>
                            @Html.DisplayNameFor(
                                model => model.DateAdministered)
                        </th>

                        <th>
                            Actions
                        </th>

                    </tr>

                </thead>

                <tbody id="liveMedicationBody">

                    @Html.Partial(
                        "_MedicationAdministrationRows",
                        Model)

                </tbody>

            </table>

        </div>

    </div>


    <!-- =====================================================
         BACK TO DASHBOARD
         ===================================================== -->

    <div class="footer-row">

        @Html.ActionLink(
            "Back to Dashboard",
            "Dashboard",
            "Nurse",
            null,
            new { @class = "back-link" })

    </div>

</div>


@section Scripts {

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <script>

        function refreshMedicationAdministrations() {

            $.ajax({

                url: '@Url.Action(
                    "GetLiveMedicationAdministrations",
                    "MedicationAdministrations")',

                type: 'GET',

                success: function (data) {

                    $('#liveMedicationBody').html(data);

                }

            });

        }

        // Keep the existing live synchronization.
        // Refreshes medication administration data every 5 seconds.
        setInterval(
            refreshMedicationAdministrations,
            5000
        );

    </script>

}