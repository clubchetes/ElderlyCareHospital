@model IEnumerable<ElderlyCareHospital.Models.Patient>

@{
    ViewBag.Title = "Manage Patients";
}

<style>

    /* =========================================================
       ROOT / DOCTOR DASHBOARD THEME
       ========================================================= */

    :root {
        --app-bg: #f8fafc;
        --card-bg: #ffffff;
        --text-main: #0f172a;
        --text-muted: #64748b;
        --primary: #4f46e5;
        --primary-hover: #4338ca;
        --border-color: #e2e8f0;
        --doctor-accent: #0f766e;
        --doctor-accent-light: #14b8a6;
        --blue: #0284c7;
        --danger: #dc2626;
    }


    /* =========================================================
       PAGE
       ========================================================= */

    html,
    body {
        margin: 0;
        padding: 0;
        min-height: 100%;
    }

    body {
        background: var(--app-bg);
        font-family: 'Inter', 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        color: var(--text-main);
        overflow-x: hidden;
    }

    .patients-container {
        width: 100%;
        max-width: 100%;
        box-sizing: border-box;
        margin-top: 40px;
        margin-bottom: 40px;
        padding-left: 40px;
        padding-right: 40px;
    }


    /* =========================================================
       HEADER
       ========================================================= */

    .patients-header {
        position: relative;
        overflow: hidden;
        background: var(--card-bg);
        border: 1px solid var(--border-color);
        color: var(--text-main);
        padding: 30px 36px;
        border-radius: 18px;
        margin-bottom: 30px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.02);
    }

        .patients-header::after {
            content: "";
            position: absolute;
            width: 180px;
            height: 180px;
            right: -70px;
            top: -80px;
            border-radius: 50%;
            background: rgba(20, 184, 166, 0.045);
            pointer-events: none;
        }

        .patients-header h2 {
            position: relative;
            z-index: 1;
            margin: 0;
            font-weight: 700;
            font-size: 24px;
            color: var(--text-main);
            letter-spacing: -0.3px;
            line-height: 1.3;
        }

        .patients-header p {
            position: relative;
            z-index: 1;
            margin: 10px 0 0 0;
            color: var(--text-muted);
            font-size: 14px;
            line-height: 1.6;
        }

    .live-badge {
        float: right;
        font-size: 13px;
        background: rgba(15, 118, 110, 0.09);
        color: var(--doctor-accent);
        padding: 5px 12px;
        border-radius: 20px;
        font-weight: 600;
        border: 1px solid rgba(15, 118, 110, 0.12);
    }


    /* =========================================================
       FILTER PANEL
       ========================================================= */

    .filter-panel {
        background: var(--card-bg);
        border: 1px solid var(--border-color);
        border-radius: 18px;
        padding: 24px 28px;
        margin-bottom: 24px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.02);
    }

    .filter-heading {
        margin: 0 0 18px 0;
        color: var(--text-main);
        font-size: 16px;
        font-weight: 700;
    }

    .filter-bar {
        display: flex;
        flex-wrap: wrap;
        align-items: flex-end;
        gap: 16px;
        margin: 0;
    }

    .filter-group {
        display: flex;
        flex-direction: column;
        min-width: 180px;
        flex: 1;
    }

        .filter-group.search-group {
            flex: 2;
        }

        .filter-group label {
            font-size: 12px;
            font-weight: 700;
            color: var(--text-muted);
            margin-bottom: 7px;
        }

    .filter-input {
        width: 100%;
        box-sizing: border-box;
        min-height: 42px;
        border: 1px solid var(--border-color);
        border-radius: 10px;
        padding: 10px 12px;
        font-size: 14px;
        color: var(--text-main);
        background: #ffffff;
        outline: none;
        transition: border-color 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
    }

        .filter-input:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.10);
            background: #ffffff;
        }

        .filter-input::placeholder {
            color: #94a3b8;
        }


    /* =========================================================
       FILTER BUTTONS
       ========================================================= */

    .btn-filter {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 42px;
        padding: 10px 18px;
        border: none;
        border-radius: 10px;
        background: linear-gradient(135deg, #4f46e5, #6366f1);
        color: white;
        font-weight: 600;
        font-size: 13px;
        cursor: pointer;
        box-shadow: 0 4px 10px rgba(79, 70, 229, 0.12);
        transition: all 0.2s ease;
    }

        .btn-filter:hover {
            background: linear-gradient(135deg, #4338ca, #4f46e5);
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 7px 16px rgba(79, 70, 229, 0.18);
        }

    .btn-clear {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 42px;
        box-sizing: border-box;
        padding: 10px 18px;
        border-radius: 10px;
        background: #475569;
        color: white !important;
        text-decoration: none;
        font-weight: 600;
        font-size: 13px;
        transition: all 0.2s ease;
    }

        .btn-clear:hover {
            background: #334155;
            color: white !important;
            text-decoration: none;
            transform: translateY(-2px);
        }


    /* =========================================================
       TABLE PANEL
       ========================================================= */

    .table-card {
        background: var(--card-bg);
        border: 1px solid var(--border-color);
        border-radius: 18px;
        padding: 28px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.02);
    }

    .table-heading-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        margin-bottom: 20px;
    }

    .table-heading {
        margin: 0;
        color: var(--text-main);
        font-size: 18px;
        font-weight: 700;
    }

    .table-subtitle {
        margin: 5px 0 0 0;
        color: var(--text-muted);
        font-size: 13px;
    }


    /* =========================================================
       CREATE BUTTON
       ========================================================= */

    .btn-create {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #4f46e5, #6366f1);
        color: white !important;
        padding: 10px 18px;
        border-radius: 10px;
        text-decoration: none;
        font-weight: 600;
        font-size: 13px;
        box-shadow: 0 4px 10px rgba(79, 70, 229, 0.12);
        transition: all 0.2s ease;
        white-space: nowrap;
    }

        .btn-create:hover {
            background: linear-gradient(135deg, #4338ca, #4f46e5);
            color: white !important;
            text-decoration: none;
            transform: translateY(-2px);
            box-shadow: 0 7px 16px rgba(79, 70, 229, 0.18);
        }


    /* =========================================================
       TABLE
       ========================================================= */

    .table-responsive {
        width: 100%;
        overflow-x: auto;
        border: 1px solid var(--border-color);
        border-radius: 14px;
    }

    .table {
        width: 100%;
        min-width: 1050px;
        border-collapse: collapse;
        margin-bottom: 0;
        background: white;
    }

        .table thead th {
            background: #f8fafc;
            color: var(--text-muted);
            font-weight: 700;
            border-bottom: 1px solid var(--border-color);
            padding: 14px 12px;
            white-space: nowrap;
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 0.4px;
            text-align: center;
            vertical-align: middle;
        }

        .table tbody td {
            padding: 15px 12px;
            border-bottom: 1px solid #eef2f7;
            vertical-align: middle;
            color: var(--text-main);
            font-size: 13.5px;
            text-align: center;
            line-height: 1.5;
        }

        .table tbody tr {
            transition: background 0.2s ease;
        }

            .table tbody tr:hover {
                background: #fafbfc;
            }

            .table tbody tr:last-child td {
                border-bottom: none;
            }


    /* =========================================================
       ACTION LINKS
       ========================================================= */

    .actions {
        white-space: nowrap;
    }

        .actions a {
            display: inline-block;
            text-decoration: none;
            font-weight: 600;
            font-size: 12px;
            margin: 2px 5px;
            transition: color 0.2s ease, transform 0.2s ease;
        }

            .actions a:hover {
                text-decoration: none;
                transform: translateY(-1px);
            }

    .edit-link {
        color: var(--doctor-accent);
    }

        .edit-link:hover {
            color: #115e59;
        }

    .details-link {
        color: var(--blue);
    }

        .details-link:hover {
            color: #0369a1;
        }

    .delete-link {
        color: var(--danger);
    }

        .delete-link:hover {
            color: #b91c1c;
        }


    /* =========================================================
       BACK BUTTON
       ========================================================= */

    .footer-row {
        margin-top: 24px;
    }

    .back-link {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 10px 18px;
        background: linear-gradient(135deg, #475569, #64748b);
        color: white !important;
        border-radius: 10px;
        text-decoration: none;
        font-weight: 600;
        font-size: 13px;
        box-shadow: 0 4px 10px rgba(15, 23, 42, 0.06);
        transition: all 0.2s ease;
    }

        .back-link:hover {
            background: linear-gradient(135deg, #334155, #475569);
            color: white !important;
            text-decoration: none;
            transform: translateY(-2px);
            box-shadow: 0 7px 16px rgba(15, 23, 42, 0.10);
        }


    /* =========================================================
       RESPONSIVE - TABLET
       ========================================================= */

    @@media (max-width: 1100px) {

        .patients-container {
            padding-left: 28px;
            padding-right: 28px;
        }

        .patients-header {
            padding: 26px;
        }

        .filter-panel {
            padding: 22px;
        }

        .table-card {
            padding: 24px;
        }
    }


    /* =========================================================
       RESPONSIVE - MOBILE
       ========================================================= */

    @@media (max-width: 768px) {

        .patients-container {
            margin-top: 25px;
            padding-left: 18px;
            padding-right: 18px;
        }

        .patients-header {
            padding: 22px;
            border-radius: 15px;
            margin-bottom: 22px;
        }

            .patients-header h2 {
                font-size: 20px;
            }

            .patients-header p {
                font-size: 13px;
            }

        .live-badge {
            float: none;
            display: inline-block;
            margin-top: 12px;
        }

        .filter-panel {
            padding: 20px;
            border-radius: 15px;
        }

        .filter-bar {
            flex-direction: column;
            align-items: stretch;
        }

        .filter-group,
        .filter-group.search-group {
            width: 100%;
            min-width: 0;
            flex: none;
        }

        .btn-filter,
        .btn-clear {
            width: 100%;
        }

        .table-card {
            padding: 18px;
            border-radius: 15px;
        }

        .table-heading-row {
            flex-direction: column;
            align-items: stretch;
        }

        .btn-create {
            width: 100%;
            box-sizing: border-box;
        }

        .footer-row {
            margin-top: 20px;
        }

        .back-link {
            width: 100%;
            box-sizing: border-box;
        }
    }


    /* =========================================================
       RESPONSIVE - SMALL PHONE
       ========================================================= */

    @@media (max-width: 480px) {

        .patients-container {
            padding-left: 14px;
            padding-right: 14px;
        }

        .patients-header {
            padding: 20px;
        }

            .patients-header h2 {
                font-size: 18px;
            }

            .patients-header p {
                font-size: 12.5px;
            }

        .filter-panel {
            padding: 16px;
        }

        .table-card {
            padding: 14px;
        }

        .table-heading {
            font-size: 16px;
        }
    }
</style>


<div class="container patients-container">


    <!-- =====================================================
         PAGE HEADER
         ====================================================== -->

    <div class="patients-header">

        <h2>

            Manage Patients

            <span class="live-badge">
                🟢 Live Sync Active
            </span>

        </h2>

        <p>
            View, update, and manage patient records for the Elderly Care Hospital system.
        </p>

    </div>


    <!-- =====================================================
         FILTERS
         ====================================================== -->

    @using (Html.BeginForm("Index", "Patients", FormMethod.Get))
    {

        <div class="filter-panel">

            <h3 class="filter-heading">
                Patient Search & Filters
            </h3>

            <div class="filter-bar">


                <!-- SEARCH -->

                <div class="filter-group search-group">

                    <label>
                        Search Patient
                    </label>

                    <input type="text"
                           name="searchString"
                           value="@Request.QueryString["searchString"]"
                           class="filter-input"
                           placeholder="Search by name, room, contact..." />

                </div>


                <!-- GENDER -->

                <div class="filter-group">

                    <label>
                        Gender
                    </label>

                    <select name="genderFilter"
                            class="filter-input">

                        <option value="">
                            All Genders
                        </option>

                        <option value="Male"
                                @(Request.QueryString["genderFilter"] == "Male" ? "selected" : "")>
                            Male
                        </option>

                        <option value="Female"
                                @(Request.QueryString["genderFilter"] == "Female" ? "selected" : "")>
                            Female
                        </option>

                    </select>

                </div>


                <!-- ROOM -->

                <div class="filter-group">

                    <label>
                        Room Number
                    </label>

                    <input type="text"
                           name="roomFilter"
                           value="@Request.QueryString["roomFilter"]"
                           class="filter-input"
                           placeholder="e.g. 101" />

                </div>


                <!-- FALL RISK -->

                <div class="filter-group">

                    <label>
                        Fall Risk
                    </label>

                    <select name="fallRiskFilter"
                            class="filter-input">

                        <option value="">
                            All
                        </option>

                        <option value="true"
                                @(Request.QueryString["fallRiskFilter"] == "true" ? "selected" : "")>
                            High Risk
                        </option>

                        <option value="false"
                                @(Request.QueryString["fallRiskFilter"] == "false" ? "selected" : "")>
                            Low Risk
                        </option>

                    </select>

                </div>


                <!-- APPLY -->

                <button type="submit"
                        class="btn-filter">

                    Apply Filters

                </button>


                <!-- CLEAR -->

                @Html.ActionLink(
                    "Clear",
                    "Index",
                    null,
                    new { @class = "btn-clear" })

            </div>

        </div>

    }


    <!-- =====================================================
         PATIENT TABLE
         ====================================================== -->

    <div class="table-card">


        <!-- TABLE HEADER -->

        <div class="table-heading-row">

            <div>

                <h3 class="table-heading">
                    Patient Records
                </h3>

                <p class="table-subtitle">
                    Review patient information and manage individual records.
                </p>

            </div>


            @Html.ActionLink(
                "＋ Create New Patient",
                "Create",
                null,
                new { @class = "btn-create" })

        </div>


        <!-- TABLE -->

        <div class="table-responsive">

            <table class="table">

                <thead>

                    <tr>

                        <th>
                            @Html.DisplayNameFor(
                                model => model.FirstName)
                        </th>

                        <th>
                            @Html.DisplayNameFor(
                                model => model.LastName)
                        </th>

                        <th>
                            @Html.DisplayNameFor(
                                model => model.DateOfBirth)
                        </th>

                        <th>
                            @Html.DisplayNameFor(
                                model => model.Gender)
                        </th>

                        <th>
                            @Html.DisplayNameFor(
                                model => model.RoomNumber)
                        </th>

                        <th>
                            @Html.DisplayNameFor(
                                model => model.AdmissionDate)
                        </th>

                        <th>
                            @Html.DisplayNameFor(
                                model => model.EmergencyContact)
                        </th>

                        <th>
                            @Html.DisplayNameFor(
                                model => model.Allergies)
                        </th>

                        <th>
                            @Html.DisplayNameFor(
                                model => model.MedicalHistory)
                        </th>

                        <th>
                            @Html.DisplayNameFor(
                                model => model.FallRisk)
                        </th>

                        <th>
                            Actions
                        </th>

                    </tr>

                </thead>


                <tbody id="livePatientBody">

                    @Html.Partial(
                        "_PatientRows",
                        Model)

                </tbody>

            </table>

        </div>


        <!-- =================================================
             BACK TO DASHBOARD
             ================================================== -->

        <div class="footer-row">

            @Html.ActionLink(
                "Back to Dashboard",
                "Dashboard",
                "Doctor",
                null,
                new { @class = "back-link" })

        </div>

    </div>

</div>


@section Scripts {

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <script>

        function refreshPatients() {

            // Automatically appends any active URL search/filter parameters during background polling

            var queryString =
                window.location.search;

            $.ajax({

                url:
                    '@Url.Action("GetLivePatients", "Patients")'
                    + queryString,

                type: 'GET',

                success: function (data) {

                    $('#livePatientBody')
                        .html(data);

                }

            });

        }


        // Polls the database every 5 seconds for patient records sync

        setInterval(
            refreshPatients,
            5000
        );

    </script>

}