@model ElderlyCareHospital.ViewModels.CreateUserViewModel

@{
    ViewBag.Title = "Create User";
}

<style>

    /* =========================================================
       ROOT / ELDERLYCARE HOSPITAL THEME
       ========================================================= */

    :root {
        --app-bg: #f8fafc;
        --surface: #ffffff;
        --surface-soft: #f8fbfd;
        --text-main: #0f172a;
        --text-muted: #64748b;
        --primary: #4f46e5;
        --primary-hover: #4338ca;
        --secondary: #0ea5e9;
        --border-color: #e2e8f0;
    }


    /* =========================================================
       PAGE
       ========================================================= */

    html,
    body {
        margin: 0;
        padding: 0;
        min-height: 100%;
    }

    body {
        background: var(--app-bg);
        font-family: 'Inter', 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        color: var(--text-main);
        overflow-x: hidden;
    }


    /* =========================================================
       PAGE WRAPPER
       ========================================================= */

    .create-user-page {
        width: 100%;
        max-width: 900px;
        margin: 0 auto;
        padding: 36px 40px 45px;
        box-sizing: border-box;
    }


    /* =========================================================
       PAGE HEADER
       ========================================================= */

    .create-user-header {
        background: var(--surface);
        border: 1px solid var(--border-color);
        border-radius: 18px;
        padding: 26px 30px;
        margin-bottom: 22px;
        box-shadow: 0 4px 20px rgba(15, 23, 42, 0.03);
    }

        .create-user-header h2 {
            margin: 0;
            color: var(--text-main);
            font-size: 24px;
            font-weight: 700;
            letter-spacing: -0.3px;
            line-height: 1.3;
        }

        .create-user-header p {
            margin: 8px 0 0;
            color: var(--text-muted);
            font-size: 14px;
            line-height: 1.6;
        }


    /* =========================================================
       FORM CARD
       ========================================================= */

    .form-container {
        width: 100%;
        background: var(--surface);
        padding: 28px 30px;
        border-radius: 18px;
        border: 1px solid var(--border-color);
        box-shadow: 0 4px 18px rgba(15, 23, 42, 0.025);
        box-sizing: border-box;
    }


    /* =========================================================
       FORM GROUP
       ========================================================= */

    .form-group {
        margin-bottom: 18px;
    }


    /* =========================================================
       LABELS
       ========================================================= */

    .form-container label {
        display: block;
        margin-bottom: 7px;
        color: var(--text-main);
        font-size: 12px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.45px;
    }


    /* =========================================================
       INPUTS / SELECT
       ========================================================= */

    .form-container input,
    .form-container select {
        width: 100%;
        height: 44px;
        box-sizing: border-box;
        padding: 10px 13px;
        background: #ffffff;
        border: 1px solid #dbe3ea;
        border-radius: 10px;
        color: var(--text-main);
        font-family: inherit;
        font-size: 13.5px;
        outline: none;
        transition: border-color 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
    }

        .form-container input::placeholder {
            color: #94a3b8;
        }

        .form-container input:hover,
        .form-container select:hover {
            border-color: #cbd5e1;
        }

        .form-container input:focus,
        .form-container select:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.10);
            background: #ffffff;
        }


    /* =========================================================
       ROLE SECTIONS
       ========================================================= */

    .role-section {
        display: none;
        padding: 22px;
        margin-top: 22px;
        margin-bottom: 20px;
        border-radius: 14px;
        background: linear-gradient( 135deg, rgba(79, 70, 229, 0.035), rgba(14, 165, 233, 0.035) );
        border: 1px solid rgba(79, 70, 229, 0.12);
        box-sizing: border-box;
    }

        .role-section h4 {
            margin: 0 0 20px;
            color: var(--text-main);
            font-size: 16px;
            font-weight: 700;
            letter-spacing: -0.1px;
            padding-bottom: 12px;
            border-bottom: 1px solid var(--border-color);
        }

        .role-section .form-group:last-child {
            margin-bottom: 0;
        }


    /* =========================================================
       CREATE BUTTON
       ========================================================= */

    .btn-create {
        width: 100%;
        min-height: 46px;
        padding: 11px 20px;
        margin-top: 2px;
        background: linear-gradient( 135deg, var(--primary), var(--secondary) );
        color: white;
        border: none;
        border-radius: 11px;
        font-family: inherit;
        font-size: 13.5px;
        font-weight: 600;
        cursor: pointer;
        box-shadow: 0 5px 14px rgba(79, 70, 229, 0.18);
        transition: all 0.2s ease;
    }

        .btn-create:hover {
            background: linear-gradient( 135deg, var(--primary-hover), #0284c7 );
            transform: translateY(-2px);
            box-shadow: 0 8px 18px rgba(79, 70, 229, 0.23);
        }

        .btn-create:focus {
            outline: none;
            box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.12), 0 5px 14px rgba(79, 70, 229, 0.18);
        }


    /* =========================================================
       BACK LINK
       ========================================================= */

    .back-users {
        margin: 16px 0 0;
        text-align: center;
    }

        .back-users a {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-height: 40px;
            padding: 9px 17px;
            border-radius: 10px;
            background: #475569;
            color: white !important;
            text-decoration: none !important;
            font-size: 13px;
            font-weight: 600;
            transition: all 0.2s ease;
        }

            .back-users a:hover {
                background: #334155;
                color: white !important;
                text-decoration: none !important;
                transform: translateY(-1px);
            }


    /* =========================================================
       FORM VALIDATION
       ========================================================= */

    .field-validation-error {
        display: block;
        margin-top: 6px;
        color: #dc2626;
        font-size: 12px;
        font-weight: 500;
    }

    .input-validation-error {
        border-color: #ef4444 !important;
        box-shadow: 0 0 0 3px rgba(239, 68, 68, 0.08);
    }

    .validation-summary-errors {
        margin-bottom: 22px;
        padding: 14px 16px;
        border: 1px solid #fecaca;
        border-radius: 10px;
        background: #fef2f2;
        color: #b91c1c;
        font-size: 13px;
    }

        .validation-summary-errors ul {
            margin: 0;
            padding-left: 20px;
        }

        .validation-summary-errors li {
            margin-bottom: 4px;
        }

            .validation-summary-errors li:last-child {
                margin-bottom: 0;
            }

    .validation-message {
        display: block;
        margin-top: 6px;
        color: #dc2626;
        font-size: 12px;
        font-weight: 500;
    }

    .password-rules {
        margin-top: 8px;
        padding: 10px 12px;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        color: #64748b;
        font-size: 11.5px;
        line-height: 1.6;
    }


    /* =========================================================
       TABLET
       ========================================================= */

    @@media (max-width: 900px) {

        .create-user-page {
            max-width: 820px;
            padding: 30px 24px 40px;
        }

        .create-user-header {
            padding: 25px;
        }

        .form-container {
            padding: 25px;
        }
    }


    /* =========================================================
       MOBILE
       ========================================================= */

    @@media (max-width: 768px) {

        .create-user-page {
            padding: 95px 18px 30px;
        }

        .create-user-header {
            padding: 22px;
            border-radius: 15px;
            margin-bottom: 20px;
        }

            .create-user-header h2 {
                font-size: 20px;
            }

            .create-user-header p {
                font-size: 13px;
            }

        .form-container {
            padding: 20px;
            border-radius: 15px;
        }

        .role-section {
            padding: 18px;
        }
    }


    /* =========================================================
       SMALL PHONE
       ========================================================= */

    @@media (max-width: 480px) {

        .create-user-page {
            padding-left: 14px;
            padding-right: 14px;
        }

        .create-user-header {
            padding: 19px;
        }

            .create-user-header h2 {
                font-size: 18px;
            }

            .create-user-header p {
                font-size: 12.5px;
            }

        .form-container {
            padding: 17px;
        }

            .form-container label {
                font-size: 10.5px;
            }

            .form-container input,
            .form-container select {
                height: 42px;
                font-size: 13px;
            }

        .role-section {
            padding: 15px;
            border-radius: 12px;
        }

            .role-section h4 {
                font-size: 15px;
            }

        .btn-create {
            min-height: 44px;
        }

        .back-users a {
            width: 100%;
            box-sizing: border-box;
        }
    }
</style>


<!-- =========================================================
     CREATE USER PAGE
     ========================================================= -->

<div class="create-user-page">


    <!-- =====================================================
         HEADER
         ===================================================== -->

    <div class="create-user-header">

        <h2>
            Create Staff User
        </h2>

        <p>
            Create a new staff account and assign the appropriate
            hospital role and professional information.
        </p>

    </div>


    <!-- =====================================================
         FORM
         ===================================================== -->

    <div class="form-container">

        @using (Html.BeginForm(null, null, FormMethod.Post, new { id = "createUserForm", novalidate = "novalidate" }))
        {
            @Html.AntiForgeryToken()

            @Html.ValidationSummary(
                true,
                "Please correct the following errors:",
                new { @class = "validation-summary-errors" })


            <!-- =================================================
                 BASIC INFORMATION
                 ================================================= -->

            <div class="form-group">

                <label>
                    First Name
                </label>

                @Html.TextBoxFor(x => x.FirstName, new
                {
                    id = "FirstName",
                    maxlength = "50",
                    autocomplete = "given-name"
                })

                @Html.ValidationMessageFor(
                    x => x.FirstName,
                    "",
                    new { @class = "field-validation-error" })

                <span id="firstNameError"
                      class="validation-message"></span>

            </div>


            <div class="form-group">

                <label>
                    Last Name
                </label>

                @Html.TextBoxFor(x => x.LastName, new
                {
                    id = "LastName",
                    maxlength = "50",
                    autocomplete = "family-name"
                })

                @Html.ValidationMessageFor(
                    x => x.LastName,
                    "",
                    new { @class = "field-validation-error" })

                <span id="lastNameError"
                      class="validation-message"></span>

            </div>


            <div class="form-group">

                <label>
                    Email Address
                </label>

                @Html.TextBoxFor(x => x.Email, new
                {
                    id = "Email",
                    type = "email",
                    maxlength = "100",
                    autocomplete = "email"
                })

                @Html.ValidationMessageFor(
                    x => x.Email,
                    "",
                    new { @class = "field-validation-error" })

                <span id="emailError"
                      class="validation-message"></span>

            </div>


            <div class="form-group">

                <label>
                    Date Of Birth
                </label>

                @Html.TextBoxFor(
                    x => x.DateOfBirth,
                    "{0:yyyy-MM-dd}",
                    new
                    {
                        id = "DateOfBirth",
                        type = "date"
                    })

                @Html.ValidationMessageFor(
                    x => x.DateOfBirth,
                    "",
                    new { @class = "field-validation-error" })

                <span id="dateOfBirthError"
                      class="validation-message"></span>

            </div>


            <div class="form-group">

                <label>
                    Phone Number
                </label>

                @Html.TextBoxFor(x => x.PhoneNumber, new
                {
                    id = "PhoneNumber",
                    maxlength = "15",
                    autocomplete = "tel",
                    inputmode = "tel"
                })

                @Html.ValidationMessageFor(
                    x => x.PhoneNumber,
                    "",
                    new { @class = "field-validation-error" })

                <span id="phoneError"
                      class="validation-message"></span>

            </div>


            <!-- =================================================
                 ROLE
                 ================================================= -->

            <div class="form-group">

                <label>
                    Role
                </label>

                @Html.DropDownListFor(
                    x => x.RoleName,
                    new SelectList(new[]
                    {
                        "Doctor",
                        "Nurse",
                        "Pharmacist",
                        "Cleaner"
                    }),
                    "-- Select Role --",
                    new
                    {
                        id = "roleDropdown"
                    })

                @Html.ValidationMessageFor(
                    x => x.RoleName,
                    "",
                    new { @class = "field-validation-error" })

                <span id="roleError"
                      class="validation-message"></span>

            </div>


            <!-- =================================================
                 PASSWORD
                 ================================================= -->

            <div class="form-group">

                <label>
                    Create Password
                </label>

                @Html.PasswordFor(x => x.Password, new
                {
                    id = "Password",
                    maxlength = "100",
                    autocomplete = "new-password"
                })

                @Html.ValidationMessageFor(
                    x => x.Password,
                    "",
                    new { @class = "field-validation-error" })

                <div class="password-rules">
                    Password must contain at least 8 characters,
                    one uppercase letter, one lowercase letter,
                    one number, and one special character.
                </div>

                <span id="passwordError"
                      class="validation-message"></span>

            </div>


            <!-- =================================================
                 DOCTOR
                 ================================================= -->

            <div id="doctorSection"
                 class="role-section">

                <h4>
                    Doctor Information
                </h4>

                <div class="form-group">

                    <label>
                        Speciality
                    </label>

                    @Html.TextBoxFor(x => x.Speciality, new
                    {
                        id = "Speciality",
                        maxlength = "100"
                    })

                    @Html.ValidationMessageFor(
                        x => x.Speciality,
                        "",
                        new { @class = "field-validation-error" })

                    <span id="specialityError"
                          class="validation-message"></span>

                </div>

                <div class="form-group">

                    <label>
                        Qualification
                    </label>

                    @Html.TextBoxFor(x => x.Qualification, new
                    {
                        id = "Qualification",
                        maxlength = "150"
                    })

                    @Html.ValidationMessageFor(
                        x => x.Qualification,
                        "",
                        new { @class = "field-validation-error" })

                    <span id="qualificationError"
                          class="validation-message"></span>

                </div>

                <div class="form-group">

                    <label>
                        Office Number
                    </label>

                    @Html.TextBoxFor(x => x.OfficeNumber, new
                    {
                        id = "OfficeNumber",
                        maxlength = "50"
                    })

                    @Html.ValidationMessageFor(
                        x => x.OfficeNumber,
                        "",
                        new { @class = "field-validation-error" })

                    <span id="officeNumberError"
                          class="validation-message"></span>

                </div>

            </div>


            <!-- =================================================
                 NURSE
                 ================================================= -->

            <div id="nurseSection"
                 class="role-section">

                <h4>
                    Nurse Information
                </h4>

                <div class="form-group">

                    <label>
                        Ward Assigned
                    </label>

                    @Html.TextBoxFor(x => x.WardAssigned, new
                    {
                        id = "WardAssigned",
                        maxlength = "100"
                    })

                    @Html.ValidationMessageFor(
                        x => x.WardAssigned,
                        "",
                        new { @class = "field-validation-error" })

                    <span id="wardError"
                          class="validation-message"></span>

                </div>

                <div class="form-group">

                    <label>
                        Shift Type
                    </label>

                    @Html.TextBoxFor(x => x.ShiftType, new
                    {
                        id = "NurseShiftType",
                        maxlength = "50"
                    })

                    @Html.ValidationMessageFor(
                        x => x.ShiftType,
                        "",
                        new { @class = "field-validation-error" })

                    <span id="nurseShiftError"
                          class="validation-message"></span>

                </div>

            </div>


            <!-- =================================================
                 PHARMACIST
                 ================================================= -->

            <div id="pharmacistSection"
                 class="role-section">

                <h4>
                    Pharmacist Information
                </h4>

                <div class="form-group">

                    <label>
                        License Number
                    </label>

                    @Html.TextBoxFor(x => x.LicenseNumber, new
                    {
                        id = "LicenseNumber",
                        maxlength = "100"
                    })

                    @Html.ValidationMessageFor(
                        x => x.LicenseNumber,
                        "",
                        new { @class = "field-validation-error" })

                    <span id="licenseError"
                          class="validation-message"></span>

                </div>

            </div>


            <!-- =================================================
                 CLEANER
                 ================================================= -->

            <div id="cleanerSection"
                 class="role-section">

                <h4>
                    Cleaner Information
                </h4>

                <div class="form-group">

                    <label>
                        Area Assigned
                    </label>

                    @Html.TextBoxFor(x => x.AreaAssigned, new
                    {
                        id = "AreaAssigned",
                        maxlength = "100"
                    })

                    @Html.ValidationMessageFor(
                        x => x.AreaAssigned,
                        "",
                        new { @class = "field-validation-error" })

                    <span id="areaError"
                          class="validation-message"></span>

                </div>

                <div class="form-group">

                    <label>
                        Shift Type
                    </label>

                    @Html.DropDownListFor(
                        x => x.ShiftType,
                        new SelectList(new[]
                        {
                            "Morning Shift",
                            "Afternoon Shift",
                            "Night Shift"
                        }),
                        "-- Select Shift --",
                        new
                        {
                            id = "CleanerShiftType"
                        })

                    @Html.ValidationMessageFor(
                        x => x.ShiftType,
                        "",
                        new { @class = "field-validation-error" })

                    <span id="cleanerShiftError"
                          class="validation-message"></span>

                </div>

            </div>


            <!-- =================================================
                 CREATE
                 ================================================= -->

            <button type="submit"
                    class="btn-create">

                Create User

            </button>


            <!-- =================================================
                 BACK
                 ================================================= -->

            <div class="back-users">

                @Html.ActionLink(
                    "Back to Users",
                    "Index",
                    "Users")

            </div>

        }

    </div>

</div>


<script>

    const roleDropdown =
        document.getElementById('roleDropdown');

    const doctorSection =
        document.getElementById('doctorSection');

    const nurseSection =
        document.getElementById('nurseSection');

    const pharmacistSection =
        document.getElementById('pharmacistSection');

    const cleanerSection =
        document.getElementById('cleanerSection');


    function hideAllSections() {

        doctorSection.style.display = 'none';

        nurseSection.style.display = 'none';

        pharmacistSection.style.display = 'none';

        cleanerSection.style.display = 'none';

    }


    roleDropdown.addEventListener(
        'change',
        function () {

            hideAllSections();


            if (this.value === 'Doctor') {

                doctorSection.style.display =
                    'block';

            }


            if (this.value === 'Nurse') {

                nurseSection.style.display =
                    'block';

            }


            if (this.value === 'Pharmacist') {

                pharmacistSection.style.display =
                    'block';

            }


            if (this.value === 'Cleaner') {

                cleanerSection.style.display =
                    'block';

            }

        }
    );


    hideAllSections();


    /* =========================================================
       CLIENT-SIDE VALIDATION
       ========================================================= */

    const form =
        document.getElementById('createUserForm');


    function showError(input, errorElement, message) {

        input.classList.add('input-validation-error');

        errorElement.textContent = message;

    }


    function clearError(input, errorElement) {

        input.classList.remove('input-validation-error');

        errorElement.textContent = '';

    }


    function validateName(value) {

        return /^[A-Za-zÀ-ÿ\s'-]+$/.test(value);

    }


    function validateEmail(value) {

        return /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/.test(value);

    }


    function validatePhone(value) {

        return /^(?:\+27|0)[6-8][0-9]{8}$/.test(
            value.replace(/\s+/g, '')
        );

    }


    function validatePassword(value) {

        return value.length >= 8 &&
            /[A-Z]/.test(value) &&
            /[a-z]/.test(value) &&
            /[0-9]/.test(value) &&
            /[^A-Za-z0-9]/.test(value);

    }


    function validateField(
        input,
        errorElement,
        message,
        condition) {

        if (!condition) {

            showError(
                input,
                errorElement,
                message
            );

            return false;

        }

        clearError(
            input,
            errorElement
        );

        return true;

    }


    form.addEventListener(
        'submit',
        function (event) {

            let valid = true;


            /* =================================================
               FIRST NAME
               ================================================= */

            const firstName =
                document.getElementById('FirstName');

            const firstNameError =
                document.getElementById('firstNameError');

            const firstNameValue =
                firstName.value.trim();


            if (firstNameValue === '') {

                showError(
                    firstName,
                    firstNameError,
                    'First name is required.'
                );

                valid = false;

            }
            else if (!validateName(firstNameValue)) {

                showError(
                    firstName,
                    firstNameError,
                    'First name may contain letters, spaces, apostrophes and hyphens only.'
                );

                valid = false;

            }
            else {

                clearError(
                    firstName,
                    firstNameError
                );

            }


            /* =================================================
               LAST NAME
               ================================================= */

            const lastName =
                document.getElementById('LastName');

            const lastNameError =
                document.getElementById('lastNameError');

            const lastNameValue =
                lastName.value.trim();


            if (lastNameValue === '') {

                showError(
                    lastName,
                    lastNameError,
                    'Last name is required.'
                );

                valid = false;

            }
            else if (!validateName(lastNameValue)) {

                showError(
                    lastName,
                    lastNameError,
                    'Last name may contain letters, spaces, apostrophes and hyphens only.'
                );

                valid = false;

            }
            else {

                clearError(
                    lastName,
                    lastNameError
                );

            }


            /* =================================================
               EMAIL
               ================================================= */

            const email =
                document.getElementById('Email');

            const emailError =
                document.getElementById('emailError');

            const emailValue =
                email.value.trim();


            if (emailValue === '') {

                showError(
                    email,
                    emailError,
                    'Email address is required.'
                );

                valid = false;

            }
            else if (!validateEmail(emailValue)) {

                showError(
                    email,
                    emailError,
                    'Please enter a valid email address.'
                );

                valid = false;

            }
            else {

                clearError(
                    email,
                    emailError
                );

            }


            /* =================================================
               DATE OF BIRTH
               ================================================= */

            const dateOfBirth =
                document.getElementById('DateOfBirth');

            const dateOfBirthError =
                document.getElementById('dateOfBirthError');

            const dateValue =
                dateOfBirth.value;


            if (dateValue === '') {

                showError(
                    dateOfBirth,
                    dateOfBirthError,
                    'Date of birth is required.'
                );

                valid = false;

            }
            else {

                const dob =
                    new Date(dateValue);

                const today =
                    new Date();

                today.setHours(0, 0, 0, 0);


                if (dob > today) {

                    showError(
                        dateOfBirth,
                        dateOfBirthError,
                        'Date of birth cannot be in the future.'
                    );

                    valid = false;

                }
                else {

                    clearError(
                        dateOfBirth,
                        dateOfBirthError
                    );

                }

            }


            /* =================================================
               PHONE
               ================================================= */

            const phone =
                document.getElementById('PhoneNumber');

            const phoneError =
                document.getElementById('phoneError');

            const phoneValue =
                phone.value.trim();


            if (phoneValue === '') {

                showError(
                    phone,
                    phoneError,
                    'Phone number is required.'
                );

                valid = false;

            }
            else if (!validatePhone(phoneValue)) {

                showError(
                    phone,
                    phoneError,
                    'Please enter a valid South African phone number, for example 0821234567 or +27821234567.'
                );

                valid = false;

            }
            else {

                clearError(
                    phone,
                    phoneError
                );

            }


            /* =================================================
               ROLE
               ================================================= */

            const role =
                roleDropdown.value;

            const roleError =
                document.getElementById('roleError');


            if (role === '') {

                showError(
                    roleDropdown,
                    roleError,
                    'Please select a staff role.'
                );

                valid = false;

            }
            else {

                clearError(
                    roleDropdown,
                    roleError
                );

            }


            /* =================================================
               PASSWORD
               ================================================= */

            const password =
                document.getElementById('Password');

            const passwordError =
                document.getElementById('passwordError');

            const passwordValue =
                password.value;


            if (passwordValue === '') {

                showError(
                    password,
                    passwordError,
                    'Password is required.'
                );

                valid = false;

            }
            else if (!validatePassword(passwordValue)) {

                showError(
                    password,
                    passwordError,
                    'Password must contain at least 8 characters, one uppercase letter, one lowercase letter, one number and one special character.'
                );

                valid = false;

            }
            else {

                clearError(
                    password,
                    passwordError
                );

            }


            /* =================================================
               DOCTOR VALIDATION
               ================================================= */

            if (role === 'Doctor') {

                const speciality =
                    document.getElementById('Speciality');

                const specialityError =
                    document.getElementById('specialityError');


                if (speciality.value.trim() === '') {

                    showError(
                        speciality,
                        specialityError,
                        'Speciality is required for a doctor.'
                    );

                    valid = false;

                }
                else {

                    clearError(
                        speciality,
                        specialityError
                    );

                }


                const qualification =
                    document.getElementById('Qualification');

                const qualificationError =
                    document.getElementById('qualificationError');


                if (qualification.value.trim() === '') {

                    showError(
                        qualification,
                        qualificationError,
                        'Qualification is required for a doctor.'
                    );

                    valid = false;

                }
                else {

                    clearError(
                        qualification,
                        qualificationError
                    );

                }


                const officeNumber =
                    document.getElementById('OfficeNumber');

                const officeNumberError =
                    document.getElementById('officeNumberError');


                if (officeNumber.value.trim() === '') {

                    showError(
                        officeNumber,
                        officeNumberError,
                        'Office number is required for a doctor.'
                    );

                    valid = false;

                }
                else {

                    clearError(
                        officeNumber,
                        officeNumberError
                    );

                }

            }


            /* =================================================
               NURSE VALIDATION
               ================================================= */

            if (role === 'Nurse') {

                const ward =
                    document.getElementById('WardAssigned');

                const wardError =
                    document.getElementById('wardError');


                if (ward.value.trim() === '') {

                    showError(
                        ward,
                        wardError,
                        'Ward assigned is required for a nurse.'
                    );

                    valid = false;

                }
                else {

                    clearError(
                        ward,
                        wardError
                    );

                }


                const nurseShift =
                    document.getElementById('NurseShiftType');

                const nurseShiftError =
                    document.getElementById('nurseShiftError');


                if (nurseShift.value.trim() === '') {

                    showError(
                        nurseShift,
                        nurseShiftError,
                        'Shift type is required for a nurse.'
                    );

                    valid = false;

                }
                else {

                    clearError(
                        nurseShift,
                        nurseShiftError
                    );

                }

            }


            /* =================================================
               PHARMACIST VALIDATION
               ================================================= */

            if (role === 'Pharmacist') {

                const license =
                    document.getElementById('LicenseNumber');

                const licenseError =
                    document.getElementById('licenseError');


                if (license.value.trim() === '') {

                    showError(
                        license,
                        licenseError,
                        'License number is required for a pharmacist.'
                    );

                    valid = false;

                }
                else {

                    clearError(
                        license,
                        licenseError
                    );

                }

            }


            /* =================================================
               CLEANER VALIDATION
               ================================================= */

            if (role === 'Cleaner') {

                const area =
                    document.getElementById('AreaAssigned');

                const areaError =
                    document.getElementById('areaError');


                if (area.value.trim() === '') {

                    showError(
                        area,
                        areaError,
                        'Area assigned is required for a cleaner.'
                    );

                    valid = false;

                }
                else {

                    clearError(
                        area,
                        areaError
                    );

                }


                const cleanerShift =
                    document.getElementById('CleanerShiftType');

                const cleanerShiftError =
                    document.getElementById('cleanerShiftError');


                if (cleanerShift.value.trim() === '') {

                    showError(
                        cleanerShift,
                        cleanerShiftError,
                        'Shift type is required for a cleaner.'
                    );

                    valid = false;

                }
                else {

                    clearError(
                        cleanerShift,
                        cleanerShiftError
                    );

                }

            }


            /* =================================================
               STOP FORM IF INVALID
               ================================================= */

            if (!valid) {

                event.preventDefault();

                const firstError =
                    document.querySelector(
                        '.input-validation-error'
                    );

                if (firstError) {

                    firstError.focus();

                    firstError.scrollIntoView({
                        behavior: 'smooth',
                        block: 'center'
                    });

                }

            }

        }
    );


    /* =========================================================
       REMOVE CLIENT ERROR WHEN USER CORRECTS FIELD
       ========================================================= */

    document.querySelectorAll(
        '#createUserForm input, #createUserForm select'
    ).forEach(function (input) {

        input.addEventListener(
            'input',
            function () {

                this.classList.remove(
                    'input-validation-error'
                );

                const error =
                    this.parentElement.querySelector(
                        '.validation-message'
                    );

                if (error) {

                    error.textContent = '';

                }

            }
        );


        input.addEventListener(
            'change',
            function () {

                this.classList.remove(
                    'input-validation-error'
                );

                const error =
                    this.parentElement.querySelector(
                        '.validation-message'
                    );

                if (error) {

                    error.textContent = '';

                }

            }
        );

    });

</script>

