@model ElderlyCareHospital.Models.User

@{
    ViewBag.Title = "Delete";
}

<style>
    body {
        background: #f4f8fb;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .delete-wrapper {
        max-width: 760px;
        margin: 40px auto;
    }

    .delete-header {
        background: linear-gradient(135deg, #c62828, #d84315);
        color: white;
        padding: 28px 32px;
        border-radius: 18px;
        margin-bottom: 24px;
        box-shadow: 0 8px 20px rgba(198, 40, 40, 0.18);
        text-align: center;
    }

        .delete-header h2 {
            margin: 0;
            font-weight: 700;
            font-size: 30px;
        }

        .delete-header p {
            margin-top: 10px;
            opacity: 0.96;
            line-height: 1.6;
            font-size: 15px;
        }

    .delete-card {
        background: white;
        border-radius: 18px;
        padding: 30px;
        box-shadow: 0 6px 18px rgba(0,0,0,0.08);
    }

    .warning-box {
        background: #fff4f4;
        border-left: 4px solid #d84315;
        border-radius: 10px;
        padding: 14px 18px;
        color: #6d3b3b;
        margin-bottom: 24px;
        line-height: 1.6;
    }

    .section-title {
        color: #2f6f73;
        font-weight: 700;
        margin-bottom: 20px;
        padding-bottom: 10px;
        border-bottom: 2px solid #e8eef2;
    }

    .details-table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 26px;
    }

        .details-table th {
            width: 35%;
            padding: 14px 16px;
            text-align: left;
            background: #f8fbfc;
            color: #2f6f73;
            font-weight: 700;
            border-bottom: 1px solid #e8eef2;
        }

        .details-table td {
            padding: 14px 16px;
            border-bottom: 1px solid #e8eef2;
            color: #37474f;
        }

    .form-actions {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 14px;
        flex-wrap: wrap;
        margin-top: 10px;
    }

    .btn-delete {
        background: linear-gradient(135deg, #c62828, #d84315);
        border: none;
        color: white;
        border-radius: 10px;
        padding: 11px 24px;
        font-weight: 700;
        min-width: 140px;
        transition: 0.2s ease;
    }

        .btn-delete:hover {
            background: linear-gradient(135deg, #b71c1c, #bf360c);
            color: white;
            transform: translateY(-1px);
        }

    .back-link {
        display: inline-block;
        padding: 10px 18px;
        background: #455a64;
        color: white !important;
        border-radius: 10px;
        text-decoration: none;
        font-weight: 600;
        transition: 0.2s ease;
    }

        .back-link:hover {
            background: #263238;
            text-decoration: none;
        }

    @@media (max-width: 768px) {
        .delete-card {
            padding: 22px;
        }

        .details-table th,
        .details-table td {
            display: block;
            width: 100%;
        }

        .details-table th {
            border-bottom: none;
            padding-bottom: 6px;
        }

        .details-table td {
            padding-top: 0;
            margin-bottom: 10px;
        }
    }
</style>

<div class="container delete-wrapper">

   
    <div class="delete-header">
        <h2>Delete User</h2>
        <p>
            Review the selected user information carefully before permanently removing the account from the Elderly Care Hospital Management System.
        </p>
    </div>

    <div class="delete-card">

        <div class="warning-box">
            <strong>Confirmation Required:</strong> This action will permanently delete the selected user record. Please ensure that the account is no longer required before continuing.
        </div>

        <h4 class="section-title">User Details</h4>

        <table class="details-table">
            <tr>
                <th>@Html.DisplayNameFor(model => model.FirstName)</th>
                <td>@Html.DisplayFor(model => model.FirstName)</td>
            </tr>

            <tr>
                <th>@Html.DisplayNameFor(model => model.LastName)</th>
                <td>@Html.DisplayFor(model => model.LastName)</td>
            </tr>

            <tr>
                <th>@Html.DisplayNameFor(model => model.Email)</th>
                <td>@Html.DisplayFor(model => model.Email)</td>
            </tr>

            <tr>
                <th>@Html.DisplayNameFor(model => model.DateOfBirth)</th>
                <td>@Html.DisplayFor(model => model.DateOfBirth)</td>
            </tr>
        </table>

        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()

            <div class="form-actions no-color">

                <input type="submit"
                       value="Delete User"
                       class="btn btn-delete" />

                @Html.ActionLink(
                    "Back to List",
                    "Index",
                    null,
                    new { @class = "back-link" })

            </div>
        }

    </div>
   

</div>
