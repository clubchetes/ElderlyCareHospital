@using Microsoft.AspNet.Identity.EntityFramework
@model IEnumerable<IdentityUser>

@{
    ViewBag.Title = "Manage Users";
}

<style>

    /* =========================================================
       ROOT / ELDERLYCARE HOSPITAL THEME
       ========================================================= */

    :root {
        --app-bg: #f8fafc;
        --surface: #ffffff;
        --surface-soft: #f8fbfd;
        --text-main: #0f172a;
        --text-muted: #64748b;
        --primary: #4f46e5;
        --primary-hover: #4338ca;
        --secondary: #0ea5e9;
        --border-color: #e2e8f0;
        --danger: #dc2626;
        --danger-hover: #b91c1c;
    }


    /* =========================================================
       PAGE
       ========================================================= */

    html,
    body {
        margin: 0;
        padding: 0;
        min-height: 100%;
    }

    body {
        background: var(--app-bg);
        font-family: 'Inter', 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        color: var(--text-main);
        overflow-x: hidden;
    }


    /* =========================================================
       MAIN CONTAINER
       ========================================================= */

    .users-page {
        width: 100%;
        max-width: 1400px;
        margin: 0 auto;
        padding: 36px 40px 45px;
        box-sizing: border-box;
    }


    /* =========================================================
       PAGE HEADER
       ========================================================= */

    .users-header {
        background: var(--surface);
        color: var(--text-main);
        padding: 28px 34px;
        border-radius: 18px;
        margin-bottom: 26px;
        border: 1px solid var(--border-color);
        box-shadow: 0 4px 20px rgba(15, 23, 42, 0.03);
    }

        .users-header h2 {
            margin: 0;
            font-weight: 700;
            font-size: 24px;
            letter-spacing: -0.3px;
            line-height: 1.3;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 15px;
        }

        .users-header p {
            margin: 8px 0 0;
            color: var(--text-muted);
            font-size: 14px;
            line-height: 1.6;
        }


    /* =========================================================
       LIVE SYNC BADGE
       ========================================================= */

    .live-sync-badge {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 7px 12px;
        border-radius: 20px;
        background: rgba(16, 185, 129, 0.08);
        border: 1px solid rgba(16, 185, 129, 0.15);
        color: #059669;
        font-size: 11px;
        font-weight: 600;
        white-space: nowrap;
        letter-spacing: 0.2px;
    }

    .live-sync-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: #10b981;
        box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.10);
    }


    /* =========================================================
       MAIN PANEL
       ========================================================= */

    .users-panel {
        background: var(--surface);
        border-radius: 18px;
        padding: 24px;
        border: 1px solid var(--border-color);
        box-shadow: 0 4px 18px rgba(15, 23, 42, 0.025);
        box-sizing: border-box;
    }


    /* =========================================================
       TOOLBAR
       ========================================================= */

    .toolbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 22px;
        flex-wrap: wrap;
        gap: 14px;
    }


    /* =========================================================
       CREATE USER BUTTON
       ========================================================= */

    .create-user-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 42px;
        padding: 10px 18px;
        background: linear-gradient(135deg, var(--primary), var(--secondary));
        border: none;
        border-radius: 10px;
        color: white !important;
        text-decoration: none !important;
        font-size: 13px;
        font-weight: 600;
        box-shadow: 0 4px 12px rgba(79, 70, 229, 0.18);
        transition: all 0.2s ease;
        box-sizing: border-box;
    }

        .create-user-btn:hover {
            background: linear-gradient(135deg, var(--primary-hover), #0284c7);
            color: white !important;
            text-decoration: none !important;
            transform: translateY(-2px);
            box-shadow: 0 7px 17px rgba(79, 70, 229, 0.22);
        }


    /* =========================================================
       FILTER BAR
       ========================================================= */

    .filter-bar {
        display: flex;
        flex-wrap: wrap;
        gap: 14px;
        align-items: flex-end;
        width: 100%;
        margin-bottom: 0;
        padding: 18px;
        background: var(--surface-soft);
        border: 1px solid var(--border-color);
        border-radius: 14px;
        box-sizing: border-box;
    }

    .filter-group {
        display: flex;
        flex-direction: column;
        min-width: 220px;
        flex: 1 1 220px;
    }

        .filter-group label {
            font-size: 11px;
            font-weight: 700;
            color: var(--text-muted);
            margin-bottom: 7px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }


    /* =========================================================
       FILTER INPUTS
       ========================================================= */

    .filter-input {
        width: 100%;
        height: 42px;
        box-sizing: border-box;
        background: #ffffff;
        border: 1px solid #dbe3ea;
        border-radius: 10px;
        padding: 9px 12px;
        color: var(--text-main);
        font-size: 13px;
        outline: none;
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }

        .filter-input::placeholder {
            color: #94a3b8;
        }

        .filter-input:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.10);
        }


    /* =========================================================
       FILTER BUTTON
       ========================================================= */

    .btn-filter {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        height: 42px;
        padding: 10px 18px;
        background: var(--primary);
        color: white;
        border: none;
        border-radius: 10px;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        white-space: nowrap;
        transition: all 0.2s ease;
        box-shadow: 0 4px 10px rgba(79, 70, 229, 0.12);
    }

        .btn-filter:hover {
            background: var(--primary-hover);
            transform: translateY(-1px);
            box-shadow: 0 6px 14px rgba(79, 70, 229, 0.18);
        }

        .btn-filter:focus {
            outline: none;
        }


    /* =========================================================
       CLEAR BUTTON
       ========================================================= */

    .btn-clear {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        height: 42px;
        box-sizing: border-box;
        padding: 10px 18px;
        background: #475569;
        color: white !important;
        border-radius: 10px;
        text-decoration: none !important;
        font-size: 13px;
        font-weight: 600;
        white-space: nowrap;
        transition: all 0.2s ease;
    }

        .btn-clear:hover {
            background: #334155;
            color: white !important;
            text-decoration: none !important;
            transform: translateY(-1px);
        }


    /* =========================================================
       TABLE WRAPPER
       ========================================================= */

    .users-table-wrapper {
        border: 1px solid var(--border-color);
        border-radius: 14px;
        overflow: hidden;
        background: #ffffff;
    }


    /* =========================================================
       USERS TABLE
       ========================================================= */

    .table {
        margin-bottom: 0;
        border: none;
        width: 100%;
    }

        .table thead {
            background: #f8fafc;
            color: var(--text-main);
        }

            .table thead tr {
                border-bottom: 1px solid var(--border-color);
            }

        .table th {
            border: none !important;
            padding: 14px 16px;
            font-weight: 700;
            font-size: 11px;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.6px;
            white-space: nowrap;
        }

        .table td {
            padding: 15px 16px;
            vertical-align: middle;
            border-top: 1px solid #edf2f7 !important;
            border-bottom: none !important;
            font-size: 13.5px;
            color: var(--text-main);
        }

        .table tbody tr {
            transition: background-color 0.15s ease;
        }

            .table tbody tr:hover {
                background: #f8fbff;
            }


    /* =========================================================
       ROLE BADGES
       ========================================================= */

    .role-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 6px 12px;
        background: rgba(79, 70, 229, 0.08);
        color: var(--primary);
        border: 1px solid rgba(79, 70, 229, 0.10);
        border-radius: 20px;
        font-size: 11px;
        font-weight: 700;
        white-space: nowrap;
    }

    .no-role {
        background: #f1f5f9;
        color: var(--text-muted);
        border-color: #e2e8f0;
    }


    /* =========================================================
       DELETE BUTTON
       ========================================================= */

    .delete-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 34px;
        padding: 7px 14px;
        border-radius: 9px;
        background: linear-gradient(135deg, #dc2626, #ef4444);
        color: white !important;
        text-decoration: none !important;
        font-weight: 600;
        font-size: 12px;
        letter-spacing: 0.1px;
        box-shadow: 0 3px 9px rgba(220, 38, 38, 0.16);
        transition: all 0.2s ease;
        white-space: nowrap;
    }

        .delete-btn:hover {
            background: linear-gradient(135deg, var(--danger-hover), #dc2626);
            color: white !important;
            text-decoration: none !important;
            transform: translateY(-1px);
            box-shadow: 0 5px 13px rgba(220, 38, 38, 0.23);
        }


    /* =========================================================
       BACK TO DASHBOARD
       ========================================================= */

    .back-link {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 42px;
        margin-top: 22px;
        padding: 10px 18px;
        box-sizing: border-box;
        background: #475569;
        color: white !important;
        border-radius: 10px;
        text-decoration: none !important;
        font-size: 13px;
        font-weight: 600;
        transition: all 0.2s ease;
        box-shadow: 0 4px 10px rgba(15, 23, 42, 0.08);
    }

        .back-link:hover {
            background: #334155;
            color: white !important;
            text-decoration: none !important;
            transform: translateY(-2px);
            box-shadow: 0 6px 14px rgba(15, 23, 42, 0.12);
        }


    /* =========================================================
       TABLET
       ========================================================= */

    @@media (max-width: 1200px) {

        .users-page {
            padding-left: 30px;
            padding-right: 30px;
        }

        .filter-group {
            min-width: 200px;
        }
    }


    /* =========================================================
       SMALL TABLET
       ========================================================= */

    @@media (max-width: 900px) {

        .users-page {
            padding: 30px 24px 40px;
        }

        .users-header {
            padding: 25px;
        }

        .users-panel {
            padding: 20px;
        }

        .filter-group {
            min-width: 200px;
            flex: 1 1 calc(50% - 14px);
        }
    }


    /* =========================================================
       MOBILE
       ========================================================= */

    @@media (max-width: 768px) {

        .users-page {
            padding: 95px 18px 30px;
        }

        .users-header {
            padding: 22px;
            border-radius: 15px;
            margin-bottom: 22px;
        }

            .users-header h2 {
                font-size: 20px;
                align-items: flex-start;
            }

            .users-header p {
                font-size: 13px;
            }

        .live-sync-badge {
            font-size: 10px;
            padding: 6px 9px;
        }

        .users-panel {
            padding: 16px;
            border-radius: 15px;
        }

        .toolbar {
            align-items: stretch;
        }

            .toolbar > div:last-child {
                width: 100%;
            }

        .create-user-btn {
            width: 100%;
        }

        .filter-bar {
            padding: 15px;
            gap: 12px;
        }

        .filter-group {
            min-width: 100%;
            flex: 1 1 100%;
        }

        .btn-filter,
        .btn-clear {
            width: 100%;
        }

        .users-table-wrapper {
            border-radius: 12px;
        }

        .table th,
        .table td {
            padding: 12px 13px;
            font-size: 12px;
        }

        .table th {
            font-size: 10px;
        }

        .delete-btn {
            min-height: 32px;
            padding: 6px 11px;
            font-size: 11px;
        }

        .back-link {
            width: 100%;
        }
    }


    /* =========================================================
       SMALL PHONE
       ========================================================= */

    @@media (max-width: 480px) {

        .users-page {
            padding-left: 14px;
            padding-right: 14px;
        }

        .users-header {
            padding: 19px;
        }

            .users-header h2 {
                font-size: 18px;
                flex-direction: column;
                align-items: flex-start;
                gap: 10px;
            }

            .users-header p {
                font-size: 12.5px;
            }

        .users-panel {
            padding: 13px;
        }

        .filter-bar {
            padding: 13px;
        }

        .table th,
        .table td {
            padding: 11px 10px;
        }

        .role-badge {
            padding: 5px 9px;
            font-size: 10px;
        }
    }
</style>


<!-- =========================================================
     USERS PAGE
     ========================================================= -->

<div class="users-page">


    <!-- =====================================================
         HEADER
         ===================================================== -->

    <div class="users-header">

        <h2>

            <span>
                Manage Users
            </span>

            <span class="live-sync-badge">

                <span class="live-sync-dot"></span>

                Live Sync Active

            </span>

        </h2>

        <p>
            View, create, and manage user accounts and assigned roles
            within the Elderly Care Hospital system.
        </p>

    </div>


    <!-- =====================================================
         MAIN PANEL
         ===================================================== -->

    <div class="users-panel">


        <!-- =================================================
             TOOLBAR
             ================================================= -->

        <div class="toolbar">

            <div></div>


            @using (Html.BeginForm("Index", "Users", FormMethod.Get))
            {

                <!-- =========================================
                     FILTER BAR
                     ========================================= -->

                <div class="filter-bar">

                    <div class="filter-group">

                        <label>
                            Search User
                        </label>

                        <input type="text"
                               name="searchString"
                               id="searchStringInput"
                               value="@Request.QueryString["searchString"]"
                               class="filter-input"
                               placeholder="Search by email or username..." />

                    </div>


                    <div class="filter-group">

                        <label>
                            Role
                        </label>

                        <select name="roleFilter"
                                id="roleFilterSelect"
                                class="filter-input">

                            <option value="">
                                All Roles
                            </option>

                            <option value="Admin"
                                    @(Request.QueryString["roleFilter"] == "Admin" ? "selected" : "")>
                                Admin
                            </option>

                            <option value="Doctor"
                                    @(Request.QueryString["roleFilter"] == "Doctor" ? "selected" : "")>
                                Doctor
                            </option>

                            <option value="Nurse"
                                    @(Request.QueryString["roleFilter"] == "Nurse" ? "selected" : "")>
                                Nurse
                            </option>

                            <option value="Pharmacist"
                                    @(Request.QueryString["roleFilter"] == "Pharmacist" ? "selected" : "")>
                                Pharmacist
                            </option>

                            <option value="Cleaner"
                                    @(Request.QueryString["roleFilter"] == "Cleaner" ? "selected" : "")>
                                Cleaner
                            </option>

                            <option value="FamilyMember"
                                    @(Request.QueryString["roleFilter"] == "FamilyMember" ? "selected" : "")>
                                Family Member
                            </option>

                        </select>

                    </div>


                    <button type="submit"
                            class="btn-filter">

                        Apply Filters

                    </button>


                    @Html.ActionLink(
                        "Clear",
                        "Index",
                        "Users",
                        null,
                        new { @class = "btn-clear" })

                </div>

            }


            <!-- =================================================
                 CREATE USER
                 ================================================= -->

            <div>

                @Html.ActionLink(
                    "Create User",
                    "Create",
                    null,
                    new { @class = "create-user-btn" })

            </div>

        </div>


        <!-- =================================================
             USERS TABLE
             ================================================= -->

        <div class="users-table-wrapper">

            <div class="table-responsive">

                <table class="table">

                    <thead>

                        <tr>

                            <th>
                                Email
                            </th>

                            <th>
                                Username
                            </th>

                            <th>
                                Role
                            </th>

                            <th>
                                Action
                            </th>

                        </tr>

                    </thead>

                    <tbody id="liveUserBody">

                        @Html.Partial(
                            "_UserRows",
                            Model)

                    </tbody>

                </table>

            </div>

        </div>

    </div>


    <!-- =====================================================
         BACK TO DASHBOARD
         ===================================================== -->

    <p>

        @Html.ActionLink(
            "Back to Dashboard",
            "Dashboard",
            "Admin",
            null,
            new { @class = "back-link" })

    </p>

</div>


@section Scripts {

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <script>

        function refreshUsers() {

            var currentSearch =
                $('#searchStringInput').val();

            var currentRole =
                $('#roleFilterSelect').val();


            $.ajax({

                url:
                    '@Url.Action("GetLiveUsers", "Users")',

                type: 'GET',

                data: {
                    searchString: currentSearch,
                    roleFilter: currentRole
                },

                success:
                    function (data) {

                        $('#liveUserBody')
                            .html(data);

                    }

            });

        }


        // Polls the server every 5 seconds while keeping
        // active filter parameters intact

        setInterval(
            refreshUsers,
            5000
        );

    </script>

}