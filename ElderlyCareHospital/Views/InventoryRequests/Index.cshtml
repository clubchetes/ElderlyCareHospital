@model IEnumerable<ElderlyCareHospital.Models.InventoryRequest>

<style>

    /* =========================================================
       ELDERLYCARE HOSPITAL THEME
       ========================================================= */

    :root {
        --app-bg: #f8fafc;
        --surface: #ffffff;
        --surface-soft: #f8fbfd;
        --text-main: #0f172a;
        --text-muted: #64748b;
        --primary: #4f46e5;
        --primary-hover: #4338ca;
        --secondary: #0ea5e9;
        --border-color: #e2e8f0;
        --success: #059669;
        --danger: #dc2626;
    }


    /* =========================================================
       PAGE
       ========================================================= */

    html,
    body {
        margin: 0;
        padding: 0;
        min-height: 100%;
    }

    body {
        background: var(--app-bg);
        font-family: 'Inter', 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        color: var(--text-main);
        overflow-x: hidden;
    }


    /* =========================================================
       MAIN CONTAINER
       ========================================================= */

    .inventory-page {
        width: 100%;
        max-width: 1400px;
        margin: 0 auto;
        padding: 36px 40px 45px;
        box-sizing: border-box;
    }


    /* =========================================================
       HEADER
       ========================================================= */

    .requests-header {
        background: var(--surface);
        color: var(--text-main);
        padding: 28px 34px;
        border-radius: 18px;
        margin-bottom: 24px;
        border: 1px solid var(--border-color);
        box-shadow: 0 4px 20px rgba(15, 23, 42, 0.04);
        position: relative;
        overflow: hidden;
    }

        .requests-header::after {
            content: "";
            position: absolute;
            width: 180px;
            height: 180px;
            right: -70px;
            top: -90px;
            border-radius: 50%;
            background: rgba(79, 70, 229, 0.05);
            pointer-events: none;
        }

        .requests-header h2 {
            margin: 0;
            font-weight: 700;
            font-size: 24px;
            color: var(--text-main);
            letter-spacing: -0.3px;
            line-height: 1.3;
        }

        .requests-header p {
            margin: 8px 0 0;
            color: var(--text-muted);
            font-size: 14px;
            line-height: 1.6;
            max-width: 900px;
        }


    /* =========================================================
       LIVE STATUS
       ========================================================= */

    .live-status {
        float: right;
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 6px 12px;
        border-radius: 20px;
        background: rgba(79, 70, 229, 0.08);
        color: var(--primary);
        font-size: 12px;
        font-weight: 600;
        white-space: nowrap;
    }

    .live-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: #10b981;
        box-shadow: 0 0 0 4px rgba(16, 185, 129, 0.10);
    }


    /* =========================================================
       TOOLBAR
       ========================================================= */

    .toolbar {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        margin-bottom: 16px;
    }


    /* =========================================================
       CREATE BUTTON
       ========================================================= */

    .create-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-height: 44px;
        padding: 10px 20px;
        box-sizing: border-box;
        background: linear-gradient(135deg, #4f46e5, #0ea5e9);
        color: white !important;
        border: none;
        border-radius: 11px;
        text-decoration: none;
        font-weight: 600;
        font-size: 13.5px;
        box-shadow: 0 5px 14px rgba(79, 70, 229, 0.18);
        transition: all 0.2s ease;
    }

        .create-btn:hover {
            background: linear-gradient(135deg, #4338ca, #0284c7);
            transform: translateY(-2px);
            box-shadow: 0 9px 20px rgba(79, 70, 229, 0.24);
            text-decoration: none;
            color: white !important;
        }

        .create-btn:focus {
            outline: none;
            text-decoration: none;
        }


    /* =========================================================
       PANEL
       ========================================================= */

    .requests-panel {
        background: var(--surface);
        border-radius: 18px;
        padding: 24px;
        border: 1px solid var(--border-color);
        box-shadow: 0 4px 18px rgba(15, 23, 42, 0.035);
    }


    /* =========================================================
       TABLE WRAPPER
       ========================================================= */

    .inventory-table-wrapper {
        width: 100%;
        overflow-x: auto;
        border: 1px solid var(--border-color);
        border-radius: 14px;
        background: var(--surface);
    }


    /* =========================================================
       TABLE
       ========================================================= */

    .table {
        width: 100%;
        margin-bottom: 0;
        border-collapse: separate;
        border-spacing: 0;
        background: var(--surface);
    }

        .table thead {
            background: #f8fafc;
        }

            .table thead tr {
                background: #f8fafc !important;
            }

        .table th {
            border: none !important;
            border-bottom: 1px solid var(--border-color) !important;
            padding: 14px 15px;
            color: var(--text-muted);
            background: #f8fafc;
            font-weight: 700;
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 0.65px;
            white-space: nowrap;
            vertical-align: middle;
        }

        .table td {
            padding: 15px;
            vertical-align: middle;
            border-top: 1px solid #edf2f7 !important;
            border-left: none !important;
            border-right: none !important;
            border-bottom: none !important;
            color: var(--text-main);
            background: var(--surface);
            font-size: 14px;
        }

        .table tbody tr {
            transition: background 0.18s ease;
        }

            .table tbody tr:hover {
                background: #f8fafc;
            }

                .table tbody tr:hover td {
                    background: #f8fafc;
                }


    /* =========================================================
       STATUS BADGE
       ========================================================= */

    .status-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 28px;
        padding: 5px 11px;
        background: rgba(79, 70, 229, 0.08);
        color: var(--primary);
        border: 1px solid rgba(79, 70, 229, 0.10);
        border-radius: 20px;
        font-size: 11px;
        font-weight: 700;
        white-space: nowrap;
    }


    /* =========================================================
       ACTION LINKS
       ========================================================= */

    .action-links {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 8px;
    }

        .action-links a {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-height: 32px;
            padding: 6px 11px;
            border-radius: 8px;
            text-decoration: none !important;
            font-size: 12px;
            font-weight: 600;
            transition: all 0.2s ease;
        }

            .action-links a:first-child {
                color: var(--success);
                background: rgba(5, 150, 105, 0.08);
            }

                .action-links a:first-child:hover {
                    color: white;
                    background: var(--success);
                    transform: translateY(-1px);
                }

            .action-links a:last-child {
                color: var(--danger);
                background: rgba(220, 38, 38, 0.08);
            }

                .action-links a:last-child:hover {
                    color: white;
                    background: var(--danger);
                    transform: translateY(-1px);
                }


    /* =========================================================
       BACK TO DASHBOARD
       ========================================================= */

    .dashboard-navigation {
        margin-top: 24px;
    }

    .back-link {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 42px;
        padding: 9px 17px;
        box-sizing: border-box;
        background: #475569;
        color: white !important;
        border-radius: 10px;
        text-decoration: none !important;
        font-weight: 600;
        font-size: 13px;
        box-shadow: 0 4px 10px rgba(15, 23, 42, 0.08);
        transition: all 0.2s ease;
    }

        .back-link:hover {
            background: #334155;
            color: white !important;
            text-decoration: none !important;
            transform: translateY(-2px);
            box-shadow: 0 7px 16px rgba(15, 23, 42, 0.12);
        }


    /* =========================================================
       TABLET
       ========================================================= */

    @@media (max-width: 900px) {

        .inventory-page {
            padding: 30px 24px 40px;
        }

        .requests-header {
            padding: 25px;
        }

        .requests-panel {
            padding: 20px;
        }

        .requests-header h2 {
            font-size: 22px;
        }
    }


    /* =========================================================
       MOBILE
       ========================================================= */

    @@media (max-width: 768px) {

        .inventory-page {
            padding: 85px 18px 30px;
        }

        .requests-header {
            padding: 22px;
            border-radius: 15px;
            margin-bottom: 18px;
        }

            .requests-header h2 {
                font-size: 20px;
                padding-right: 0;
            }

            .requests-header p {
                font-size: 13px;
            }

        .live-status {
            float: none;
            margin-top: 12px;
        }

        .toolbar {
            justify-content: stretch;
        }

        .create-btn {
            width: 100%;
        }

        .requests-panel {
            padding: 14px;
            border-radius: 15px;
        }

        .inventory-table-wrapper {
            border-radius: 11px;
        }

        .table th {
            padding: 12px;
            font-size: 10px;
        }

        .table td {
            padding: 12px;
            font-size: 13px;
        }

        .dashboard-navigation {
            margin-top: 18px;
        }

        .back-link {
            width: 100%;
        }
    }


    /* =========================================================
       SMALL PHONE
       ========================================================= */

    @@media (max-width: 480px) {

        .inventory-page {
            padding-left: 14px;
            padding-right: 14px;
        }

        .requests-header {
            padding: 19px;
        }

            .requests-header h2 {
                font-size: 18px;
            }

            .requests-header p {
                font-size: 12.5px;
            }

        .requests-panel {
            padding: 10px;
        }

        .create-btn {
            min-height: 42px;
            font-size: 13px;
        }

        .table th {
            padding: 11px 10px;
        }

        .table td {
            padding: 11px 10px;
        }

        .action-links {
            gap: 5px;
        }

            .action-links a {
                min-height: 30px;
                padding: 5px 8px;
                font-size: 11px;
            }
    }
</style>


<!-- =========================================================
     INVENTORY PAGE
     ========================================================= -->

<div class="inventory-page">
    @if (TempData["InventoryMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["InventoryMessage"]
        </div>
    }

    @if (TempData["InventoryError"] != null)
    {
        <div class="alert alert-danger">
            @TempData["InventoryError"]
        </div>
    }

    <!-- =====================================================
         HEADER
         ===================================================== -->

    <div class="requests-header">

        <h2>

            Inventory Requests

            <span class="live-status">
                <span class="live-dot"></span>
                Live Sync Active
            </span>

        </h2>

        <p>
            Review, submit, and manage inventory requests for medicines,
            supplies, and clinical equipment required for patient care
            operations.
        </p>

    </div>


    <!-- =====================================================
         CREATE TOOLBAR
         ===================================================== -->

    @if (User.IsInRole("Nurse") || User.IsInRole("Doctor") || User.IsInRole("Cleaner"))
    {
        <div class="toolbar">

            @Html.ActionLink(
                "Create New",
                "Create",
                null,
                new { @class = "create-btn" })

        </div>
    }


    <!-- =====================================================
         REQUESTS PANEL
         ===================================================== -->

    <div class="requests-panel">

        <div class="inventory-table-wrapper">

            <table class="table table-bordered">

                <thead>

                    <tr>

                        <th>
                            Item
                        </th>

                        <th>
                            Quantity
                        </th>

                        <th>
                            Requested By
                        </th>

                        <th>
                            Date
                        </th>

                        <th>
                            Status
                        </th>

                        <th>
                            Actions
                        </th>

                    </tr>

                </thead>

                <tbody id="liveRequestsBody">

                    @Html.Partial(
                        "_InventoryRequestRows",
                        Model)

                </tbody>

            </table>

        </div>

    </div>


    <!-- =====================================================
         DASHBOARD NAVIGATION
         ===================================================== -->

    <div class="dashboard-navigation">

        @if (User.IsInRole("Admin"))
        {
            @Html.ActionLink(
                "Back to Dashboard",
                "Dashboard",
                "Admin",
                null,
                new { @class = "back-link" })
        }

        @if (User.IsInRole("Nurse"))
        {
            @Html.ActionLink(
                "Back to Dashboard",
                "Dashboard",
                "Nurse",
                null,
                new { @class = "back-link" })
        }

        @if (User.IsInRole("Pharmacist"))
        {
            @Html.ActionLink(
                "Back to Dashboard",
                "Dashboard",
                "Pharmacist",
                null,
                new { @class = "back-link" })
        }

        @if (User.IsInRole("Cleaner"))
        {
            @Html.ActionLink(
                "Back to Dashboard",
                "Dashboard",
                "Cleaner",
                null,
                new { @class = "back-link" })
        }

        @if (User.IsInRole("Doctor"))
        {
            @Html.ActionLink(
                "Back to Dashboard",
                "Dashboard",
                "Doctor",
                null,
                new { @class = "back-link" })
        }

    </div>

</div>


@section Scripts {

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <script>

        function refreshInventoryRequests() {

            $.ajax({

                url:
                    '@Url.Action(
                        "GetLiveInventoryRequests",
                        "InventoryRequests"
                    )',

                type: 'GET',

                success:
                    function (data) {

                        $('#liveRequestsBody')
                            .html(data);

                    }

            });

        }


        // Polls the database every 5 seconds
        // for background changes.

        setInterval(
            refreshInventoryRequests,
            5000
        );

    </script>

}