@model ElderlyCareHospital.Models.Message

@{
    ViewBag.Title = "Send Message";
}

<style>
    body {
        background: #f4f8fb;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .message-container {
        max-width: 850px;
        margin: 35px auto 45px;
    }

    /* =========================================================
       HEADER
       ========================================================= */

    .message-header {
        background: linear-gradient(135deg, #2f6f73, #4c8c91);
        color: white;
        padding: 28px 32px;
        border-radius: 18px;
        margin-bottom: 24px;
        box-shadow: 0 6px 18px rgba(0, 0, 0, 0.08);
    }

        .message-header h2 {
            margin: 0;
            font-size: 30px;
            font-weight: 700;
        }

        .message-header p {
            margin: 8px 0 0;
            opacity: 0.95;
            font-size: 15px;
            line-height: 1.6;
        }

    .live-status {
        float: right;
        font-size: 13px;
        background: rgba(255, 255, 255, 0.20);
        padding: 5px 12px;
        border-radius: 20px;
        font-weight: normal;
    }

    /* =========================================================
       FORM CARD
       ========================================================= */

    .message-card {
        background: white;
        border-radius: 18px;
        padding: 30px;
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
    }

        .message-card h4 {
            color: #2f6f73;
            font-weight: 700;
            margin: 0 0 8px;
        }

        .message-card hr {
            border: 0;
            border-top: 1px solid #e5ecef;
            margin: 18px 0 28px;
        }

    /* =========================================================
       FORM
       ========================================================= */

    .form-group {
        margin-bottom: 22px;
    }

    .control-label {
        display: block;
        font-weight: 600;
        color: #2f3e46;
        margin-bottom: 8px;
    }

    .form-control {
        width: 100%;
        min-height: 44px;
        padding: 10px 14px;
        border: 1px solid #cfd8dc;
        border-radius: 10px;
        background: #fff;
        color: #2f3e46;
        font-size: 14px;
        box-shadow: none;
        transition: border-color 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
    }

        .form-control:focus {
            border-color: #4c8c91;
            box-shadow: 0 0 0 3px rgba(76, 140, 145, 0.15);
            outline: none;
        }

    select.form-control {
        cursor: pointer;
    }

    textarea.form-control {
        min-height: 180px;
        resize: vertical;
        line-height: 1.6;
    }

    /* =========================================================
       SENDER
       ========================================================= */

    .sender-display {
        display: flex;
        align-items: center;
        min-height: 44px;
        padding: 10px 14px;
        background: #f5f9fa;
        border: 1px solid #dce7e9;
        border-radius: 10px;
        color: #2f6f73;
        font-weight: 600;
    }

    .sender-icon {
        width: 30px;
        height: 30px;
        border-radius: 50%;
        background: #dceff0;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin-right: 10px;
        font-size: 14px;
    }

    /* =========================================================
       HELP TEXT
       ========================================================= */

    .field-help {
        display: block;
        margin-top: 7px;
        color: #78909c;
        font-size: 12px;
        line-height: 1.5;
    }

    .message-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 7px;
    }

    .message-help {
        color: #78909c;
        font-size: 12px;
    }

    .character-count {
        color: #78909c;
        font-size: 12px;
        font-weight: 600;
    }

    /* =========================================================
       BUTTONS
       ========================================================= */

    .form-actions {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-top: 28px;
        padding-top: 22px;
        border-top: 1px solid #e8eef0;
    }

    .btn-send {
        background: #2f6f73;
        color: white;
        border: none;
        border-radius: 10px;
        padding: 11px 24px;
        font-weight: 600;
        font-size: 14px;
        cursor: pointer;
        transition: background 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
    }

        .btn-send:hover {
            background: #25575a;
            color: white;
            transform: translateY(-1px);
            box-shadow: 0 4px 10px rgba(47, 111, 115, 0.20);
        }

        .btn-send:focus {
            outline: none;
            box-shadow: 0 0 0 3px rgba(76, 140, 145, 0.20);
        }

    .back-link {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 10px 18px;
        background: #6c757d;
        color: white !important;
        border-radius: 10px;
        text-decoration: none;
        font-weight: 600;
        transition: background 0.2s ease;
    }

        .back-link:hover {
            background: #5a6268;
            color: white !important;
            text-decoration: none;
        }

    /* =========================================================
       VALIDATION
       ========================================================= */

    .text-danger {
        display: block;
        margin-top: 6px;
        color: #d9534f;
        font-size: 13px;
    }

    .validation-summary-errors {
        background: #fff5f5;
        border: 1px solid #f1c4c4;
        border-radius: 10px;
        padding: 12px 15px;
        margin-bottom: 20px;
        color: #b23b3b;
    }

    /* =========================================================
       RESPONSIVE
       ========================================================= */

    @@media (max-width: 768px) {

        .message-container {
            margin: 20px 15px 35px;
        }

        .message-header {
            padding: 24px;
        }

            .message-header h2 {
                font-size: 25px;
            }

        .live-status {
            float: none;
            display: inline-block;
            margin-top: 12px;
        }

        .message-card {
            padding: 22px;
        }

        .form-actions {
            flex-direction: column;
            align-items: stretch;
        }

        .btn-send,
        .back-link {
            width: 100%;
            text-align: center;
        }

        .message-footer {
            flex-direction: column;
            align-items: flex-start;
            gap: 5px;
        }
    }
</style>

<div class="message-container">

    <!-- =====================================================
         HEADER
         ====================================================== -->

    <div class="message-header">

        <h2>
            Send Message

            <span class="live-status">
                Secure Communication
            </span>
        </h2>

        <p>
            Send a message to another user in the Elderly Care Hospital
            communication system and keep the healthcare team connected.
        </p>

    </div>


    <!-- =====================================================
         FORM CARD
         ====================================================== -->

    <div class="message-card">

        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()

            <h4>Message Information</h4>

            <hr />

            @Html.ValidationSummary(
                true,
                "",
                new { @class = "text-danger" }
            )


            <!-- =================================================
                 SENDER
                 ================================================== -->

            <div class="form-group">

                <label class="control-label">
                    From
                </label>

                <div class="sender-display">

                    <span>
                        @ViewBag.SenderName
                    </span>

                </div>

            </div>


            <!-- =================================================
                 FAMILY MEMBER: SPECIALITY
                 ================================================== -->

            if (User.IsInRole("FamilyMember"))
            {
                <div class="form-group">

                    <label class="control-label" for="speciality">
                        Doctor Speciality
                    </label>

                    @Html.DropDownList(
                        "speciality",
                        ViewBag.Specialities as SelectList,
                        "-- Select Doctor Speciality --",
                        new
                        {
                            @class = "form-control",
                            id = "speciality"
                        }
                    )

                    <span class="field-help">
                        Select a speciality first. The doctor list will
                        then show only doctors from that speciality.
                    </span>

                    @Html.ValidationMessage(
                        "speciality",
                        "",
                        new { @class = "text-danger" }
                    )

                </div>


                <!-- =============================================
                     FAMILY MEMBER: DOCTOR
                     ============================================== -->

                <div class="form-group">

                    @Html.LabelFor(
                        model => model.ReceiverID,
                        "Select Doctor",
                        new { @class = "control-label" }
                    )

                    @Html.DropDownListFor(
                        model => model.ReceiverID,
                        ViewBag.Receivers as SelectList,
                        "-- Select a speciality first --",
                        new
                        {
                            @class = "form-control",
                            id = "doctorDropdown"
                        }
                    )

                    <span class="field-help">
                        Only doctors who specialize in the selected
                        speciality will appear here.
                    </span>

                    @Html.ValidationMessageFor(
                        model => model.ReceiverID,
                        "",
                        new { @class = "text-danger" }
                    )

                </div>
            }


            <!-- =================================================
                 DOCTOR: FAMILY MEMBER
                 ================================================== -->

            if (User.IsInRole("Doctor"))
            {
                <div class="form-group">

                    @Html.LabelFor(
                        model => model.ReceiverID,
                        "Send To",
                        new { @class = "control-label" }
                    )

                    @Html.DropDownListFor(
                        model => model.ReceiverID,
                        ViewBag.Receivers as SelectList,
                        "-- Select Family Member --",
                        new
                        {
                            @class = "form-control"
                        }
                    )

                    @Html.ValidationMessageFor(
                        model => model.ReceiverID,
                        "",
                        new { @class = "text-danger" }
                    )

                </div>
            }


            <!-- =================================================
                 MESSAGE
                 ================================================== -->

            <div class="form-group">

                @Html.LabelFor(
                    model => model.MessageText,
                    new { @class = "control-label" }
                )

                @Html.TextAreaFor(
                    model => model.MessageText,
                    new
                    {
                        @class = "form-control",
                        id = "messageText",
                        rows = "7",
                        maxlength = "1000",
                        placeholder = "Type your message here..."
                    }
                )

                <div class="message-footer">

                    <span class="message-help">
                        Please keep messages clear and relevant to patient care.
                    </span>

                    <span class="character-count">
                        <span id="characterCount">0</span>/1000
                    </span>

                </div>

                @Html.ValidationMessageFor(
                    model => model.MessageText,
                    "",
                    new { @class = "text-danger" }
                )

            </div>


            <!-- =================================================
                 ACTIONS
                 ================================================== -->

            <div class="form-actions">

                <button type="submit" class="btn-send">
                    ✉ Send Message
                </button>

                @Html.ActionLink(
                    "Cancel",
                    "Inbox",
                    null,
                    new { @class = "back-link" }
                )

            </div>
        }

    </div>
   

</div>

@section Scripts {

   
    @Scripts.Render("~/bundles/jqueryval")

    <script>

    $(document).ready(function () {

        // =====================================================
        // CHARACTER COUNTER
        // =====================================================

        var messageBox = $('#messageText');
        var characterCount = $('#characterCount');

        function updateCharacterCount() {

            var length = messageBox.val().length;

            characterCount.text(length);
        }

        messageBox.on('input', updateCharacterCount);

        updateCharacterCount();


        // =====================================================
        // SPECIALITY → DOCTOR FILTER
        // =====================================================

        $('#speciality').change(function () {

            var speciality = $(this).val();

            var doctorDropdown = $('#doctorDropdown');


            // Clear existing doctors
            doctorDropdown.empty();


            // If no speciality selected
            if (!speciality) {

                doctorDropdown.append(
                    $('<option></option>')
                        .val('')
                        .text('-- Select a speciality first --')
                );

                return;
            }


            // Show loading
            doctorDropdown.append(
                $('<option></option>')
                    .val('')
                    .text('Loading doctors...')
            );


            // Request doctors from controller
            $.ajax({

                url: '@Url.Action("GetDoctorsBySpeciality", "Messages")',

                type: 'GET',

                data: {
                    speciality: speciality
                },

                success: function (doctors) {

                    doctorDropdown.empty();


                    // No doctors found
                    if (!doctors || doctors.length === 0) {

                        doctorDropdown.append(
                            $('<option></option>')
                                .val('')
                                .text('-- No doctors found --')
                        );

                        return;
                    }


                    // Default option
                    doctorDropdown.append(
                        $('<option></option>')
                            .val('')
                            .text('-- Select Doctor --')
                    );


                    // Add doctors
                    $.each(doctors, function (index, doctor) {

                        doctorDropdown.append(
                            $('<option></option>')
                                .val(doctor.DoctorID)
                                .text(doctor.FullName)
                        );

                    });

                },

                error: function () {

                    doctorDropdown.empty();

                    doctorDropdown.append(
                        $('<option></option>')
                            .val('')
                            .text('-- Error loading doctors --')
                    );

                }

            });

        });

    });

    </script>
    

}
