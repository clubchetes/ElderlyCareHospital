@model ElderlyCareHospital.Models.Medicine

@{
    ViewBag.Title = "Details";
}

<style>

    /* =========================================================
       ROOT / ELDERLYCARE DASHBOARD THEME
       ========================================================= */

    :root {
        --app-bg: #f8fafc;
        --card-bg: #ffffff;
        --text-main: #0f172a;
        --text-muted: #64748b;
        --primary: #4f46e5;
        --primary-hover: #4338ca;
        --border-color: #e2e8f0;
        --green: #059669;
        --orange: #d97706;
        --red: #dc2626;
        --cyan: #0d9488;
        --blue: #0284c7;
        --purple: #7c3aed;
    }


    /* =========================================================
       PAGE
       ========================================================= */

    html,
    body {
        margin: 0;
        padding: 0;
        min-height: 100%;
    }

    body {
        background: var(--app-bg);
        font-family: 'Inter', 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        color: var(--text-main);
        overflow-x: hidden;
    }

    * {
        box-sizing: border-box;
    }


    /* =========================================================
       BACKGROUND EFFECTS
       ========================================================= */

    .bg-shape {
        position: fixed;
        border-radius: 50%;
        background: rgba(79, 70, 229, 0.035);
        pointer-events: none;
        z-index: 0;
        filter: blur(5px);
    }

    .shape1 {
        width: 300px;
        height: 300px;
        top: 5%;
        left: 5%;
    }

    .shape2 {
        width: 220px;
        height: 220px;
        bottom: 10%;
        right: 5%;
        background: rgba(14, 165, 233, 0.04);
    }


    /* =========================================================
       DETAILS WRAPPER
       ========================================================= */

    .medicine-details-wrapper {
        position: relative;
        z-index: 1;
        width: 100%;
        max-width: 1400px;
        margin: 0 auto;
        padding: 36px 40px 45px;
    }


    /* =========================================================
       PAGE HEADER
       ========================================================= */

    .medicine-details-header {
        background: var(--card-bg);
        border: 1px solid var(--border-color);
        color: var(--text-main);
        padding: 28px 34px;
        border-radius: 18px;
        margin-bottom: 26px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.02);
    }

        .medicine-details-header h2 {
            margin: 0;
            font-weight: 700;
            font-size: 24px;
            color: var(--text-main);
            letter-spacing: -0.3px;
            line-height: 1.3;
        }

        .medicine-details-header p {
            margin: 8px 0 0;
            color: var(--text-muted);
            font-size: 14px;
            line-height: 1.6;
            max-width: 900px;
        }


    /* =========================================================
       DETAILS CARD
       ========================================================= */

    .medicine-details-card {
        position: relative;
        background: var(--card-bg);
        border: 1px solid var(--border-color);
        border-radius: 16px;
        padding: 28px;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.02);
        overflow: hidden;
    }

        .medicine-details-card::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 3px;
            background: var(--primary);
        }


    /* =========================================================
       SECTION TITLE
       ========================================================= */

    .medicine-section-title {
        margin: 0 0 22px;
        color: var(--text-main);
        font-size: 18px;
        font-weight: 700;
    }


    /* =========================================================
       DETAILS LIST
       ========================================================= */

    .medicine-details-list {
        margin: 0;
        padding: 0;
        display: grid;
        grid-template-columns: 1fr 1fr;
        border: 1px solid var(--border-color);
        border-radius: 12px;
        overflow: hidden;
    }

        .medicine-details-list dt,
        .medicine-details-list dd {
            margin: 0;
            padding: 16px 18px;
            border-bottom: 1px solid var(--border-color);
        }

        .medicine-details-list dt {
            background: #f8fafc;
            color: var(--text-muted);
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.6px;
        }

        .medicine-details-list dd {
            background: #ffffff;
            color: var(--text-main);
            font-size: 14px;
            font-weight: 600;
        }

            .medicine-details-list dt:nth-last-of-type(1),
            .medicine-details-list dd:nth-last-of-type(1) {
                border-bottom: none;
            }


        /* =========================================================
       VALUE STYLING
       ========================================================= */

        .medicine-details-list dd {
            word-break: break-word;
        }


    /* =========================================================
       ACTIONS
       ========================================================= */

    .medicine-actions {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-top: 22px;
        flex-wrap: wrap;
    }

        .medicine-actions a {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-height: 44px;
            padding: 10px 18px;
            border-radius: 12px;
            text-decoration: none !important;
            font-size: 13px;
            font-weight: 600;
            transition: all 0.2s ease;
        }

    .edit-link {
        color: #ffffff !important;
        background: linear-gradient(135deg, #4f46e5, #6366f1);
        box-shadow: 0 4px 12px rgba(79, 70, 229, 0.18);
    }

        .edit-link:hover {
            color: #ffffff !important;
            text-decoration: none !important;
            transform: translateY(-2px);
            box-shadow: 0 9px 20px rgba(79, 70, 229, 0.24);
            background: linear-gradient(135deg, #4338ca, #4f46e5);
        }

    .back-link {
        color: var(--text-muted) !important;
        background: #ffffff;
        border: 1px solid var(--border-color);
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.02);
    }

        .back-link:hover {
            color: var(--primary) !important;
            border-color: #cbd5e1;
            text-decoration: none !important;
            transform: translateY(-2px);
            box-shadow: 0 8px 18px rgba(15, 23, 42, 0.06);
        }


    /* =========================================================
       RESPONSIVE
       ========================================================= */

    @@media (max-width: 1200px) {

        .medicine-details-wrapper {
            padding-left: 30px;
            padding-right: 30px;
        }
    }


    @@media (max-width: 900px) {

        .medicine-details-wrapper {
            padding: 30px 24px 40px;
        }

        .medicine-details-header {
            padding: 25px;
        }

        .medicine-details-list {
            grid-template-columns: 1fr;
        }

            .medicine-details-list dt {
                border-bottom: none;
                padding-bottom: 7px;
            }

            .medicine-details-list dd {
                padding-top: 7px;
            }
    }


    @@media (max-width: 768px) {

        .medicine-details-wrapper {
            padding: 95px 18px 30px;
        }

        .medicine-details-header {
            padding: 22px;
            border-radius: 15px;
            margin-bottom: 22px;
        }

            .medicine-details-header h2 {
                font-size: 20px;
            }

            .medicine-details-header p {
                font-size: 13px;
            }

        .medicine-details-card {
            padding: 20px;
        }

        .medicine-actions {
            flex-direction: column;
            align-items: stretch;
        }

            .medicine-actions a {
                width: 100%;
            }
    }


    @@media (max-width: 480px) {

        .medicine-details-wrapper {
            padding-left: 14px;
            padding-right: 14px;
        }

        .medicine-details-header {
            padding: 19px;
        }

            .medicine-details-header h2 {
                font-size: 18px;
            }

            .medicine-details-header p {
                font-size: 12.5px;
            }

        .medicine-details-card {
            padding: 14px;
        }

        .medicine-details-list dt,
        .medicine-details-list dd {
            padding-left: 14px;
            padding-right: 14px;
        }
    }
</style>


<!-- =========================================================
     BACKGROUND SHAPES
     ========================================================= -->

<div class="bg-shape shape1"></div>
<div class="bg-shape shape2"></div>


<!-- =========================================================
     MEDICINE DETAILS PAGE
     ========================================================= -->

<div class="medicine-details-wrapper">


    <!-- =====================================================
         PAGE HEADER
         ===================================================== -->

    <div class="medicine-details-header">

        <h2>
            Medicine Details
        </h2>

        <p>
            View detailed information about this medicine,
            including stock levels, expiry information,
            minimum stock requirements, and supplier details.
        </p>

    </div>


    <!-- =====================================================
         DETAILS CARD
         ===================================================== -->

    <div class="medicine-details-card">

        <h4 class="medicine-section-title">
            Medicine Information
        </h4>


        <dl class="medicine-details-list">

            <dt>
                @Html.DisplayNameFor(model => model.MedicineName)
            </dt>

            <dd>
                @Html.DisplayFor(model => model.MedicineName)
            </dd>


            <dt>
                @Html.DisplayNameFor(model => model.Description)
            </dt>

            <dd>
                @Html.DisplayFor(model => model.Description)
            </dd>


            <dt>
                @Html.DisplayNameFor(model => model.Quantity)
            </dt>

            <dd>
                @Html.DisplayFor(model => model.Quantity)
            </dd>


            <dt>
                @Html.DisplayNameFor(model => model.ExpiryDate)
            </dt>

            <dd>
                @Html.DisplayFor(model => model.ExpiryDate)
            </dd>


            <dt>
                @Html.DisplayNameFor(model => model.MinimumStock)
            </dt>

            <dd>
                @Html.DisplayFor(model => model.MinimumStock)
            </dd>


            <dt>
                @Html.DisplayNameFor(model => model.Supplier)
            </dt>

            <dd>
                @Html.DisplayFor(model => model.Supplier)
            </dd>

        </dl>


        <!-- =================================================
             ACTIONS
             ================================================= -->

        <div class="medicine-actions">

            @Html.ActionLink(
                "Edit",
                "Edit",
                new { id = Model.MedicineID },
                new { @class = "edit-link" }
            )

            @Html.ActionLink(
                "Back to List",
                "Index",
                null,
                new { @class = "back-link" }
            )

        </div>

    </div>

</div>

