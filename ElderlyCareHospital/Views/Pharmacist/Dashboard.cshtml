     ========================================================= -->

<canvas id="cursorCanvas"></canvas>


@section Scripts {

    <script>

        /* =====================================================
           SIDEBAR
           ===================================================== */

        function toggleSidebar() {

            const sidebar =
                document.getElementById('dashboardSidebar');

            if (!sidebar) {
                return;
            }

            sidebar.classList.toggle('open');
        }


        /* =====================================================
           ESCAPE CLOSE
           ===================================================== */

        document.addEventListener(
            'keydown',
            function (event) {

                if (event.key === 'Escape') {

                    const sidebar =
                        document.getElementById(
                            'dashboardSidebar'
                        );

                    if (sidebar) {

                        sidebar.classList.remove(
                            'open'
                        );

                    }

                }

            }
        );


        /* =====================================================
           BACKGROUND PARALLAX
           ===================================================== */

        const shapes =
            document.querySelectorAll('.bg-shape');


        document.addEventListener(
            'mousemove',
            function (e) {

                const x =
                    (window.innerWidth / 2 -
                        e.clientX) / 30;

                const y =
                    (window.innerHeight / 2 -
                        e.clientY) / 30;


                shapes.forEach(
                    function (shape, index) {

                        const speed =
                            (index + 1) * 0.6;

                        shape.style.transform =
                            `translate(
                                ${x * speed}px,
                                ${y * speed}px
                            )`;

                    }
                );

            }
        );


        /* =====================================================
           CURSOR GLOW
           ===================================================== */

        const canvas =
            document.getElementById(
                'cursorCanvas'
            );


        if (canvas) {

            const ctx =
                canvas.getContext('2d');


            let w =
                canvas.width =
                window.innerWidth;

            let h =
                canvas.height =
                window.innerHeight;


            let mouse = {
                x: w / 2,
                y: h / 2
            };


            window.addEventListener(
                'resize',
                function () {

                    w =
                        canvas.width =
                        window.innerWidth;

                    h =
                        canvas.height =
                        window.innerHeight;

                }
            );


            document.addEventListener(
                'mousemove',
                function (e) {

                    mouse.x =
                        e.clientX;

                    mouse.y =
                        e.clientY;

                }
            );


            function drawGlow(
                x,
                y,
                radius,
                color
            ) {

                const gradient =
                    ctx.createRadialGradient(
                        x,
                        y,
                        0,
                        x,
                        y,
                        radius
                    );


                gradient.addColorStop(
                    0,
                    color
                );


                gradient.addColorStop(
                    1,
                    'transparent'
                );


                ctx.fillStyle =
                    gradient;


                ctx.beginPath();


                ctx.arc(
                    x,
                    y,
                    radius,
                    0,
                    Math.PI * 2
                );


                ctx.fill();

            }


            function animate() {

                ctx.clearRect(
                    0,
                    0,
                    w,
                    h
                );


                drawGlow(
                    mouse.x,
                    mouse.y,
                    45,
                    'rgba(79, 70, 229, 0.10)'
                );


                requestAnimationFrame(
                    animate
                );

            }


            animate();

        }


        /* =====================================================
           PHARMACIST STATISTICS
           ===================================================== */

        $(function () {

            function updatePharmacistStats() {

                $.ajax({

                    url:
                        '@Url.Action(
                            "GetPharmacistStatsJson",
                            "Pharmacist"
                        )',

                    type: 'GET',

                    cache: false,

                    success:
                        function (result) {

                            if (result) {

                                $(
                                    "#pharmacistStatsContainer"
                                ).html(result);

                            }

                        },

                    error:
                        function (
                            xhr,
                            status,
                            error
                        ) {

                            console.error(
                                "Pharmacist dashboard polling error:",
                                error
                            );

                        }

                });

            }


            /* Initial load */

            updatePharmacistStats();


            /* Refresh every 3 seconds */

            setInterval(
                updatePharmacistStats,
                3000
            );

        });

    </script>

}